---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageShell from "../components/PageShell.astro";
import SectionNav from "../components/SectionNav.astro";
import RailContactCard from "../components/RailContactCard.astro";
import { contact, addressLines } from "../data/contact";

/** Rail table of contents. Labels are shorter than the headings they point at. */
const sections = [
  { id: "o-filii", label: "O filii" },
  { id: "pomieszczenia", label: "Wspólne pomieszczenia" },
  { id: "zajecia", label: "Zajęcia terapeutyczne" },
  { id: "spolecznosc", label: "Społeczność lokalna" },
];

const therapies = [
  "zajęcia plastyczne",
  "robótki ręczne",
  "zajęcia świetlicowe",
  "czytelnictwo i twórczość literacka",
  "muzykoterapia",
  "prace ogrodnicze, wycieczki i spacery",
];

const rooms = [
  "gabinet zabiegowy",
  "świetlica",
  "kaplica",
  "stołówka",
  "palarnia",
  "pracownia terapeutyczna",
];
---

<Base
  title="Filia w Spychowie"
  description={`Filia Domu Pomocy Społecznej im. Jana Pawła II w Spychowie — opieka pielęgnacyjna i zajęcia terapeutyczne. ${contact.spychowo.address.city}, ${contact.spychowo.address.street}, tel. ${contact.spychowo.phone.label}.`}
>
  <PageHeader
    eyebrow="Nasz dom"
    title="Filia w Spychowie"
    lead="Mniejszy dom pośród mazurskich lasów. Od 2001 roku Mieszkańcy znajdują tu opiekę i codzienny rytm zajęć."
  />

  <SectionNav items={sections} />

  <PageShell>
    <div slot="rail" class="space-y-8">
      <RailContactCard
        title="Kontakt do filii"
        headingId="kontakt-filia"
        address={["Filia Domu Pomocy Społecznej", ...addressLines(contact.spychowo.address)]}
        phone={contact.spychowo.phone}
        email={contact.email}
      >
        <p class="mt-4 text-base text-muted">
          Sprawy formalne prowadzi <a
            href="/kontakt/"
            class="inline-block py-1 text-spruce underline hover:text-spruce-deep"
            >sekretariat w Szczytnie</a
          >.
        </p>
      </RailContactCard>
    </div>

    <section aria-labelledby="o-filii">
      {
        /* No photo of its own: the only interior we had turned out to be
           a Szczytno room, so the text takes the full column until the Dom
           sends photographs of the branch (see docs/pytania-do-domu.md). */
      }
      <div class="doc">
        <h2 id="o-filii">O filii</h2>
        <p>
          Filia w Spychowie istnieje od 2001 roku i jest domem dla Mieszkańców. Opieka
          pielęgniarska jest tu przez całą dobę, a dzień ma swój rytm: wspólne posiłki
          w stołówce, zajęcia w pracowni terapeutycznej, msza w kaplicy i czas dla siebie we
          własnym pokoju. Pomagamy w codziennych czynnościach tyle, ile potrzeba — i tak,
          żeby każdy zachował swoje przyzwyczajenia.
        </p>
        <p>
          Zakres usług pielęgnacyjnych, opiekuńczych i wspomagających oraz warunki bytowe
          określa Regulamin Organizacyjny Domu.
        </p>
      </div>
    </section>

    <section aria-labelledby="pomieszczenia" class="band mt-section">
      <div class="doc">
        <h2 id="pomieszczenia">Wspólne pomieszczenia</h2>
        <p>
          Oprócz własnych pokoi Mieszkańcy korzystają także z pozostałych pomieszczeń domu:
        </p>
        <ul>
          {rooms.map((room) => <li>{room}</li>)}
        </ul>
        <p>Wsparcie duchowe zapewnia kapłan z tutejszej parafii.</p>
      </div>
    </section>

    <section aria-labelledby="zajecia" class="mt-section">
      <div class="doc">
        <h2 id="zajecia">Zajęcia terapeutyczne</h2>
        <ul>
          {therapies.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section aria-labelledby="spolecznosc" class="band mt-section">
      <div class="doc">
        <h2 id="spolecznosc">Życie ze społecznością lokalną</h2>
        <p>
          Pracownicy domu i Mieszkańcy dokładają starań, by utrzymywać dobre kontakty ze
          środowiskiem lokalnym, szczególnie ze szkołą i miejscowymi zakładami pracy. Dom
          odwiedzają różne zespoły muzyczne i rozrywkowe — między innymi aktorzy Teatru
          ArtRe z Krakowa — a także dzieci i młodzież z okolicznościowymi przedstawieniami
          oraz Mieszkańcy i uczestnicy placówek o podobnym profilu działalności.
        </p>
      </div>
    </section>
  </PageShell>
</Base>
