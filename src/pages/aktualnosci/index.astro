---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";

const entries = (await getCollection("aktualnosci")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/** Fewer than three posts read badly as narrow cards marooned in a
    three-column grid, so they become a single-column list at a larger type
    scale instead. */
const asList = entries.length < 3;

const dateFormat = new Intl.DateTimeFormat("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title="Komunikaty i podziękowania"
  description="Komunikaty i podziękowania z życia Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie i filii w Spychowie. Ogłoszenia urzędowe publikujemy w Biuletynie Informacji Publicznej."
>
  <PageHeader
    eyebrow="Aktualności"
    title="Komunikaty i podziękowania"
    lead="Ważniejsze komunikaty i podziękowania z życia Domu oraz filii w Spychowie. Bieżące ogłoszenia urzędowe publikujemy w Biuletynie Informacji Publicznej."
  />

  <PageShell narrow>
    <p class="mb-8 max-w-[46rem] text-lg leading-relaxed text-ink/85">
      Zamówienia publiczne, nabory i inne ogłoszenia urzędowe znajdują się w
      <a
        href="https://dpsszczytno.bip.gov.pl/"
        class="text-spruce underline underline-offset-4 hover:text-spruce-deep"
        >Biuletynie Informacji Publicznej Domu</a
      >.
    </p>

    {
      entries.length === 0 ? (
        <p class="rounded-xl border border-line bg-moss px-6 py-8 text-lg text-muted">
          Wkrótce pojawią się tu nowe informacje.
        </p>
      ) : (
        <ul
          class:list={["grid", asList ? "gap-6" : "gap-6 sm:grid-cols-2 lg:grid-cols-3"]}
          role="list"
        >
          {entries.map((entry) => (
            <li class="relative flex">
              <article class="flex w-full flex-col rounded-xl border border-line bg-white p-6 transition-colors duration-150 hover:border-spruce/40 hover:shadow-card focus-within:border-spruce/40">
                <p class="text-sm font-medium text-honey">
                  <time datetime={entry.data.date.toISOString().slice(0, 10)}>
                    {dateFormat.format(entry.data.date)}
                  </time>
                </p>
                <h2 class:list={["mt-2", asList ? "text-2xl" : "text-xl"]}>
                  <a
                    href={`/aktualnosci/${entry.id}/`}
                    data-card-link
                    class="text-spruce-deep underline underline-offset-4 before:absolute before:inset-0 before:content-[''] hover:text-spruce"
                  >
                    {entry.data.title}
                  </a>
                </h2>
                {entry.data.description && (
                  <p class:list={["mt-3 text-muted", asList && "text-lg"]}>
                    {entry.data.description}
                  </p>
                )}
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </PageShell>
</Base>
