---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";
import PageList from "../../components/PageList.astro";
import { contact } from "../../data/contact";

const entries = (await getCollection("aktualnosci")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/** The same long-form date the post itself prints, so a list row and the post agree. */
const dateFormat = new Intl.DateTimeFormat("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const items = entries.map((entry) => {
  const date = dateFormat.format(entry.data.date);
  return {
    href: `/aktualnosci/${entry.id}/`,
    label: entry.data.title,
    text: entry.data.description ? `${date} — ${entry.data.description}` : date,
  };
});
---

<Base
  title="Komunikaty i podziękowania"
  description="Komunikaty i podziękowania z życia Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie i filii w Spychowie. Ogłoszenia urzędowe publikujemy w Biuletynie Informacji Publicznej."
>
  <PageHeader
    breadcrumbs
    title="Komunikaty i podziękowania"
    lead="Ważniejsze komunikaty i podziękowania z życia Domu oraz filii w Spychowie. Bieżące ogłoszenia urzędowe publikujemy w Biuletynie Informacji Publicznej."
  />

  <PageShell>
    <div class="doc">
      <p>
        Zamówienia publiczne, nabory i inne ogłoszenia urzędowe znajdują się
        w <a href={contact.bip}>Biuletynie Informacji Publicznej Domu</a>.
      </p>
    </div>

    <div class="mt-subsection">
      {
        items.length === 0 ? (
          <p class="max-w-column rounded-lg border border-line bg-mist px-6 py-6 text-ink-soft">
            Wkrótce pojawią się tu nowe informacje.
          </p>
        ) : (
          <PageList items={items} />
        )
      }
    </div>
  </PageShell>
</Base>
