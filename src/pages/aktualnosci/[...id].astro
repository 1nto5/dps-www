---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { formatPostDate } from "../../lib/posts";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";
import Figure from "../../components/Figure.astro";

export async function getStaticPaths() {
  const entries = await getCollection("aktualnosci");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"aktualnosci">;
}

const { entry } = Astro.props;
const { date } = entry.data;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <PageShell>
    <PageHeader slot="header" breadcrumbs current={entry.data.title} title={entry.data.title} />

    {/* The date of the post, written out the long Polish way. */}
    <p class="text-sm text-ink-soft">
      <time datetime={date.toISOString().slice(0, 10)}>{formatPostDate(date)}</time>
    </p>

    {
      /* coverAlt is required whenever cover is set — enforced by the collection schema */
      entry.data.cover && (
        <Figure
          src={entry.data.cover}
          alt={entry.data.coverAlt!}
          loading="eager"
          class="mt-8 max-w-prose"
        />
      )
    }

    <div class="prose mt-8">
      <Content />
    </div>
  </PageShell>
</Base>
