---
/**
 * The way onwards from a dead address: every page in the menu, built from the
 * navigation so a renamed or moved page reaches here too.
 */
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageShell from "../components/PageShell.astro";
import PageList from "../components/PageList.astro";
import { contact } from "../data/contact";
import { navPages } from "../data/nav";

const links = navPages.map((item) => ({ href: item.href, label: item.label }));
---

<Base
  title="Nie znaleziono strony"
  description="Pod tym adresem nie ma strony. Skorzystaj z odnośników, aby wrócić na stronę główną lub do kontaktu."
>
  <PageHeader
    title="Nie znaleziono tej strony"
    lead="Adres mógł się zmienić przy przenosinach naszej strony albo zawiera literówkę. Nic straconego — poniżej znajdziesz drogę dalej."
  />

  <PageShell>
    <div class="max-w-prose">
      <PageList items={links} />
      <p class="mt-8 text-ink-soft">
        Jeśli szukasz konkretnej informacji i nie możesz jej znaleźć, chętnie pomożemy. Zadzwoń pod
        numer <a href={contact.phone.href} class="font-semibold underline">{contact.phone.label}</a>
        lub napisz na adres <a href={`mailto:${contact.email}`} class="font-semibold underline"
          >{contact.email}</a
        >.
      </p>
    </div>
  </PageShell>
</Base>
