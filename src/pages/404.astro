---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageShell from "../components/PageShell.astro";

/** The way onwards from a dead address: the same tiles the document hub uses,
    so a reader who lands here gets the whole site, not a bare list. */
const links = [
  { href: "/", label: "Strona główna", text: "Krótko o Domu i ostatnie komunikaty." },
  { href: "/o-nas/", label: "O nas", text: "Kierownictwo, statut i podstawy prawne działania Domu." },
  { href: "/oferta/", label: "Oferta", text: "Opieka, terapia zajęciowa i warunki bytowe." },
  {
    href: "/filia-w-spychowie/",
    label: "Filia w Spychowie",
    text: "Nasz drugi dom, przy ul. Sienkiewicza 3.",
  },
  {
    href: "/przyjecie-do-domu/",
    label: "Przyjęcie do Domu",
    text: "Kto może u nas zamieszkać i jak wygląda droga do przyjęcia.",
  },
  {
    href: "/aktualnosci/",
    label: "Komunikaty i podziękowania",
    text: "Ważniejsze wiadomości z życia Domu i filii.",
  },
  { href: "/galeria/", label: "Galeria", text: "Zdjęcia Domu, ogrodu i wspólnych wydarzeń." },
  {
    href: "/dokumenty/",
    label: "Dokumenty",
    text: "Dotacje, projekty unijne, zamówienia publiczne, RODO i sygnalista.",
  },
  { href: "/kontakt/", label: "Kontakt", text: "Adresy, telefony i adresy e-mail." },
];
---

<Base
  title="Nie znaleziono strony"
  description="Pod tym adresem nie ma strony. Skorzystaj z odnośników, aby wrócić na stronę główną lub do kontaktu."
>
  <PageHeader
    eyebrow="Błąd 404"
    title="Nie znaleziono tej strony"
    lead="Adres mógł się zmienić przy przenosinach naszej strony albo zawiera literówkę. Nic straconego — poniżej znajdziesz drogę dalej."
  />

  <PageShell>
    <div class="doc">
      <p>
        Jeśli szukasz konkretnej informacji i nie możesz jej znaleźć, chętnie pomożemy. Zadzwoń pod
        numer <a href="tel:+48896242288">89 624 22 88</a> lub napisz na adres
        <a href="mailto:sekretariat@dpsszczytno.pl">sekretariat@dpsszczytno.pl</a>.
      </p>
    </div>

    <nav aria-labelledby="czeste-strony" class="mt-section">
      <h2 id="czeste-strony" class="mb-6 text-2xl">Najczęściej odwiedzane strony</h2>
      <ul role="list" class="grid gap-4 sm:grid-cols-2">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                class="flex h-full flex-col gap-2 rounded-xl border border-line bg-white p-5 no-underline hover:bg-moss hover:shadow-card"
              >
                <span class="font-display text-xl font-semibold text-spruce-deep underline underline-offset-4">
                  {l.label}
                </span>
                <span class="text-muted">{l.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageShell>
</Base>
