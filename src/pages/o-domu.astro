---
/**
 * The section page about the Dom itself, carrying the production site's
 * `/gallery/` page ("O NAS"): the law the Dom works under, the people in
 * charge and the constitutive documents. That page publishes no photograph,
 * so neither does this one.
 */
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageShell from "../components/PageShell.astro";
import Toc from "../components/Toc.astro";
import Brief from "../components/Brief.astro";
import DocList from "../components/DocList.astro";
import { dokumentyUstrojowe } from "../data/dokumenty-ustrojowe";

/** Every id below exists as an `id` on an `h2` — the build checks it. */
const toc = [
  { id: "nasz-dom", label: "Nasz dom" },
  { id: "dla-kogo", label: "Dla kogo" },
  { id: "kierownictwo", label: "Kierownictwo" },
  { id: "podstawa-prawna", label: "Podstawa prawna" },
  { id: "dokumenty", label: "Dokumenty" },
];

const management = [
  { role: "Dyrektor", name: "mgr Dorota Sędzińska-Bruździak" },
  { role: "Główna księgowa", name: "Beata Brzózy" },
  { role: "Kierownik Działu Administracyjno-Usługowego", name: "Dorota Kocot" },
  { role: "Kierownik Mieszkania I", name: "Barbara Suprynowicz" },
  { role: "Kierownik Mieszkania II", name: "Dariusz Jasiński" },
  { role: "Kierownik Mieszkania III", name: "Marta Deptuła" },
];

const legalBasis = [
  "Ustawy o finansach publicznych (t.j. Dz. U. z 2019 r., poz. 869)",
  "Ustawy o samorządzie powiatowym (t.j. Dz. U. z 2019 r., poz. 511)",
  "Ustawy o pracownikach samorządowych (t.j. Dz. U. z 2019 r., poz. 1282)",
  "Ustawy o pomocy społecznej (t.j. Dz. U. z 2018 r., poz. 1508)",
  "Rozporządzenia w sprawie domów pomocy społecznej (t.j. Dz. U. z 2018 r., poz. 734)",
  "Decyzji nr PS.II.UR.3013-19.06 Wojewody Warmińsko-Mazurskiego z 13 lutego 2007 r. w sprawie zezwolenia na prowadzenie domu pomocy społecznej dla osób przewlekle psychicznie chorych",
];
---

<Base
  title="O nas"
  description="Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — podstawa prawna działania Domu, kierownictwo oraz dokumenty ustrojowe do pobrania."
>
  <PageHeader breadcrumbs title="O nas" />

  <PageShell>
    <Toc slot="rail" items={toc} />

    <Brief>
      <li>Nasz Dom przeznaczony jest dla osób przewlekle psychicznie chorych.</li>
      <li>Zapewniamy opiekę całodobową dla 196 osób.</li>
      <li>
        Dom Pomocy Społecznej w Szczytnie zamieszkuje 171 Mieszkańców, a filię w Spychowie 25
        Mieszkańców.
      </li>
    </Brief>

    <div class="doc mt-subsection">
      <h2 id="nasz-dom">Nasz dom</h2>
      <p>
        Nasz Dom stoi w Szczytnie przy ul. Wielbarskiej 2. Filia Domu Pomocy Społecznej
        w Spychowie istnieje od 2001 r.
      </p>
      <p>
        Troszczymy się o dobre samopoczucie naszych Mieszkańców, nie zapominając
        o indywidualności każdego z nich. Wszechstronna opieka terapeutyczna i medyczna oraz
        zaangażowanie pracowników w stworzenie jak najlepszej atmosfery zapewniają godne warunki
        życia ze szczególnym poszanowaniem prawa do wolności, intymności i poczucia
        bezpieczeństwa.
      </p>
      <p>
        Podejmujemy działania zmierzające do integracji osób chorujących psychicznie ze
        środowiskiem lokalnym. Nasi Mieszkańcy są gośćmi kawiarni, aktywnie korzystają z plaży
        miejskiej, są członkami Klubu Miłośników Kina. Współpracujemy też z uczniami lokalnych
        szkół.
      </p>

      <h2 id="dla-kogo">Dla kogo jest nasz dom</h2>
      <p>
        Nasz Dom przeznaczony jest dla osób przewlekle psychicznie chorych. Zapewniamy opiekę
        całodobową dla 196 osób. Dom Pomocy Społecznej w Szczytnie zamieszkuje 171 Mieszkańców,
        a filię w Spychowie 25 Mieszkańców.
      </p>
      <p>
        Nasi Mieszkańcy objęci są opieką lekarza psychiatry. Korzystają z usług psychologa
        i rehabilitanta zatrudnionych w Domu. Zapewniamy wsparcie wykwalifikowanych terapeutów,
        którzy dbają o to, aby Mieszkańcy aktywnie spędzali swój czas i rozwijali swoje
        zainteresowania.
      </p>
      <p>
        Szczegółowy zakres usług opiekuńczych, pielęgnacyjnych i wspomagających opisujemy na
        stronie <a href="/zycie-w-domu/">Oferta</a>. O filii piszemy na stronie <a
          href="/zycie-w-domu/spychowo/">Filia Domu Pomocy w Spychowie</a
        >.
      </p>

      <h2 id="kierownictwo">Kierownictwo DPS w Szczytnie</h2>
      <dl>
        {
          management.map((person) => (
            <>
              <dt>{person.role}</dt>
              <dd>{person.name}</dd>
            </>
          ))
        }
      </dl>

      <h2 id="podstawa-prawna">Podstawa prawna działania Domu Pomocy Społecznej w Szczytnie</h2>
      <p>Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie funkcjonuje na podstawie:</p>
      <ol>
        {legalBasis.map((item) => <li>{item}</li>)}
      </ol>

      <h2 id="dokumenty">Dokumenty</h2>
    </div>

    <div class="mt-block">
      <DocList docs={dokumentyUstrojowe} />
    </div>
  </PageShell>
</Base>
