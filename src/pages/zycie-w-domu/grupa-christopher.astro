---
/**
 * The vocal group, carrying the production site's `/programs/` page. The two
 * press articles exist on the production site only as JPG scans, so their text
 * is transcribed here word for word from those scans — the transcription is an
 * accessibility layer over a document the Dom published, not new copy.
 */
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";
import Toc from "../../components/Toc.astro";
import Brief from "../../components/Brief.astro";
import Figure from "../../components/Figure.astro";

import groupOnStage from "../../assets/media/1168-christopherGroup.jpg";
import pressMuzyka from "../../assets/media/1169-christopher680.jpg";
import pressSeniorska from "../../assets/media/1170-gazeta680.jpg";

const toc = [
  { id: "grupa", label: "Grupa wokalna" },
  { id: "media", label: "O nas w mediach" },
  { id: "muzyka", label: "Muzyka z naszych stron" },
];

const members = ["Władysław Drozdowski", "Waldemar Szmul", "Jan Pieryni", "Ryszard Haftkowski"];
---

<Base
  title="Grupa wokalna „Christopher”"
  description="Grupa Wokalna „Christopher” działa w Domu Pomocy Społecznej w Szczytnie od 2005 roku. Została stworzona w ramach zajęć pracowni muzykoterapii."
>
  <PageHeader breadcrumbs title="Grupa wokalna „Christopher”" />

  <PageShell>
    <Toc slot="rail" items={toc} />

    <Brief>
      <li>
        Grupa Wokalna „Christopher” działa w Domu Pomocy Społecznej w Szczytnie od 2005 roku.
      </li>
      <li>Została stworzona w ramach zajęć pracowni muzykoterapii.</li>
      <li>Opiekunem i założycielem zespołu jest Krzysztof Fuks.</li>
    </Brief>

    <div class="doc mt-subsection">
      <h2 id="grupa">Grupa wokalna</h2>
      <p>
        Grupa Wokalna „Christopher” działa w Domu Pomocy Społecznej w Szczytnie od 2005 roku.
        Została stworzona w ramach zajęć pracowni muzykoterapii. Podstawowym celem istnienia grupy
        jest budowanie wiary w siebie, w swoje możliwości, rozwijanie zainteresowań muzycznych,
        integracja osób z niepełnosprawnościami ze środowiskiem lokalnym.
      </p>

      <Figure
        src={groupOnStage}
        alt="Pięciu członków grupy wokalnej „Christopher” śpiewa na plenerowej scenie pod żółtym namiotem."
        loading="eager"
      />

      <h2 id="media">O nas w mediach</h2>
      <p>
        Członkowie grupy postawili sobie też za cel propagowanie piosenek Krzysztofa Klenczona
        i „Czerwonych Gitar”. Wraz z rozwojem wokalnym w repertuarze grupy pojawiły się piosenki
        biesiadne oraz disco-polo.
      </p>

      <h2 id="muzyka">Muzyka z naszych stron</h2>
      <p>
        Grupa wystąpiła na wielu znaczących imprezach – Festiwalach Małych Form Artystycznych,
        Majówkach, Festynach Rodzinnych, Festynach Kół Gospodyń Wiejskich, na Spartakiadach
        Sportowych itp. – wszędzie tam gdzie uczestnicy spotkań chcą się dobrze i wesoło bawić.
      </p>
      <h3>Skład zespołu</h3>
      <ul>
        {members.map((name) => <li>{name}</li>)}
      </ul>
      <p>Opiekunem i założycielem zespołu jest Krzysztof Fuks.</p>

      <h3>„Muzyka z naszych stron” — artykuł Katarzyny Mikulak</h3>
      <p>Poniżej przepisana treść skanu artykułu:</p>
      <blockquote>
        <p>Prezentacje. Z wizytą u członków zespołu „Christopher”</p>
        <p>
          Muzyka legendarnych Czerwonych Gitar może bawić i leczyć. Przykładem tego jest
          działający przy Domu Pomocy Społecznej w Szczytnie zespół „Christopher”.
        </p>
        <p>
          W skład zespołu wchodzi pięciu mieszkańców Domu Pomocy Społecznej w Szczytnie: Jan
          Pieryni (47 l.), Marek Lachowicz (27 l.), Grzegorz Leśnik (40 l.), Władysław Drozdowski
          (46 l.) i Miron Prusaczyk (62 l.). Prowadzi go muzykoterapeuta Krzysztof Fuks. Zespół
          powstał niecały rok temu. Zaczęto wtedy prace nad zgraniem głosu poszczególnych osób
          i doborem repertuaru. Ostatecznie wybór padł na muzykę „Czerwonych Gitar” – także
          dlatego, że rok 2006 ogłoszono rokiem klenczonowskim. Ale nie tylko z tego powodu.
        </p>
        <p>
          — To melodyjne, wpadające w ucho piosenki, które wszystkim się podobają. Nasza ulubiona
          to „Niebo z moich stron” — mówią zgodnie członkowie zespołu.
        </p>
        <p><strong>Powiedz stary gdzieś ty był?</strong></p>
        <p>
          W repertuarze „Christophera” znalazło się 17 piosenek. Śpiewacy spotykają się codziennie
          na próbach i nie szczędzą sił ani czasu, by pracować nad swoim talentem. Dla trzech
          z nich nie jest to pierwsza przygoda z muzyką. Pan Grzegorz w wojsku grał na trąbce
          i perkusji. Teraz gra na organach. Komponuje też uspokajające melodie, tworzy muzykę
          wyobraźni.
        </p>
        <p>
          — Chciałbym kiedyś przedstawić te melodie publiczności, a moim marzeniem jest wydanie
          własnej płyty — opowiada. Z kolei pan Jan często grywał na weselach i innych imprezach.
          Wiele razy słyszał, że ma dobry słuch i powinien rozwijać ten talent.
        </p>
        <p>
          Najmłodszy z „Christopherów” Marek na co dzień słucha punk rocka, ale otwarcie przyznaje,
          że klenczonowskie nuty też mu się bardzo podobają. Podobno też ładnie gra na gitarze,
          a nauczył się tej sztuki mając 13 lat.
        </p>
        <p><strong>Nie zadzieraj nosa</strong></p>
        <p>
          Pomysł stworzenia takiego zespołu działającego w ramach muzykoterapii podpowiedział
          Krzysztofowi Fuksowi dyrektor DPS Henryk Wilga. Spotkania w zespole okazały się
          rewelacją. — Chłopakom bardzo pomagają wspólne ćwiczenia i występy. Już widać efekty,
          stali się bardziej otwarci, uśmiechnięci i odważniejsi. Spotykają się z wieloma wyrazami
          sympatii i uznania dla tego, co robią. To dla nich coś bardzo ważnego — opowiada
          prowadzący zespół.
        </p>
        <p>
          — Ludzie mówią, że dzięki występom zacząłem głośniej śpiewać w kościele — żartuje pan
          Miron.
        </p>
        <p><strong>Nie spoczniemy?</strong></p>
        <p>
          Członkowie „Christophera” śpiewają też pieśni biesiadne, a nawet piosenki disco-polo,
          które zaprezentowali rok temu na Festiwalu Małych Form Artystycznych dla osób
          niepełnosprawnych. Mają też za sobą swój pierwszy debiut przed szczycieńską
          publicznością. Pierwszego maja wystąpili w amfiteatrze przy MDK w Szczytnie. Sądząc po
          reakcji publiczności, ich wstęp bardzo się spodobał. Szybko też pojawiły się zaproszenia
          na kolejne imprezy. Na początku czerwca „Christopher” zaprezentuje się m.in. na
          festiwalu w Olsztynie.
        </p>
        <p>
          — Chcielibyśmy grać dla wszystkich, którzy lubią muzykę Klenczona. Jeśli ktoś ma ochotę
          posłuchać jej w naszym wykonaniu, wystarczy tylko dać znak — zachęcają członkowie
          zespołu.
        </p>
        <p>Katarzyna Mikulak</p>
      </blockquote>

      <Figure
        src={pressMuzyka}
        alt="Skan artykułu prasowego „Muzyka z naszych stron” ze zdjęciem sześciu członków zespołu „Christopher” stojących obok siebie. Treść artykułu przepisana powyżej."
        caption="Podpis pod zdjęciem: Zespół „Christopher” tworzą (od lewej): Władysław Drozdowski, Marek Lachowicz, Miron Prusaczyk, prowadzący zespół Krzysztof Fuks, Grzegorz Leśnik, Jan Pieryni. Fot. Katarzyna Mikulak."
        widths={[504, 680]}
        sizes="(min-width: 40rem) 28rem, 100vw"
      />

      <h3>„Seniorska impreza”, 13 lipca 2006</h3>
      <p>Poniżej przepisana treść skanu artykułu:</p>
      <blockquote>
        <p>Powiatowy Dzień Emeryta i Rencisty</p>
        <p>
          W siedzibie Polskiego Związku Emerytów, Rencistów i Inwalidów w Szczytnie odbył się
          Powiatowy Dzień Emeryta i Rencisty.
        </p>
        <p>
          W uroczystości uczestniczyli m.in. Andrzej Kijewski starosta szczycieński, Wiesław
          Szubka wicestarosta, Stefan Januszczyk naczelnik wydziału w starostwie powiatowym,
          Henryk Wilga dyrektor Domu Pomocy Społecznej w Szczytnie. Uroczystość miała charakter
          festynu, podczas którego nie mogło zabraknąć konkursów, loterii fantowej oraz smacznej
          grochówki. W czasie zabawy zaprezentowały się zespoły śpiewacze i wokalne: Babskie
          Olekanie z Rozóg, Christopher działający przy DPS w Szczytnie, oraz Echo z Pasymia.
        </p>
        <p>
          Organizatorem Powiatowego Dnia Emeryta i Rencisty był Polski Związek Emerytów,
          Rencistów i Inwalidów w Szczytnie i starostwo powiatowe w Szczytnie.
        </p>
      </blockquote>

      <Figure
        src={pressSeniorska}
        alt="Skan artykułu prasowego „Seniorska impreza” z 13 lipca 2006 roku ze zdjęciem plenerowego występu przed siedzącą w ogrodzie publicznością. Treść artykułu przepisana powyżej."
        caption="Podpis pod zdjęciem: Wszyscy zaproszeni goście bawili się wyśmienicie podczas występów."
        widths={[504, 680]}
        sizes="(min-width: 40rem) 28rem, 100vw"
      />
    </div>
  </PageShell>
</Base>
