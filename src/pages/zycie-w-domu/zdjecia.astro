---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";
import Toc from "../../components/Toc.astro";
import Gallery from "../../components/Gallery.astro";

import buildingGarden from "../../assets/media/1377-1-1.jpg";
import buildingMonument from "../../assets/media/1375-2-1.jpg";
import buildingAltana from "../../assets/media/1376-3.jpg";
import complexView from "../../assets/media/1362-680-00296.jpg";

import roomSingle from "../../assets/media/1186-2012-07-25-at-10-43-511.jpg";
import roomShared from "../../assets/media/1185-2012-07-25-at-10-40-40.jpg";
import commonRoom from "../../assets/media/1188-2012-07-25-at-10-18-46-1-1.jpg";
import diningRoom from "../../assets/media/1187-2012-07-25-at-10-46-26.jpg";
import treatmentRoom from "../../assets/media/1182-2012-07-25-at-10-20-35.jpg";

import choirOnStage from "../../assets/media/1168-christopherGroup.jpg";

const toc = [
  { id: "budynki", label: "Budynki i otoczenie" },
  { id: "wnetrza", label: "Wnętrza" },
  { id: "wystepy", label: "Zajęcia i występy" },
];

const buildings = [
  {
    src: buildingGarden,
    alt: "Główny budynek Domu z czerwonym dachem, widziany zza kwitnących hortensji przy wjeździe",
  },
  {
    src: buildingMonument,
    alt: "Ogród przed Domem z pomnikiem świętego Jana Pawła II, ławkami i strzyżonymi krzewami",
  },
  {
    src: buildingAltana,
    alt: "Biały budynek Domu z czerwonym dachem i drewniana altana w ogrodzie.",
  },
  {
    src: complexView,
    alt: "Widok z góry na wiatę parkingową z kolektorami słonecznymi na terenie Domu, wśród zieleni.",
  },
];

const interiors = [
  {
    src: roomSingle,
    alt: "Mieszkaniec siedzi na tapczanie w swoim pokoju jednoosobowym; przy oknie telewizor i stolik.",
  },
  {
    src: roomShared,
    alt: "Dwie Mieszkanki siedzą w fotelach przy stoliku w swoim pokoju.",
  },
  {
    src: commonRoom,
    alt: "Mieszkańcy i terapeutka przy wspólnym stole w świetlicy, w tle regały z książkami.",
  },
  {
    src: diningRoom,
    alt: "Jasna jadalnia z drewnianymi krzesłami i stołami nakrytymi obrusami",
  },
  {
    src: treatmentRoom,
    alt: "Gabinet zabiegowy: pielęgniarka przy biurku, przeszklone szafy z lekami.",
  },
];

const events = [
  {
    src: choirOnStage,
    alt: "Pięciu członków grupy wokalnej „Christopher” śpiewa na plenerowej scenie pod żółtym namiotem.",
  },
];
---

<Base
  title="Galeria"
  description="Zdjęcia Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie: budynki i ogród, wnętrza mieszkań oraz występy grupy wokalnej Christopher."
>
  <PageHeader
    breadcrumbs
    title="Galeria"
    lead="Kilka zdjęć naszego Domu: budynki i ogród, w którym Mieszkańcy spędzają czas, wnętrza mieszkań oraz występy grupy wokalnej „Christopher”."
  />

  <PageShell>
    <Toc slot="rail" items={toc} />

    <div class="doc">
      <h2 id="budynki">Budynki i otoczenie</h2>
      <p>
        Dom stoi przy ulicy Wielbarskiej w Szczytnie, w otoczeniu ogrodu z alejkami, ławkami
        i pomnikiem patrona.
      </p>
    </div>
    <div class="mt-block">
      <Gallery photos={buildings} />
    </div>

    <div class="doc mt-section">
      <h2 id="wnetrza">Wnętrza i życie codzienne</h2>
      <p>
        Pokoje Mieszkańców, świetlice, jadalnia i gabinety zabiegowe — miejsca, w których toczy się
        zwykły dzień w naszym Domu.
      </p>
    </div>
    <div class="mt-block">
      <Gallery photos={interiors} />
    </div>

    <div class="doc mt-section">
      <h2 id="wystepy">Zajęcia i występy</h2>
      <p>
        Nasi Mieszkańcy występują na festynach i festiwalach w regionie. Więcej o zespole piszemy na
        stronie <a href="/zycie-w-domu/grupa-christopher/">Grupa wokalna „Christopher”</a>.
      </p>
    </div>
    <div class="mt-block">
      <Gallery photos={events} />
    </div>
  </PageShell>
</Base>
