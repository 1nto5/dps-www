---
/**
 * Whistleblower section landing page. The production page has no body content
 * of its own — it is nothing but the way into the four subpages that do.
 */
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";
import PageList from "../../components/PageList.astro";
import { childrenOf } from "../../data/nav";

const subpages = childrenOf("/sygnalista/");
---

<Base
  title="Sygnalista"
  description="Zgłaszanie naruszeń prawa w Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie — wewnętrzna procedura, osoba upoważniona, klauzula informacyjna i załączniki."
>
  <PageShell>
    <PageHeader slot="header" breadcrumbs title="Sygnalista" />

    <PageList items={subpages} />
  </PageShell>
</Base>
