---
/**
 * Every grant the Dom has disclosed, on one page, newest year first. The seven
 * year pages of the old site are the chapters here; the emblem that used to
 * open one of them opens the whole page instead. Figures, amounts and the
 * official wording are reproduced as published — grant publicity rules do not
 * allow rewording them.
 */
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageShell from "../components/PageShell.astro";
import SubNav from "../components/SubNav.astro";
import Toc from "../components/Toc.astro";
import Figure from "../components/Figure.astro";
import DocList from "../components/DocList.astro";

import emblem from "../assets/media/1423-Picture-1.png";
import poster2025Motywacyjny from "../assets/media/plakat-dodatek-motywacyjny-2025.png";
import poster2025Celowa from "../assets/media/2422-dotacje-2025.png";
import poster2024 from "../assets/media/2059-Screenshot-2024-10-02-at-12.30.49.png";
import poster2022Sierpien from "../assets/media/1245-dot1.jpg";
import poster2022Marzec from "../assets/media/1246-Informacja-na-strone-1.jpg";
import poster2021Wyposazenie from "../assets/media/1257-110.jpg";
import poster2021Covid from "../assets/media/1258-97.jpg";
import poster2021Wzmocnienie from "../assets/media/1259-123-1.jpg";
import poster2020Ochrona from "../assets/media/1266-212.jpg";
import poster2020Gratyfikacje from "../assets/media/1267-32.jpg";
import poster2020Opieka from "../assets/media/1268-41.jpg";
import poster2020Ciaglosc from "../assets/media/1269-54.jpg";
import poster2020SrodkiOchrony from "../assets/media/1270-61.jpg";
import poster2019 from "../assets/media/1277-00013.jpg";
import poster2018 from "../assets/media/1278-333_page-0001.jpg";
import poster2016 from "../assets/media/1279-72.jpg";

const toc = [
  { id: "rok-2025", label: "2025" },
  { id: "rok-2024", label: "2024" },
  { id: "rok-2023", label: "2023" },
  { id: "rok-2022", label: "2022" },
  { id: "rok-2021", label: "2021" },
  { id: "rok-2020", label: "2020" },
  { id: "rok-2019-2018-2016", label: "2019, 2018 i 2016" },
];

const docs2024 = [
  {
    href: "/dokumenty/pliki/1934-plakat-dodatek-motywacyjny.pdf",
    label: "Plakat informacyjny — dodatek motywacyjny w roku 2024",
    format: "PDF",
    size: "553 KB",
  },
];

const posterSizes = "(min-width: 48rem) 42rem, 100vw";
---

<Base
  title="Dotacje"
  description="Dotacje i dofinansowania otrzymane przez Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — informacje z lat 2016–2025."
>
  <PageShell>
    <PageHeader
      bare
      slot="header"
      breadcrumbs
      title="Dotacje"
      lead="Informujemy o środkach publicznych, które otrzymuje nasz Dom. Poniżej znajdą Państwo informacje o dotacjach z podziałem na lata."
    />

    <Fragment slot="aside">
      <SubNav />
      <Toc items={toc} title="Lata" />
    </Fragment>

    <Figure
      src={emblem}
      alt="Flaga Rzeczypospolitej Polskiej i godło Polski — znaki informujące o dofinansowaniu ze środków budżetu państwa."
      widths={[480, 800]}
      sizes="(min-width: 48rem) 22rem, 70vw"
      loading="eager"
      class="mt-8 max-w-prose"
    />

    <div class="prose mt-8">
      <h2 id="rok-2025">Dotacje 2025</h2>

      <h3>Dofinansowano ze środków budżetu państwa</h3>
      <p>
        Program „Dofinansowanie wynagrodzeń pracowników jednostek organizacyjnych pomocy społecznej
        w postaci dodatku motywacyjnego na lata 2024–2027” w roku 2025.
      </p>
      <p>
        <strong>Dofinansowanie: 1 730 105,53 zł</strong><br />
        <strong>Całkowita wartość: 1 730 105,53 zł</strong>
      </p>

      <h4>Cel programu</h4>
      <p>
        Pomoc w postaci dodatkowych środków na dofinansowanie wynagrodzeń pracowników jednostek
        organizacyjnych pomocy społecznej.
      </p>

      <h4>Realizowane zadania</h4>
      <p>
        Wypłata dodatków motywacyjnych w wysokości 1000 zł brutto oraz kosztów składek od dodatków
        w okresie od dnia 1 lipca 2024 r. do dnia 31 grudnia 2027 r. dla pracowników zatrudnionych
        na umowę o pracę w jednostkach organizacyjnych pomocy społecznej prowadzonych przez
        jednostki samorządu terytorialnego lub na ich zlecenie.
      </p>

      <h4>Grupa docelowa</h4>
      <p>
        Pracownicy zatrudnieni na umowę o pracę w jednostkach organizacyjnych pomocy społecznej
        prowadzonych przez jednostki samorządu terytorialnego lub na zlecenie jednostek samorządu
        terytorialnego.
      </p>

      <h4>Efekty programu</h4>
      <p>
        Wsparcie i poprawa sytuacji finansowej pracowników zatrudnionych w jednostkach
        organizacyjnych pomocy społecznej oraz utrzymanie wysokiego standardu realizowanych usług
        w pomocy społecznej.
      </p>

      <Figure
        src={poster2025Motywacyjny}
        alt="Plakat informacyjny z flagą i godłem Polski: dofinansowano ze środków budżetu państwa, program dodatku motywacyjnego na lata 2024–2027, dofinansowanie w roku 2025 w kwocie 1 730 105,53 zł."
        caption="Plakat informacyjny programu dodatku motywacyjnego — rok 2025."
        sizes={posterSizes}
      />

      <h3>Dotacja celowa na zadania własne powiatu</h3>
      <p>
        Dotacja udzielona w 2025 roku na dofinansowanie realizacji zadań własnych powiatów,
        związanych z działalnością Domu Pomocy Społecznej w Szczytnie.
      </p>
      <p>
        <strong>Dofinansowanie: 87 908,00 zł</strong><br />
        <strong>Całkowita wartość zadania: 109 987,99 zł</strong>
      </p>
      <p>
        Dotacja celowa udzielona w 2025 roku z budżetu Wojewody Warmińsko-Mazurskiego na realizację
        zadań własnych w rozdziale 85202 § 2130 z przeznaczeniem na dofinansowanie wydatków na zakup
        wyposażenia i doposażenia obiektu, w którym przebywają Mieszkańcy umieszczeni w Domu Pomocy
        Społecznej w Szczytnie.
      </p>

      <Figure
        src={poster2025Celowa}
        alt="Plakat informacyjny z flagą i godłem Polski: dotacja udzielona w 2025 roku na zadania własne powiatów związane z działalnością Domu Pomocy Społecznej w Szczytnie, dofinansowanie 87 908,00 zł, całkowita wartość zadania 109 987,99 zł."
        caption="Plakat informacyjny dotacji celowej Wojewody Warmińsko-Mazurskiego — rok 2025."
        sizes={posterSizes}
      />

      <h2 id="rok-2024">Dotacje 2024</h2>

      <h3>Dofinansowano ze środków budżetu państwa</h3>
      <p>
        Program „Dofinansowanie wynagrodzeń pracowników jednostek organizacyjnych pomocy społecznej
        w postaci dodatku motywacyjnego na lata 2024–2027” w roku 2024.
      </p>
      <p>
        <strong>Dofinansowanie: 994 620,00 zł</strong><br />
        <strong>Całkowita wartość: 994 620,00 zł</strong>
      </p>

      <h4>Cel programu</h4>
      <p>
        Pomoc w postaci dodatkowych środków na dofinansowanie wynagrodzeń pracowników jednostek
        organizacyjnych pomocy społecznej.
      </p>

      <h4>Realizowane zadania</h4>
      <p>
        Wypłata dodatków motywacyjnych w wysokości 1000 zł brutto oraz kosztów składek od dodatków
        w okresie od dnia 1 lipca 2024 r. do dnia 31 grudnia 2027 r. dla pracowników zatrudnionych
        na umowę o pracę w jednostkach organizacyjnych pomocy społecznej prowadzonych przez
        jednostki samorządu terytorialnego lub na ich zlecenie.
      </p>

      <h4>Grupa docelowa</h4>
      <p>
        Pracownicy zatrudnieni na umowę o pracę w jednostkach organizacyjnych pomocy społecznej
        prowadzonych przez jednostki samorządu terytorialnego lub na zlecenie jednostek samorządu
        terytorialnego.
      </p>

      <h4>Efekty programu</h4>
      <p>
        Wsparcie i poprawa sytuacji finansowej pracowników zatrudnionych w jednostkach
        organizacyjnych pomocy społecznej oraz utrzymanie wysokiego standardu realizowanych usług
        w pomocy społecznej.
      </p>

      <Figure
        src={poster2024}
        alt="Plakat informacyjny z flagą i godłem Polski: dofinansowano ze środków budżetu państwa, program dodatku motywacyjnego na lata 2024–2027, dofinansowanie w roku 2024 w kwocie 994 620,00 zł."
        caption="Plakat informacyjny programu dodatku motywacyjnego — rok 2024."
        sizes={posterSizes}
      />

      <h3>Do pobrania</h3>
    </div>

    <div class="mt-8 max-w-prose">
      <DocList docs={docs2024} />
    </div>

    <div class="prose mt-16">
      <h2 id="rok-2023">Dotacje 2023</h2>

      <h3>Dofinansowanie ze środków rezerwy celowej budżetu państwa</h3>
      <p>Środki pochodzą z rezerwy celowej w ustawie budżetowej na 2023 rok.</p>
      <p>
        <strong>Dom Pomocy Społecznej w Szczytnie w 2023 r.</strong> otrzymał
        z Warmińsko-Mazurskiego Urzędu Wojewódzkiego środki dotacji celowej pochodzącej z rezerwy
        celowej (cz. 83, poz. 49), w rozdziale 85202 § 2130 — Domy Pomocy Społecznej.
      </p>
      <p>
        <strong>Wartość dofinansowania: 914 029,00 zł</strong><br />
        (słownie: dziewięćset czternaście tysięcy dwadzieścia dziewięć złotych 00/100).
      </p>
      <p><strong>Środki z funduszu przeznaczono na wypłatę dodatków dla pracowników.</strong></p>
    </div>

    <div class="prose mt-16">
      <h2 id="rok-2022">Dotacje 2022</h2>

      <h3>Fundusz Przeciwdziałania COVID-19 — dyżury od sierpnia do września 2022</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał środki z Funduszu Przeciwdziałania COVID-19
        z przeznaczeniem na: pomoc dla domów pomocy społecznej w przeciwdziałaniu skutkom
        rozprzestrzeniania się wirusa SARS-CoV-2, w 2022 roku.
      </p>
      <p><strong>Wartość całkowita zadania: 45 560,00 zł</strong></p>
      <p>
        Środki zostaną przeznaczone na zabezpieczenie dyżurów pielęgniarek z tytułu umowy zlecenie na
        okres od sierpnia do września 2022 roku.
      </p>

      <Figure
        src={poster2022Sierpien}
        alt="Informacja z flagą i godłem Polski o środkach z Funduszu Przeciwdziałania COVID-19 w 2022 roku na kwotę 45 560,00 zł, przeznaczonych na dyżury pielęgniarek od sierpnia do września 2022 roku."
        caption="Informacja o dofinansowaniu — dyżury pielęgniarskie od sierpnia do września 2022 roku."
        sizes={posterSizes}
      />

      <h3>Fundusz Przeciwdziałania COVID-19 — dyżury od marca do lipca 2022</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał środki z Funduszu Przeciwdziałania COVID-19
        z przeznaczeniem na: pomoc dla domów pomocy społecznej w przeciwdziałaniu skutkom
        rozprzestrzeniania się wirusa SARS-CoV-2, w 2022 roku.
      </p>
      <p><strong>Wartość całkowita zadania: 119 136,00 zł</strong></p>
      <p>
        Środki zostaną przeznaczone na zabezpieczenie dyżurów pielęgniarek z tytułu umowy zlecenie na
        okres od marca do lipca 2022 roku.
      </p>

      <Figure
        src={poster2022Marzec}
        alt="Informacja z flagą i godłem Polski o środkach z Funduszu Przeciwdziałania COVID-19 w 2022 roku na kwotę 119 136,00 zł, przeznaczonych na dyżury pielęgniarek od marca do lipca 2022 roku."
        caption="Informacja o dofinansowaniu — dyżury pielęgniarskie od marca do lipca 2022 roku."
        sizes={posterSizes}
      />

      <h2 id="rok-2021">Dotacje 2021</h2>

      <h3>Dotacja wojewody na realizację zadań domów pomocy społecznej</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał dotację pochodzącą z budżetu Wojewody
        Warmińsko-Mazurskiego z przeznaczeniem na: dofinansowanie realizacji zadań domów pomocy
        społecznej.
      </p>
      <p>
        <strong>Wartość dofinansowania: 121 624 zł</strong><br />
        <strong>Wartość całkowita zadania: 152 030 zł</strong>
      </p>
      <p>
        Zakupione materiały i wyposażenie w celu zapewnienia godnych warunków życia Mieszkańcom,
        podniesienia standardów, zachowania odpowiedniej higieny i czystości oraz komfortu życia.
      </p>

      <Figure
        src={poster2021Wyposazenie}
        alt="Informacja z flagą i godłem Polski o dotacji Wojewody Warmińsko-Mazurskiego na realizację zadań domów pomocy społecznej: dofinansowanie 121 624 zł, całkowita wartość zadania 152 030 zł."
        caption="Informacja o dotacji na zadania domów pomocy społecznej."
        sizes={posterSizes}
      />

      <h3>Fundusz Przeciwdziałania COVID-19 — zakup sprzętu</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał dotację pochodzącą z Funduszu
        Przeciwdziałania COVID-19 z przeznaczeniem na: pomoc dla domów pomocy społecznej
        w przeciwdziałaniu skutkom rozprzestrzeniania się wirusa SARS-CoV-2.
      </p>
      <p><strong>Wartość całkowita zadania: 120 988 zł</strong></p>
      <p>
        W związku z występowaniem w DPS zakażeń COVID-19, a Mieszkańcy znajdują się w grupie
        wysokiego ryzyka, zostanie zakupiony sprzęt, który bezpośrednio pomoże w walce z COVID-19.
      </p>

      <Figure
        src={poster2021Covid}
        alt="Informacja z flagą i godłem Polski o dotacji z Funduszu Przeciwdziałania COVID-19 na kwotę 120 988 zł, przeznaczonej na zakup sprzętu do walki z COVID-19."
        caption="Informacja o dotacji z Funduszu Przeciwdziałania COVID-19."
        sizes={posterSizes}
      />

      <h3>Wzmocnienie zabezpieczenia domów pomocy społecznej</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał dotację pochodzącą z budżetu Wojewody
        Warmińsko-Mazurskiego z przeznaczeniem na: wzmocnienie zabezpieczenia domów pomocy społecznej
        przed skutkami występowania wirusa COVID-19, w szczególności na zapewnienie kadry niezbędnej
        do zachowania ciągłości usług świadczonych przez te jednostki oraz zakup niezbędnych środków
        ochrony osobistej, sprzętu i wyposażenia.
      </p>
      <p><strong>Wartość całkowita zadania: 73 701,00 zł</strong></p>
      <p>
        Wzmocnienie zabezpieczenia domów pomocy społecznej przed skutkami występowania wirusa
        COVID-19, w szczególności na zapewnienie kadry niezbędnej do zachowania ciągłości usług
        świadczonych przez te jednostki oraz zakup niezbędnych środków ochrony osobistej, sprzętu
        i wyposażenia.
      </p>

      <Figure
        src={poster2021Wzmocnienie}
        alt="Informacja z flagą i godłem Polski o dotacji Wojewody Warmińsko-Mazurskiego na wzmocnienie zabezpieczenia domów pomocy społecznej przed skutkami COVID-19, całkowita wartość zadania 73 701,00 zł."
        caption="Informacja o dotacji na wzmocnienie zabezpieczenia domów pomocy społecznej."
        sizes={posterSizes}
      />

      <h2 id="rok-2020">Dotacje 2020</h2>

      <h3>Środki ochrony osobistej dla domów pomocy społecznej</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał dotację pochodzącą z budżetu Wojewody
        Warmińsko-Mazurskiego z przeznaczeniem na: dofinansowanie realizacji zadań własnych,
        związanych z pokryciem potrzeb dla domów pomocy społecznej w zakresie zabezpieczenia
        w środki ochrony osobistej w celu przeciwdziałania rozprzestrzeniania się COVID-19 w domach
        pomocy społecznej.
      </p>
      <p>
        <strong>Wartość dofinansowania: 78 400 zł</strong><br />
        <strong>Wartość całkowita zadania: 98 000,65 zł</strong>
      </p>
      <p>
        Zakup środków ochrony osobistej w celu zapobiegania rozprzestrzeniania się COVID-19.
        Zabezpieczenie pracowników i Mieszkańców DPS przed zachorowaniem na COVID-19, zapewnienie
        środków ochrony zdrowia i życia.
      </p>

      <Figure
        src={poster2020Ochrona}
        alt="Informacja z flagą i godłem Polski o dotacji Wojewody Warmińsko-Mazurskiego na środki ochrony osobistej: dofinansowanie 78 400 zł, całkowita wartość zadania 98 000,65 zł."
        caption="Informacja o dotacji na zakup środków ochrony osobistej."
        sizes={posterSizes}
      />

      <h3>Gratyfikacje dla osób zatrudnionych w domach pomocy społecznej</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał środki z rezerwy celowej budżetu państwa
        z przeznaczeniem na: dofinansowanie realizacji zadań własnych, związanych z pokryciem potrzeb
        dla domów pomocy społecznej w zakresie dofinansowania bieżącej działalności domów pomocy
        społecznej (w tym gratyfikacje osób zatrudnionych w domach pomocy społecznej, ze szczególnym
        uwzględnieniem pracowników narażonych na negatywne skutki wystąpienia stanu epidemii wirusa
        SARS-CoV-2).
      </p>
      <p>
        <strong>Wartość dofinansowania: 72 348,00 zł</strong><br />
        <strong>Wartość całkowita zadania: 90 801,16 zł</strong>
      </p>
      <p>
        Dofinansowanie gratyfikacji osób zatrudnionych w domach pomocy społecznej, ze szczególnym
        uwzględnieniem pracowników narażonych na negatywne skutki wystąpienia stanu epidemii wirusa
        SARS-CoV-2 w Domu Pomocy Społecznej w Szczytnie.
      </p>

      <Figure
        src={poster2020Gratyfikacje}
        alt="Informacja z flagą i godłem Polski o środkach z rezerwy celowej budżetu państwa na gratyfikacje dla pracowników: dofinansowanie 72 348,00 zł, całkowita wartość zadania 90 801,16 zł."
        caption="Informacja o dofinansowaniu gratyfikacji dla pracowników."
        sizes={posterSizes}
      />

      <h3>Opieka pielęgniarska i ochrona osobista w Szczytnie oraz w Spychowie</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał środki z rezerwy celowej budżetu państwa
        oraz z budżetu Wojewody Warmińsko-Mazurskiego z przeznaczeniem na: dofinansowanie realizacji
        zadań własnych, związanych z pokryciem potrzeb dla domów pomocy społecznej w zakresie
        dofinansowania bieżącej działalności domów pomocy społecznej.
      </p>
      <p>
        <strong>Wartość dofinansowania z rezerwy celowej budżetu państwa: 52 957,34 zł</strong><br />
        <strong>Wartość dofinansowania z budżetu Wojewody Warmińsko-Mazurskiego: 68 780,51 zł</strong
        ><br />
        <strong>Wartość całkowita zadania: 199 327,85 zł</strong>
      </p>
      <p>
        Zabezpieczono opiekę pielęgniarską, w artykuły niezbędne do codziennego funkcjonowania oraz
        zabezpieczenie pracowników i Mieszkańców w środki ochrony osobistej przed COVID-19 w DPS
        Szczytno i Filii w Spychowie. Zwalczanie pandemii oraz zapobieganie jej negatywnym skutkom.
      </p>

      <Figure
        src={poster2020Opieka}
        alt="Informacja z flagą i godłem Polski o dofinansowaniu bieżącej działalności Domu: 52 957,34 zł z rezerwy celowej budżetu państwa, 68 780,51 zł z budżetu Wojewody Warmińsko-Mazurskiego, całkowita wartość zadania 199 327,85 zł."
        caption="Informacja o dofinansowaniu opieki pielęgniarskiej i środków ochrony osobistej."
        sizes={posterSizes}
      />

      <h3>Zapewnienie ciągłości usług i wynagrodzenia dla pracowników</h3>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał środki z rezerwy celowej budżetu państwa
        z przeznaczeniem na: dofinansowanie realizacji zadań własnych, związanych z pokryciem potrzeb
