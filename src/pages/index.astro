---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Figure from "../components/Figure.astro";
import PageList from "../components/PageList.astro";
import PostDate from "../components/PostDate.astro";
import { getCollection } from "astro:content";
import { contact, addressLine } from "../data/contact";

import heroPhoto from "../assets/media/1377-1-1.jpg";
import offerPhoto from "../assets/media/1188-2012-07-25-at-10-18-46-1-1.jpg";
import branchPhoto from "../assets/media/1376-3.jpg";
import musicPhoto from "../assets/media/1168-christopherGroup.jpg";

/** The four ways into the site, named the way the production site names them. */
const sections = [
  { href: "/zycie-w-domu/", label: "Oferta" },
  { href: "/zycie-w-domu/spychowo/", label: "Filia Domu Pomocy w Spychowie" },
  { href: "/zycie-w-domu/grupa-christopher/", label: "Grupa wokalna „Christopher”" },
  { href: "/o-domu/", label: "O nas" },
];

const posts = (await getCollection("aktualnosci")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = posts.slice(0, 3);
---

<Base
  title="Strona główna"
  description="Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — całodobowa opieka dla osób przewlekle psychicznie chorych, wraz z filią w Spychowie."
>
  <section class="mx-auto max-w-wide px-5 pt-10 sm:px-8 md:pt-14" aria-labelledby="hero-title">
    <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
      <div>
        <h1 id="hero-title" class="text-4xl md:text-5xl">
          Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie
        </h1>
        <p class="mt-5 max-w-[44ch] text-lg text-ink-soft">
          Nasz Dom przeznaczony jest dla osób przewlekle psychicznie chorych. Zapewniamy opiekę
          całodobową dla 196 osób.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/kontakt/">Kontakt i adres</Button>
          <Button href="/zycie-w-domu/" variant="secondary">Oferta</Button>
        </div>
      </div>
      <Figure
        src={heroPhoto}
        alt="Budynek Domu Pomocy Społecznej w Szczytnie z czerwonym dachem, widziany zza kwitnących hortensji"
        loading="eager"
        sizes="(min-width: 48rem) 32rem, 100vw"
      />
    </div>
  </section>

  <section class="mx-auto mt-section max-w-wide px-5 sm:px-8" aria-labelledby="o-domu">
    <div class="max-w-column">
      <h2 id="o-domu" class="text-2xl md:text-3xl">
        Witamy na stronie Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie
      </h2>
      <p class="mt-4">
        Dom Pomocy Społecznej w Szczytnie zamieszkuje 171 Mieszkańców, a filię w Spychowie 25
        Mieszkańców.
      </p>
      <p class="mt-4">
        Mieszkańcy w naszym Domu znajdują dobrą i wysoce wykwalifikowaną, całodobową opiekę.
        Troszczymy się też o dobre samopoczucie naszych Mieszkańców, nie zapominając
        o indywidualności każdego z nich. Zapewniamy wsparcie wykwalifikowanych terapeutów, którzy
        dbają o to, aby Mieszkańcy aktywnie spędzali swój czas i rozwijali swoje zainteresowania.
      </p>
      <p class="mt-4">
        Wszechstronna opieka terapeutyczna i medyczna oraz zaangażowanie pracowników w stworzenie
        jak najlepszej atmosfery zapewniają godne warunki życia ze szczególnym poszanowaniem prawa
        do wolności, intymności i poczucia bezpieczeństwa. Podejmujemy działania zmierzające do
        integracji osób chorujących psychicznie ze środowiskiem lokalnym.
      </p>
      <p class="mt-6">
        <a href="/o-domu/" class="font-semibold text-lake-deep underline">O nas</a>
      </p>
    </div>
  </section>

  <section class="mx-auto mt-section max-w-wide px-5 sm:px-8" aria-labelledby="czym-sie-zajmujemy">
    <h2 id="czym-sie-zajmujemy" class="text-2xl md:text-3xl">Strony naszego Domu</h2>
    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_20rem] lg:gap-14">
      <PageList items={sections} />
      <div class="grid gap-6 sm:grid-cols-3 lg:grid-cols-1">
        <Figure
          src={offerPhoto}
          alt="Mieszkańcy i terapeutka przy wspólnym stole w świetlicy, w tle regały z książkami."
          sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 33vw, 100vw"
          widths={[400, 700]}
        />
        <Figure
          src={branchPhoto}
          alt="Biały budynek Domu z czerwonym dachem i drewniana altana w ogrodzie"
          sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 33vw, 100vw"
          widths={[400, 700]}
        />
        <Figure
          src={musicPhoto}
          alt="Pięciu członków grupy wokalnej „Christopher” śpiewa na plenerowej scenie pod żółtym namiotem."
          sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 33vw, 100vw"
          widths={[400, 700]}
        />
      </div>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="mx-auto mt-section max-w-wide px-5 sm:px-8" aria-labelledby="aktualnosci">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 id="aktualnosci" class="text-2xl md:text-3xl">Aktualności</h2>
          <a href="/aktualnosci/" class="font-semibold text-lake-deep underline">
            Wszystkie aktualności
          </a>
        </div>
        <ul class="mt-6 max-w-column" role="list">
          {latest.map((post) => (
            <li class="border-t border-line py-4 last:border-b">
              <PostDate date={post.data.date} />
              <a href={`/aktualnosci/${post.id}/`} class="mt-1 inline-block text-lg font-semibold text-lake-deep underline">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-section border-y border-line bg-mist" aria-labelledby="kontakt-skrot">
    <div class="mx-auto grid max-w-wide gap-8 px-5 py-10 sm:px-8 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 id="kontakt-skrot" class="text-2xl">Kontakt</h2>
        <address class="mt-3 not-italic text-ink-soft">
          {addressLine(contact.address)}<br />
          tel. <a href={contact.phone.href} class="text-lake-deep underline">{contact.phone.label}</a><br />
          <a href={`mailto:${contact.email}`} class="text-lake-deep underline">{contact.email}</a>
        </address>
      </div>
      <p><Button href="/kontakt/">Pełne dane kontaktowe</Button></p>
    </div>
  </section>
</Base>
