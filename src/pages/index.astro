---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import ArchImage from "../components/ArchImage.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import heroPhoto from "../assets/media/1377-1-1.jpg";
import offerPhoto from "../assets/media/1188-2012-07-25-at-10-18-46-1-1.jpg";
import branchPhoto from "../assets/media/1185-2012-07-25-at-10-40-40.jpg";
import musicPhoto from "../assets/media/1168-christopherGroup.jpg";

const cards = [
  {
    href: "/oferta/",
    title: "Oferta",
    photo: offerPhoto,
    alt: "Mieszkańcy i terapeutka przy wspólnym stole w domowej bibliotece",
    text: "Zapewniamy całodobową opiekę, wsparcie pielęgniarskie i medyczne oraz zajęcia terapeutyczne dostosowane do możliwości każdego Mieszkańca. Dbamy o warunki bytowe, posiłki i codzienny rytm dnia, który daje poczucie bezpieczeństwa.",
  },
  {
    href: "/filia-w-spychowie/",
    title: "Filia w Spychowie",
    photo: branchPhoto,
    alt: "Dwie mieszkanki rozmawiające przy stoliku w swoim pokoju",
    text: "Filia w Spychowie działa od 2001 roku i jest domem dla Mieszkańców. Poza pokojami do dyspozycji są świetlica, kaplica, stołówka i pracownia terapeutyczna.",
  },
  {
    href: "/grupa-muzyczna/",
    title: "Grupa muzyczna",
    photo: musicPhoto,
    alt: "Zespół muzyczny Domu podczas występu na plenerowej scenie",
    text: "Nasza grupa muzyczna gra i śpiewa na uroczystościach w Domu oraz na przeglądach poza nim. Wspólne próby to dla Mieszkańców sposób na kontakt z ludźmi i na własną twórczość.",
  },
];

const posts = (await getCollection("aktualnosci")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = posts.slice(0, 3);
/** Same rule as /aktualnosci/: below three posts a three-column grid leaves a
    lone narrow card, so the block becomes a single-column list instead. */
const newsAsList = latest.length < 3;
const dateFormat = new Intl.DateTimeFormat("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Base
  title="Strona główna"
  description="Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — całodobowa opieka dla osób przewlekle psychicznie chorych, wraz z filią w Spychowie."
>
  <section
    class="mx-auto max-w-6xl px-4 pb-6 pt-10 sm:px-6 md:pt-14"
    aria-labelledby="hero-title"
    data-no-reveal
  >
    <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
      <PageHeader
        bare
        class="hero-enter"
        size="hero"
        titleId="hero-title"
        eyebrow="Szczytno i Spychowo"
        title="Dom z całodobową opieką"
        lead="Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie jest domem dla osób przewlekle psychicznie chorych. Razem z filią w Spychowie zapewniamy Mieszkańcom całodobową opiekę."
      >
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/kontakt/"
            class="rounded-lg bg-spruce px-5 py-3 font-semibold text-white hover:bg-spruce-deep active:bg-spruce-deep"
            >Kontakt i adres</a
          >
          <a
            href="/oferta/"
            class="rounded-lg border border-line bg-white px-5 py-3 font-semibold text-spruce-deep hover:bg-moss active:bg-moss-deep"
            >Poznaj naszą ofertę</a
          >
        </div>
      </PageHeader>
      {
        /* The column is capped instead of the frame: a `max-h` clamp would
           override the declared 3/4 ratio and flatten the arch. */
      }
      <div class="hero-enter-photo mx-auto w-full max-w-md md:max-w-[26rem]">
        <ArchImage
          src={heroPhoto}
          alt="Budynek Domu Pomocy Społecznej w Szczytnie z czerwonym dachem, widziany zza kwitnących hortensji"
          loading="eager"
          fetchpriority="high"
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 26rem, 100vw"
          aspect="3/4"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto mt-section max-w-6xl px-4 sm:px-6" aria-labelledby="o-domu">
    <div class="max-w-3xl">
      <h2 id="o-domu" class="text-2xl md:text-3xl">O naszym domu</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink/85">
        Troszczymy się o dobre samopoczucie Mieszkańców, nie zapominając o indywidualności każdego z
        nich. Wsparcie wykwalifikowanych terapeutów pomaga aktywnie spędzać czas i rozwijać
        zainteresowania, a wszechstronna opieka pielęgniarska i medyczna daje poczucie bezpieczeństwa.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-ink/85">
        Zależy nam na godnych warunkach życia, z poszanowaniem prawa do wolności i intymności.
        Podejmujemy też działania, które łączą Mieszkańców ze środowiskiem lokalnym — od wizyt szkół
        i zespołów artystycznych po nasze własne występy poza Domem.
      </p>
      <p class="mt-6">
        <a href="/o-nas/" class="font-semibold text-spruce underline underline-offset-4 hover:text-spruce-deep"
          >Więcej o Domu i jego kierownictwie</a
        >
      </p>
    </div>
  </section>

  <section class="mx-auto mt-section max-w-6xl px-4 sm:px-6" aria-labelledby="czym-sie-zajmujemy">
    <h2 id="czym-sie-zajmujemy" class="sr-only">Czym się zajmujemy</h2>
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        cards.map((card) => (
          <li class="photo-zoom relative flex flex-col overflow-hidden rounded-xl border border-line bg-white transition-colors duration-150 hover:border-spruce/40 hover:shadow-[0_1px_2px_rgba(38,49,43,0.08)] focus-within:border-spruce/40">
            <Image
              src={card.photo}
              alt={card.alt}
              widths={[400, 700]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="aspect-[4/3] w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-xl">{card.title}</h3>
              <p class="mt-2 flex-1 text-muted">{card.text}</p>
              <p class="mt-4">
                <a
                  href={card.href}
                  data-card-link
                  class="font-semibold text-spruce underline underline-offset-4 before:absolute before:inset-0 before:content-[''] hover:text-spruce-deep"
                >
                  {card.title} — czytaj dalej
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {
    latest.length > 0 && (
      <section class="mx-auto mt-section max-w-6xl px-4 sm:px-6" aria-labelledby="aktualnosci">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 id="aktualnosci" class="text-2xl md:text-3xl">
            Aktualności
          </h2>
          <a
            href="/aktualnosci/"
            class="font-semibold text-spruce underline underline-offset-4 hover:text-spruce-deep"
          >
            Wszystkie aktualności
          </a>
        </div>
        <ul
          class:list={[
            "mt-6 grid gap-6",
            newsAsList ? "max-w-[46rem]" : "sm:grid-cols-2 lg:grid-cols-3",
          ]}
          role="list"
        >
          {latest.map((post) => (
            <li class="relative rounded-xl border border-line bg-white p-5 transition-colors duration-150 hover:border-spruce/40 hover:shadow-[0_1px_2px_rgba(38,49,43,0.08)] focus-within:border-spruce/40">
              <p class="text-sm text-muted">
                <time datetime={post.data.date.toISOString().slice(0, 10)}>
                  {dateFormat.format(post.data.date)}
                </time>
              </p>
              <h3 class:list={["mt-2", newsAsList ? "text-2xl" : "text-xl"]}>
                <a
                  href={`/aktualnosci/${post.id}/`}
                  data-card-link
                  class="text-spruce-deep underline underline-offset-4 before:absolute before:inset-0 before:content-[''] hover:text-spruce"
                >
                  {post.data.title}
                </a>
              </h3>
              {post.data.description && (
                <p class:list={["mt-2 text-muted", newsAsList && "text-lg"]}>
                  {post.data.description}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="pre-footer mt-section border-y border-line bg-moss/60" aria-labelledby="kontakt-skrot">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <h2 id="kontakt-skrot" class="text-2xl">Zapraszamy do kontaktu</h2>
        <address class="mt-3 not-italic text-muted">
          ul. Wielbarska 2, 12-100 Szczytno<br />
          tel. <a href="tel:+48896242288" class="text-spruce underline underline-offset-4 hover:text-spruce-deep"
            >(89) 624-22-88</a
          ><br />
          <a
            href="mailto:sekretariat@dpsszczytno.pl"
            class="text-spruce underline underline-offset-4 hover:text-spruce-deep"
            >sekretariat@dpsszczytno.pl</a
          >
        </address>
      </div>
      <p>
        <a
          href="/kontakt/"
          class="inline-block rounded-lg bg-spruce px-5 py-3 font-semibold text-white hover:bg-spruce-deep active:bg-spruce-deep"
          >Pełne dane kontaktowe</a
        >
      </p>
    </div>
  </section>
</Base>
