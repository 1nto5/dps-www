---
import Base from "../layouts/Base.astro";
import ZoomImage from "../components/ZoomImage.astro";
import PageHeader from "../components/PageHeader.astro";
import PageShell from "../components/PageShell.astro";
import SectionNav from "../components/SectionNav.astro";
import ArchImage from "../components/ArchImage.astro";
import FramedImage from "../components/FramedImage.astro";
import Gallery from "../components/Gallery.astro";
import DocList from "../components/DocList.astro";
import { dokumentyUstrojowe } from "../data/dokumenty-ustrojowe";

import buildingGarden from "../assets/media/1377-1-1.jpg";
import buildingMonument from "../assets/media/1375-2-1.jpg";
import roomSingle from "../assets/media/1186-2012-07-25-at-10-43-511.jpg";
import roomShared from "../assets/media/1185-2012-07-25-at-10-40-40.jpg";
import commonRoom from "../assets/media/1188-2012-07-25-at-10-18-46-1-1.jpg";
import diningRoom from "../assets/media/1187-2012-07-25-at-10-46-26.jpg";
import treatmentRoom from "../assets/media/1182-2012-07-25-at-10-20-35.jpg";
import choirOnStage from "../assets/media/1168-christopherGroup.jpg";
import choirInPress from "../assets/media/1169-christopher680.jpg";

/** Rail table of contents. Labels are shorter than the headings they point at. */
const sections = [
  { id: "nasz-dom", label: "Nasz dom" },
  { id: "dla-kogo", label: "Dla kogo" },
  { id: "mieszkania", label: "Mieszkania i budynki" },
  { id: "grupa-muzyczna", label: "Grupa muzyczna" },
  { id: "kierownictwo", label: "Kierownictwo" },
  { id: "podstawa-prawna", label: "Podstawa prawna" },
  { id: "dokumenty", label: "Dokumenty" },
];

const management = [
  { role: "Dyrektor", name: "mgr Dorota Sędzińska-Bruździak" },
  { role: "Główna księgowa", name: "Beata Brzózy" },
  { role: "Kierownik Działu Administracyjno-Usługowego", name: "Dorota Kocot" },
  { role: "Kierownik Mieszkania I", name: "Barbara Suprynowicz" },
  { role: "Kierownik Mieszkania II", name: "Dariusz Jasiński" },
  { role: "Kierownik Mieszkania III", name: "Marta Deptuła" },
];

const legalBasis = [
  "Ustawy o finansach publicznych (t.j. Dz. U. z 2019 r., poz. 869)",
  "Ustawy o samorządzie powiatowym (t.j. Dz. U. z 2019 r., poz. 511)",
  "Ustawy o pracownikach samorządowych (t.j. Dz. U. z 2019 r., poz. 1282)",
  "Ustawy o pomocy społecznej (t.j. Dz. U. z 2018 r., poz. 1508)",
  "Rozporządzenia w sprawie domów pomocy społecznej (t.j. Dz. U. z 2018 r., poz. 734)",
  "Decyzji nr PS.II.UR.3013-19.06 Wojewody Warmińsko-Mazurskiego z 13 lutego 2007 r. w sprawie zezwolenia na prowadzenie domu pomocy społecznej dla osób przewlekle psychicznie chorych",
];

const interiors = [
  {
    src: roomSingle,
    alt: "Mieszkaniec siedzi na tapczanie w swoim pokoju jednoosobowym; przy oknie telewizor i stolik.",
  },
  { src: roomShared, alt: "Dwie Mieszkanki siedzą w fotelach przy stoliku w swoim pokoju." },
  {
    src: commonRoom,
    alt: "Mieszkańcy i terapeutka przy wspólnym stole w świetlicy, w tle regały z książkami.",
  },
  { src: diningRoom, alt: "Jasna jadalnia z drewnianymi krzesłami i stołami nakrytymi obrusami" },
  {
    src: treatmentRoom,
    alt: "Gabinet zabiegowy: pielęgniarka przy biurku, przeszklone szafy z lekami.",
  },
];
---

<Base
  title="O nas"
  description="Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — dom dla osób przewlekle psychicznie chorych. Kim jesteśmy, jak mieszkamy, kto nami kieruje i na jakiej podstawie działamy."
>
  <PageHeader
    eyebrow="Nasz dom"
    title="O nas"
    lead="Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie jest domem dla osób przewlekle psychicznie chorych. Razem z filią w Spychowie zapewniamy Mieszkańcom całodobową opiekę."
  />

  <PageShell>
    <SectionNav slot="rail" items={sections} />

    <section aria-labelledby="nasz-dom">
      <div class="doc flow-root">
        <h2 id="nasz-dom">Nasz dom</h2>
        <div class="mb-6 w-full max-w-xs md:mb-4 md:w-64 md:float-right md:ml-8">
          <ArchImage
            src={buildingGarden}
            alt="Budynek Domu Pomocy Społecznej w Szczytnie z czerwonym dachem, widziany od strony ogrodu z kwitnącymi hortensjami"
            aspect="4/5"
            position="55% 50%"
            sizes="(min-width: 768px) 16rem, 100vw"
            loading="eager"
          />
        </div>
        <p>
          Jesteśmy jednostką organizacyjną Powiatu Szczycieńskiego. Nasz Dom stoi przy ulicy
          Wielbarskiej w Szczytnie, w otoczeniu ogrodu, a od 2001 roku prowadzimy także filię
          w Spychowie.
        </p>
        <p>
          Troszczymy się o dobre samopoczucie naszych Mieszkańców, nie zapominając
          o indywidualności każdego z nich. Wszechstronna opieka terapeutyczna i medyczna oraz
          zaangażowanie pracowników zapewniają godne warunki życia, ze szczególnym poszanowaniem
          prawa do wolności, intymności i poczucia bezpieczeństwa.
        </p>
        <p>
          Podejmujemy działania zmierzające do integracji osób chorujących psychicznie ze
          środowiskiem lokalnym. Nasi Mieszkańcy bywają gośćmi kawiarni, korzystają z plaży
          miejskiej i należą do Klubu Miłośników Kina. Współpracujemy również z uczniami
          okolicznych szkół.
        </p>
      </div>
    </section>

    <section class="band mt-section" aria-labelledby="dla-kogo">
      <div class="doc">
        <h2 id="dla-kogo">Dla kogo jest nasz dom</h2>
        <p>
          Nasz Dom przeznaczony jest dla osób przewlekle psychicznie chorych. Zapewniamy opiekę
          całodobową w Szczytnie i w filii w Spychowie.
        </p>
        <p>
          Mieszkańcy objęci są opieką lekarza psychiatry oraz korzystają z usług psychologa
          i rehabilitanta zatrudnionych w Domu. Zapewniamy wsparcie wykwalifikowanych
          terapeutów, którzy dbają o to, aby Mieszkańcy aktywnie spędzali czas i rozwijali swoje
          zainteresowania.
        </p>
        <p>
          Szczegółowy zakres usług opiekuńczych, pielęgnacyjnych i wspomagających opisujemy na
          stronie <a href="/oferta/">Oferta</a>. O życiu codziennym w Spychowie piszemy na stronie
          <a href="/filia-w-spychowie/">Filia w Spychowie</a>.
        </p>
      </div>
    </section>

    <section class="mt-section" aria-labelledby="mieszkania">
      <div class="doc">
        <h2 id="mieszkania">Mieszkania i budynki</h2>
        <p>
          Dom w Szczytnie podzielony jest na trzy mieszkania — Mieszkanie I, II i III — z których
          każde ma własnego kierownika i zespół opiekunów. Dysponujemy pokojami jedno-, dwu-
          i trzyosobowymi oraz pokojami czteroosobowymi dla osób leżących.
        </p>
        <p>
          Poza pokojami Mieszkańcy korzystają ze wspólnych przestrzeni: świetlic, biblioteki,
          jadalni, kaplicy, pracowni terapeutycznych i gabinetów zabiegowych. Wokół budynków
          rozciąga się ogród z alejkami i ławkami, a przy Domu stoi pomnik patrona — świętego
          Jana Pawła II.
        </p>
      </div>
      <div class="mt-block">
        <Gallery
          photos={interiors}
          sizes="(min-width: 1024px) 15rem, (min-width: 640px) 33vw, 50vw"
        />
      </div>
    </section>

    <section class="band mt-section" aria-labelledby="grupa-muzyczna">
      <div class="doc flow-root">
        <h2 id="grupa-muzyczna">Grupa muzyczna</h2>
        {
          /* Landscape: the five singers span the full width of the source, so
           no portrait crop can hold them. FramedImage, not the arch. */
        }
        <div class="mb-6 w-full max-w-xs md:mb-4 md:w-64 md:float-left md:mr-8">
          <FramedImage
              src={choirOnStage}
              alt="Pięciu członków grupy wokalnej „Christopher” śpiewa na plenerowej scenie pod żółtym namiotem."
              sizes="(min-width: 768px) 16rem, 100vw"
            />
        </div>
        <p>
          Grupa wokalna „Christopher” działa w naszym Domu od 2005 roku. Powstała w ramach zajęć
          pracowni muzykoterapii, a jej celem jest budowanie wiary w siebie i we własne
          możliwości, rozwijanie zainteresowań muzycznych oraz integracja osób
          z niepełnosprawnościami ze środowiskiem lokalnym.
        </p>
        <p>
          Zespół propaguje piosenki Krzysztofa Klenczona i „Czerwonych Gitar”, a w jego
          repertuarze są także piosenki biesiadne. Grupa wystąpiła na wielu festiwalach, majówkach
          i festynach rodzinnych w regionie.
        </p>
        <p>
          <a href="/grupa-muzyczna/">Więcej o grupie wokalnej „Christopher”</a>
        </p>
      </div>
      <figure class="mt-block max-w-md">
        <ZoomImage
          src={choirInPress}
          alt="Skan wycinka prasowego „Muzyka z naszych stron” ze zdjęciem członków zespołu „Christopher”. Treść artykułu jest przytoczona na stronie grupy wokalnej."
          caption="Zespół „Christopher” w lokalnej prasie"
          widths={[504, 680]}
          sizes="(min-width: 640px) 28rem, 100vw"
        />
        <figcaption class="mt-2 text-meta text-muted">
          Zespół „Christopher” w lokalnej prasie. Treść artykułu przytaczamy na stronie
          <a href="/grupa-muzyczna/#media" class="text-spruce underline hover:text-spruce-deep"
            >grupy wokalnej „Christopher”</a
          >.
        </figcaption>
      </figure>
    </section>

    <section class="mt-section" aria-labelledby="kierownictwo">
      <div class="doc">
        <h2 id="kierownictwo">Kierownictwo Domu</h2>
        <dl class="mt-4 divide-y divide-line rounded-lg border border-line bg-white">
          {
            management.map((person) => (
              <div class="grid gap-1 px-4 py-3 sm:grid-cols-2 sm:gap-6">
                <dt class="text-muted">{person.role}</dt>
                <dd class="font-medium">{person.name}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="band mt-section" aria-labelledby="podstawa-prawna">
      <div class="doc flow-root">
        <h2 id="podstawa-prawna">Podstawa prawna działania</h2>
        <div class="mb-6 w-full max-w-xs md:mb-4 md:w-64 md:float-right md:ml-8">
          <ArchImage
            src={buildingMonument}
            alt="Pomnik świętego Jana Pawła II w ogrodzie przed głównym budynkiem Domu, obok ławki i strzyżone żywopłoty"
            aspect="4/5"
            sizes="(min-width: 768px) 16rem, 100vw"
          />
        </div>
        <p>Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie funkcjonuje na podstawie:</p>
        <ol>
          {legalBasis.map((item) => <li>{item}</li>)}
        </ol>
      </div>
    </section>

    <section class="mt-section" aria-labelledby="dokumenty">
      <div class="doc">
        <h2 id="dokumenty">Dokumenty</h2>
        <p>Podstawowe dokumenty ustrojowe Domu do pobrania:</p>
      </div>
      <div class="mt-block max-w-column">
        <DocList docs={dokumentyUstrojowe} />
      </div>
    </section>
  </PageShell>
</Base>
