---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageShell from "../components/PageShell.astro";
import MapPin from "../components/icons/MapPin.astro";

/** Phone numbers of the residential units and the catering section. */
const units = [
  {
    name: "Sekcja Żywienia",
    phones: [{ label: "(89) 624-64-44", href: "tel:+48896246444" }],
  },
  {
    name: "Dom Mieszkalny I",
    phones: [
      { label: "(89) 624-64-55", href: "tel:+48896246455" },
      { label: "728 457 616", href: "tel:+48728457616" },
    ],
  },
  {
    name: "Dom Mieszkalny II",
    phones: [
      { label: "(89) 624-64-97", href: "tel:+48896246497" },
      { label: "600 835 191", href: "tel:+48600835191" },
    ],
  },
  {
    name: "Dom Mieszkalny III",
    phones: [
      { label: "(89) 624-22-92", href: "tel:+48896242292" },
      { label: "600 835 576", href: "tel:+48600835576" },
    ],
  },
];

// `inline-block py-1`: at this text size a bare inline box is 22px tall, under
// the 24px minimum target of WCAG 2.2 SC 2.5.8, and these are phone numbers
// and e-mail addresses — the primary actions of the page.
const linkClass = "inline-block py-1 text-spruce underline underline-offset-4 hover:text-spruce-deep";
const cardClass = "rounded-xl border border-line bg-white p-6";
const termClass = "text-sm font-medium text-muted";
const mapLinkClass =
  "inline-flex items-center gap-1.5 rounded-full border border-edge px-3 py-1 text-sm text-spruce hover:border-spruce hover:text-spruce-deep";
---

<Base
  title="Kontakt"
  description="Adresy, telefony i adresy e-mail Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie oraz filii w Spychowie."
>
  <PageHeader
    eyebrow="Kontakt"
    title="Jak się z nami skontaktować i gdzie nas znaleźć?"
  />

  <PageShell>
    <div class="grid gap-6 md:grid-cols-2">
      <section aria-labelledby="siedziba" class={cardClass}>
        <h2 id="siedziba" class="text-2xl">Szczytno</h2>
        <address class="mt-6 not-italic">
          Dom Pomocy Społecznej im. Jana Pawła II<br />
          ul. Wielbarska 2<br />
          12-100 Szczytno
        </address>
        <p class="mt-4">
          <a class={mapLinkClass} href="https://www.google.com/maps/search/?api=1&query=Wielbarska+2%2C+12-100+Szczytno" rel="noopener" aria-label="Wielbarska 2 w Szczytnie w Google Maps">
            <MapPin />
            Google Maps
          </a>
        </p>
      </section>

      <section aria-labelledby="filia" class={cardClass}>
        <h2 id="filia" class="text-2xl">Filia w Spychowie</h2>
        <address class="mt-6 not-italic">
          Dom Pomocy Społecznej im. Jana Pawła II — Filia w Spychowie<br />
          ul. Sienkiewicza 3<br />
          12-150 Spychowo
        </address>
        <p class="mt-4">
          <span class={termClass}>Telefon:</span>{" "}
          <a class={linkClass} href="tel:+48896225030">(89) 622-50-30</a>
        </p>
        <p class="mt-4">
          <a class={mapLinkClass} href="https://www.google.com/maps/search/?api=1&query=Sienkiewicza+3%2C+12-150+Spychowo" rel="noopener" aria-label="Sienkiewicza 3 w Spychowie w Google Maps">
            <MapPin />
            Google Maps
          </a>
        </p>
      </section>

      <section aria-labelledby="domy-mieszkalne" class:list={[cardClass, "md:col-span-2"]}>
        <h2 id="domy-mieszkalne" class="text-2xl">Telefony</h2>

        {/* The secretariat leads the list and is set apart as the front desk.
            The tint used to be `paper` on a white card — 1.02:1, a difference
            nobody could see — so it is moss with a hairline of its own. */}
        <div class="mt-6 rounded-lg border border-line bg-moss p-5">
          <h3 class="text-lg">Sekretariat</h3>
          {/* `min-w-0` on each cell: a grid item's default minimum is the width
              of its own content, so the unbreakable e-mail address would push
              the whole row wider than the card at 320px. */}
          <dl class="mt-3 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
            <div class="min-w-0">
              <dt class={termClass}>Telefon</dt>
              <dd><a class={linkClass} href="tel:+48896242288">(89) 624-22-88</a></dd>
            </div>
            <div class="min-w-0">
              <dt class={termClass}>Faks</dt>
              <dd>(89) 624-34-99</dd>
            </div>
            <div class="min-w-0">
              <dt class={termClass}>E-mail</dt>
              <dd>
                <a class:list={[linkClass, "break-words"]} href="mailto:sekretariat@dpsszczytno.pl"
                  >sekretariat@dpsszczytno.pl</a
                >
              </dd>
            </div>
            <div class="min-w-0">
              <dt class={termClass}>Skrytka ePUAP</dt>
              <dd>/dpsszczytno/SkrytkaESP</dd>
            </div>
          </dl>
        </div>

        <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {
            units.map((unit) => (
              <li>
                <h3 class="text-lg">{unit.name}</h3>
                <ul role="list" class="mt-3 space-y-1">
                  {unit.phones.map((phone) => (
                    <li>
                      <a class={linkClass} href={phone.href}>
                        {phone.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="iod" class={cardClass}>
        <h2 id="iod" class="text-2xl">Inspektor Ochrony Danych</h2>
        <p class="mt-6">
          W sprawach dotyczących ochrony danych osobowych prosimy o kontakt z Inspektorem Ochrony
          Danych:
        </p>
        <p class="mt-3">
          <a class={linkClass} href="mailto:iod2@warmiainkaso.pl">iod2@warmiainkaso.pl</a>
        </p>
      </section>

      <section aria-labelledby="dane-do-faktur" class={cardClass}>
        <h2 id="dane-do-faktur" class="text-2xl">Dane do faktur</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <div>
            <h3 class="text-lg">Nabywca</h3>
            <address class="mt-3 not-italic">
              Powiat Szczycieński<br />
              ul. Sienkiewicza 1<br />
              12-100 Szczytno
            </address>
            <p class="mt-3"><span class={termClass}>NIP:</span> 745-18-11-678</p>
          </div>
          <div>
            <h3 class="text-lg">Odbiorca</h3>
            <address class="mt-3 not-italic">
              Dom Pomocy Społecznej im. Jana Pawła II<br />
              ul. Wielbarska 2<br />
              12-100 Szczytno
            </address>
            <p class="mt-3"><span class={termClass}>REGON:</span> 000963690</p>
          </div>
        </div>
      </section>
    </div>
  </PageShell>
</Base>
