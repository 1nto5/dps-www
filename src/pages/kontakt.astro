---
/**
 * Every way of reaching the Dom, in one place: the sekretariat, the direct
 * numbers of the residential units, the branch, how to get here, and the
 * official channels. No map and no iframe — the way here is described in
 * words, and the numbers come from data/contact.ts.
 */
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageShell from "../components/PageShell.astro";
import Toc from "../components/Toc.astro";
import Button from "../components/Button.astro";
import { contact, addressLines } from "../data/contact";

const toc = [
  { id: "sekretariat", label: "Sekretariat" },
  { id: "telefony", label: "Telefony" },
  { id: "spychowo", label: "Filia w Spychowie" },
  { id: "dojazd", label: "Dojazd" },
  { id: "epuap", label: "Sprawy urzędowe" },
];
---

<Base
  title="Kontakt"
  description="Adresy, telefony i adresy e-mail Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie oraz filii w Spychowie."
>
  <PageHeader breadcrumbs title="Jak się z nami skontaktować i gdzie nas znaleźć?">
    <p class="mt-8">
      <Button href={contact.phone.href} phone>{contact.phone.label}</Button>
    </p>
  </PageHeader>

  <PageShell>
    <Toc slot="rail" items={toc} />

    <div class="doc">
      <h2 id="sekretariat">Sekretariat</h2>
      <address>
        {contact.nameShort}<br />
        {addressLines(contact.address)[0]}<br />
        {addressLines(contact.address)[1]}
      </address>
      <dl>
        <dt>Telefon</dt>
        <dd><a href={contact.phone.href}>{contact.phone.label}</a></dd>
        <dt>Faks</dt>
        <dd>{contact.fax}</dd>
        <dt>E-mail</dt>
        <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        <dt>Skrytka ePUAP</dt>
        <dd>{contact.epuap}</dd>
      </dl>

      <h2 id="telefony">Telefony</h2>
      {
        contact.units.map((unit) => (
          <>
            <h3>{unit.name}</h3>
            <ul>
              {unit.phones.map((phone) => (
                <li>
                  <a href={phone.href}>{phone.label}</a>
                </li>
              ))}
            </ul>
          </>
        ))
      }

      <h2 id="spychowo">Filia w Spychowie</h2>
      <address>
        {contact.spychowo.name}<br />
        {addressLines(contact.spychowo.address)[0]}<br />
        {addressLines(contact.spychowo.address)[1]}
      </address>
      <dl>
        <dt>Telefon</dt>
        <dd>
          <a href={contact.spychowo.phone.href}>{contact.spychowo.phone.label}</a>
        </dd>
      </dl>

      <h2 id="dojazd">Dojazd</h2>
      <p>
        Wejście do budynku od ul. Sobieszczańskiego jest wyposażone w podjazd, który prowadzi do
        windy przystosowanej dla osób z niepełnosprawnością.
      </p>
      <p>
        Na terenie Domu można parkować pojazdy. Nie ma wyznaczonych i oznakowanych miejsc
        parkingowych dla osób z niepełnosprawnością.
      </p>
      <p>Osoba z psem asystującym ma prawo wstępu do budynku.</p>

      <h2 id="epuap">Sprawy urzędowe</h2>
      <p>
        Pismo urzędowe można wysłać elektronicznie przez usługę <a
          href="https://www.gov.pl/web/gov/wyslij-pismo-ogolne">Wyślij pismo ogólne</a
        > na portalu gov.pl — jako adresata wskazuje się wtedy naszą skrytkę ePUAP
        <span class="whitespace-nowrap">{contact.epuap}</span>. W zwykłych sprawach nie trzeba
        jednak niczego podpisywać elektronicznie: wystarczy e-mail albo telefon.
      </p>

      <h3>Inspektor Ochrony Danych</h3>
      <p>
        W sprawach dotyczących ochrony danych osobowych prosimy o kontakt z Inspektorem Ochrony
        Danych: <a href="mailto:iod2@warmiainkaso.pl">iod2@warmiainkaso.pl</a>.
      </p>

      <h3>Dane do faktur</h3>
      <dl>
        <dt>Nabywca</dt>
        <dd>
          Powiat Szczycieński, ul. Sienkiewicza 1, 12-100 Szczytno<br />
          NIP 745-18-11-678
        </dd>
        <dt>Odbiorca</dt>
        <dd>
          {contact.nameShort}, {addressLines(contact.address).join(", ")}<br />
          REGON 000963690
        </dd>
      </dl>
    </div>
  </PageShell>
</Base>
