const photos = [
  { src: p140, alt: "Dziedziniec Domu Pomocy Społecznej przed rozpoczęciem prac — parking i budynek gospodarczy." },
  { src: p145, alt: "Rozpoczęte prace ziemne pod konstrukcję kolektorów słonecznych na dziedzińcu." },
  { src: p146, alt: "Wykop pod instalację poprowadzoną w kierunku budynku mieszkalnego." },
  { src: p153, alt: "Wykopy i hałdy ziemi na terenie parkingu w trakcie prac przygotowawczych." },
  { src: p155, alt: "Montaż pierwszych słupów nośnych konstrukcji pod kolektory słoneczne." },
  { src: p157, alt: "Pracownicy spawają stalową ramę konstrukcji wsporczej kolektorów." },
  { src: p160, alt: "Gotowa stalowa rama konstrukcji z pierwszymi zamontowanymi profilami kolektorów." },
  { src: p163, alt: "Kolejne rzędy paneli kolektorów słonecznych układane na konstrukcji." },
  { src: p166, alt: "Montaż kolektorów słonecznych w słoneczny dzień, widok od strony alejki." },
  { src: p167, alt: "Zamontowana instalacja kolektorów słonecznych na tle czerwonych dachów budynków Domu." },
  { src: p173, alt: "Konstrukcja z kolektorami słonecznymi widziana od dołu, z tablicą informacyjną projektu." },
  { src: p174, alt: "Kotłownia — zasobniki ciepłej wody i izolowane rurociągi instalacji solarnej." },
  { src: p295, alt: "Pracownicy montują panele kolektorów na konstrukcji nad parkingiem." },
  { src: p296, alt: "Widok z góry na ukończoną instalację kolektorów słonecznych przy budynkach Domu." },
  { src: p380, alt: "Kotłownia gazowa Domu Pomocy Społecznej po modernizacji instalacji." },
  { src: p1680, alt: "Węzeł cieplny z izolowanymi rurociągami i automatyką sterującą instalacją solarną." },
  { src: p298, alt: "Rozdzielacze i naczynia wzbiorcze instalacji ciepłej wody w pomieszczeniu technicznym." },
];
---

<Base
  title="Projekt „Wykorzystanie OZE w Domu Pomocy Społecznej w Szczytnie”"
  description="Projekt „Wykorzystanie OZE w Domu Pomocy Społecznej w Szczytnie” — instalacja kolektorów słonecznych współfinansowana ze środków Europejskiego Funduszu Rozwoju Regionalnego w ramach RPO Warmia i Mazury na lata 2007-2013."
>
  <PageHeader
    eyebrow="Projekty unijne"
    eyebrowHref="/dokumenty/projekty-unijne/"
    title="Projekt „Wykorzystanie OZE w Domu Pomocy Społecznej w Szczytnie”"
    lead="Instalacja kolektorów słonecznych współfinansowana ze środków Europejskiego Funduszu Rozwoju Regionalnego."
  />

  <PageShell narrow>
    <SiblingNav
      slot="rail"
      title="Projekty unijne"
      items={projektyUnijnePages}
      current="/dokumenty/projekty-unijne/oze/"
    />

    <div class="max-w-3xl">
      <Image
        src={boardProject}
        alt="Tablica informacyjna projektu: „Warmia i Mazury regionem zjednoczonej Europy”. Projekt współfinansowany ze środków Europejskiego Funduszu Rozwoju Regionalnego w ramach Regionalnego Programu Operacyjnego Warmia i Mazury na lata 2007-2013. Tytuł projektu: „Wykorzystanie OZE w Domu Pomocy Społecznej w Szczytnie”. Całkowita wartość projektu 347 357,96 PLN, kwota dofinansowania 276 902,36 PLN, beneficjent — Powiat Szczycieński, ul. Sienkiewicza 1, 12-100 Szczytno."
        widths={[400, 680]}
        sizes="(min-width: 768px) 680px, 100vw"
        class="h-auto w-full rounded-lg border border-line"
        loading="eager"
      />
    </div>

    <div class="doc mt-8">
      <h2>Cel projektu</h2>
      <p>
        Celem bezpośrednim realizacji przedsięwzięcia jest redukcja emisji zanieczyszczeń (ochrona
        powietrza atmosferycznego) oraz zmniejszenie kosztów eksploatacyjnych w zakresie produkcji
        energii.
      </p>
      <p>
        Celem ogólnym projektu jest ochrona środowiska przed zanieczyszczeniami poprzez zastosowanie
        odnawialnych źródeł energii, co prowadzi do wzrostu konkurencyjności gospodarki województwa
        warmińsko-mazurskiego, jako opartej w dużej mierze na zasobach przyrodniczych, czystości
        środowiska i potencjale turystycznym.
      </p>
    </div>

    <Image
      src={logoRpo}
      alt="Logotypy: Program Regionalny — Narodowa Strategia Spójności, herb powiatu szczycieńskiego, herb województwa warmińsko-mazurskiego, Unia Europejska — Europejski Fundusz Rozwoju Regionalnego."
      widths={[680]}
      sizes="(min-width: 768px) 680px, 100vw"
      class="my-8 h-auto w-full max-w-[680px]"
      loading="lazy"
    />

    <div class="doc">
      <h2>Podpisanie umowy o dofinansowanie</h2>
      <p>
        W dniu 13.05.2014 r. Starosta Szczycieński Jarosław Matłach wraz z Wicestarostą Sylwią
        Jaskulską podpisali umowę z Adamem Krzyśkowem, prezesem WFOŚiGW w Olsztynie, na realizację
        projektu montażu „solarów” w szczycieńskim DPS. Na przedsięwzięcie pn. „Wykorzystanie OZE w
        Domu Pomocy Społecznej w Szczytnie” Powiat szczycieński pozyskał ponad 300 000,00 zł ze
        środków Regionalnego Programu Operacyjnego Warmia i Mazury 2007-2013 z poddziałania
        wykorzystywania odnawialnych źródeł energii. Wykonanie montażu „solarów”, dzięki któremu DPS w
        Szczytnie znacznie zmniejszy koszty zużywania prądu, rozpocznie się w sierpniu bieżącego roku.
      </p>
    </div>

    <div class="mt-6 max-w-2xl">
      <Image
        src={photoUmowa}
        alt="Podpisanie umowy o dofinansowanie — uścisk dłoni prezesa WFOŚiGW w Olsztynie i Starosty Szczycieńskiego, obok Wicestarosta, w tle flagi Polski i Unii Europejskiej."
        widths={[400, 680]}
        sizes="(min-width: 768px) 680px, 100vw"
        class="h-auto w-full rounded-lg"
        loading="lazy"
      />
    </div>

    <div class="doc mt-10">
      <h2>Informacja o projekcie</h2>
      <p>
        W dniu 02.09.2014 r. w siedzibie Domu Pomocy Społecznej im. Jana Pawła II Dyrektor DPS p.
        Dorota Sędzińska-Bruździak podpisała umowę z Wykonawcą dotyczącą projektu pn.: „Wykorzystanie
        OZE (kolektory słoneczne) w Domu Pomocy Społecznej w Szczytnie”. Przedmiotem umowy było
        wykonanie całkowitego zakresu robót określonych w Specyfikacji Istotnych Warunków Zamówienia.
        Termin wykonania inwestycji przewidziano do 30.09.2014 r.
      </p>

      <h2>Zdjęcia z realizacji inwestycji</h2>
    </div>

    <div class="mt-4">
      <Gallery photos={photos} />
    </div>

    <p class="mt-section">
      <a
        href="/dokumenty/projekty-unijne/"
        class="text-spruce underline underline-offset-4 hover:text-spruce-deep"
        >Wróć do Projektów unijnych</a
      >
    </p>
  </PageShell>
</Base>
