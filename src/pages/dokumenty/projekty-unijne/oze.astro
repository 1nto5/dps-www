 */
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Gallery from "../../../components/Gallery.astro";
import PageShell from "../../../components/PageShell.astro";
import SiblingNav from "../../../components/SiblingNav.astro";
import { projektyUnijnePages } from "../../../data/projekty-unijne-pages";

import boardProject from "../../../assets/media/1344-680-00186.jpg";
