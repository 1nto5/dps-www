---
/**
 * Public procurement. The old page (1217) had no content of its own — every
 * proceeding is published in the BIP, so this page is a signpost to it.
 */
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";
import PageList from "../../components/PageList.astro";
import Button from "../../components/Button.astro";
import { contact } from "../../data/contact";
import { dokumentySections } from "../../data/dokumenty-sections";

/** The rail is a bare list of the section's pages — the blurbs would not fit. */
const rail = dokumentySections.map(({ href, label }) => ({ href, label }));
---

<Base
  title="Zamówienia publiczne"
  description="Postępowania o udzielenie zamówienia publicznego prowadzone przez Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie publikowane są w Biuletynie Informacji Publicznej."
>
  <PageHeader
    breadcrumbs
    title="Zamówienia publiczne"
    lead="Wszystkie postępowania o udzielenie zamówienia publicznego prowadzone przez nasz Dom publikujemy w Biuletynie Informacji Publicznej."
  />

  <PageShell>
    <PageList slot="rail" items={rail} current="/dokumenty/zamowienia-publiczne/" />

    <div class="doc mt-subsection">
      <p>
        W Biuletynie Informacji Publicznej znajdą Państwo ogłoszenia o postępowaniach, dokumentację
        zamówień, odpowiedzi na pytania wykonawców, informacje o wyborze najkorzystniejszej oferty
        oraz plany postępowań. Biuletyn jest urzędowym miejscem publikacji tych informacji.
      </p>
    </div>

    <p class="mt-block">
      <Button href={contact.bip}>Zamówienia publiczne w Biuletynie Informacji Publicznej</Button>
    </p>
    <p class="mt-block text-ink-soft">Adres Biuletynu: dpsszczytno.bip.gov.pl</p>

    <div class="doc mt-section">
      <h2>Pytania w sprawie zamówień</h2>
      <p>
        W sprawach dotyczących prowadzonych postępowań prosimy o kontakt z sekretariatem: telefon
        <a href={contact.phone.href}>{contact.phone.label}</a>, e-mail
        <a href={`mailto:${contact.email}`}>{contact.email}</a>.
      </p>
    </div>
  </PageShell>
</Base>
