---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";
import { dokumentySections } from "../../data/dokumenty-sections";

/** Document hub: entry points to every public-disclosure section. No rail —
    this page *is* the sibling list every page below it carries. */
const sections = dokumentySections;
---

<Base
  title="Dokumenty"
  description="Dokumenty i informacje publiczne Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie: dotacje, projekty unijne, zamówienia publiczne, sygnalista, RODO, deklaracja dostępności."
>
  <PageHeader
    eyebrow="Informacje publiczne"
    title="Dokumenty"
  />

  <PageShell>
    <ul class="grid gap-4 sm:grid-cols-2" role="list">
      {
        sections.map((s) => (
          <li>
            <a
              href={s.href}
              class="flex h-full flex-col gap-2 rounded-xl border border-line bg-white p-5 no-underline hover:bg-moss hover:shadow-[0_1px_2px_rgba(38,49,43,0.08)]"
            >
              <span class="font-display text-xl font-semibold text-spruce-deep underline underline-offset-4">
                {s.label}
              </span>
              <span class="text-muted">{s.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </PageShell>
</Base>
