---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";

/** Document hub: entry points to every public-disclosure section. */
const sections = [
  {
    href: "/dokumenty/dotacje/",
    title: "Dotacje",
    text: "Dotacje i dofinansowania otrzymane przez Dom, zestawione rok po roku.",
  },
  {
    href: "/dokumenty/projekty-unijne/",
    title: "Projekty unijne",
    text: "Zadania realizowane przy wsparciu funduszy Unii Europejskiej.",
  },
  {
    href: "/dokumenty/zamowienia-publiczne/",
    title: "Zamówienia publiczne",
    text: "Ogłoszenia o postępowaniach, dokumentacja i informacje o wynikach.",
  },
  {
    href: "/dokumenty/sygnalista/",
    title: "Sygnalista",
    text: "Procedura zgłaszania naruszeń prawa i zasady ochrony osób zgłaszających.",
  },
  {
    href: "/dokumenty/rodo/",
    title: "RODO",
    text: "Klauzula informacyjna o przetwarzaniu danych osobowych w naszym Domu.",
  },
  {
    href: "/deklaracja-dostepnosci/",
    title: "Deklaracja dostępności",
    text: "Informacja o dostępności strony i budynków oraz o zgłaszaniu utrudnień.",
  },
];
---

<Base
  title="Dokumenty"
  description="Dokumenty i informacje publiczne Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie: dotacje, projekty unijne, zamówienia publiczne, sygnalista, RODO, deklaracja dostępności."
>
  <PageHeader
    eyebrow="Informacje publiczne"
    title="Dokumenty"
    lead="Informacje publiczne o działaniu naszego Domu: skąd pochodzą środki, jak prowadzimy postępowania i jak chronimy dane oraz osoby zgłaszające nieprawidłowości."
  />

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <ul class="grid gap-4 sm:grid-cols-2" role="list">
      {
        sections.map((s) => (
          <li>
            <a
              href={s.href}
              class="flex h-full flex-col gap-2 rounded-xl border border-line bg-white/60 p-5 no-underline hover:bg-moss"
            >
              <span class="font-display text-xl font-semibold text-spruce-deep underline underline-offset-4">
                {s.title}
              </span>
              <span class="text-muted">{s.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
