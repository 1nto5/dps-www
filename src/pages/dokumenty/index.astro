---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageShell from "../../components/PageShell.astro";
import LinkCard from "../../components/LinkCard.astro";
import { dokumentySections } from "../../data/dokumenty-sections";

/** Document hub: entry points to every public-disclosure section. No rail —
    this page *is* the sibling list every page below it carries. */
const sections = dokumentySections;

/** Two documents of record that are not disclosure sections of their own: the
    signed accessibility statement, and the Dom's statutory documents, which
    live in a section of /o-nas/. */
const related = [
  { href: "/deklaracja-dostepnosci/", label: "Deklaracja dostępności" },
  { href: "/o-nas/#dokumenty", label: "Statut, regulamin i schemat organizacyjny" },
];

const linkClass = "inline-block py-1 text-spruce underline hover:text-spruce-deep";
---

<Base
  title="Dokumenty"
  description="Dokumenty i informacje publiczne Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie: dotacje, projekty unijne, zamówienia publiczne, sygnalista, RODO, deklaracja dostępności."
>
  <PageHeader
    eyebrow="Informacje publiczne"
    title="Dokumenty"
  />

  <PageShell>
    <ul class="grid gap-4 sm:grid-cols-2" role="list">
      {
        sections.map((s) => (
          <li>
            <LinkCard href={s.href} label={s.label} text={s.text} />
          </li>
        ))
      }
    </ul>

    <h2 class="mt-section text-2xl">Powiązane</h2>
    <ul role="list" class="mt-3">
      {
        related.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </PageShell>
</Base>
