---
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PageShell from "../../../components/PageShell.astro";
import SiblingNav from "../../../components/SiblingNav.astro";
import { dokumentySections } from "../../../data/dokumenty-sections";
import { dotacjeYears } from "../../../data/dotacje-years";

/** Year index for grant-funding disclosures. Newest year first. */
const years = dotacjeYears;
---

<Base
  title="Dotacje"
  description="Dotacje i dofinansowania otrzymane przez Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — informacje z lat 2016–2025."
>
  <PageHeader
    breadcrumbs
    eyebrow="Dokumenty"
    title="Dotacje"
    lead="Informujemy o środkach publicznych, które otrzymuje nasz Dom. Poniżej znajdą Państwo informacje o dotacjach z podziałem na lata."
  />

  <PageShell>
    <SiblingNav
      slot="rail"
      title="Dokumenty"
      items={dokumentySections}
      current="/dokumenty/dotacje/"
    />

    <ul class="grid gap-4 sm:grid-cols-2" role="list">
      {
        years.map((y) => (
          <li>
            <a
              href={y.href}
              class="flex h-full flex-col gap-2 rounded-xl border border-line bg-white p-5 no-underline hover:bg-moss hover:shadow-card"
            >
              <span class="font-display text-xl font-semibold text-spruce-deep underline underline-offset-4">
                {y.label}
              </span>
              <span class="text-muted">{y.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </PageShell>
</Base>
