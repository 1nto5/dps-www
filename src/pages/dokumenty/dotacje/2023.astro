---
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PageShell from "../../../components/PageShell.astro";
import SiblingNav from "../../../components/SiblingNav.astro";
import BackLink from "../../../components/BackLink.astro";
import { dotacjeYears } from "../../../data/dotacje-years";
import DocList from "../../../components/DocList.astro";
import emblem from "../../../assets/media/1423-Picture-1.png";

const docs = [
  {
    href: "/dokumenty/pliki/1410-dotacja-2023.pdf",
    label: "Informacja o dofinansowaniu z rezerwy celowej w 2023 roku",
    format: "PDF",
    size: "182 KB",
  },
];
---

<Base
  title="Dotacje 2023"
  description="Dotacje otrzymane w 2023 roku przez Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — środki z rezerwy celowej budżetu państwa na dodatki dla pracowników."
>
  <PageHeader
    breadcrumbs
    title="Dotacje 2023"
    lead="Środki publiczne otrzymane przez nasz Dom w 2023 roku."
  />

  <PageShell>
    <SiblingNav
      slot="rail"
      title="Dotacje"
      items={dotacjeYears}
      current="/dokumenty/dotacje/2023/"
    />

    <div class="doc">
      <Image
        src={emblem}
        alt="Flaga Rzeczypospolitej Polskiej i godło Polski — znaki informujące o dofinansowaniu ze środków budżetu państwa."
        widths={[480, 800]}
        sizes="(min-width: 768px) 22rem, 70vw"
        loading="lazy"
        class="mb-8 w-full max-w-[22rem]"
      />

      <h2>Dofinansowanie ze środków rezerwy celowej budżetu państwa</h2>
      <p>Środki pochodzą z rezerwy celowej w ustawie budżetowej na 2023 rok.</p>
      <p>
        <strong>Dom Pomocy Społecznej w Szczytnie w 2023 r.</strong> otrzymał z Warmińsko-Mazurskiego
        Urzędu Wojewódzkiego środki dotacji celowej pochodzącej z rezerwy celowej (cz. 83, poz. 49),
        w rozdziale 85202 § 2130 — Domy Pomocy Społecznej.
      </p>
      <p>
        <strong>Wartość dofinansowania: 914 029,00 zł</strong><br />
        (słownie: dziewięćset czternaście tysięcy dwadzieścia dziewięć złotych 00/100).
      </p>
      <p><strong>Środki z funduszu przeznaczono na wypłatę dodatków dla pracowników.</strong></p>

      <h2>Wcześniejsza transza z rezerwy celowej</h2>
      <p>
        <strong>Dom Pomocy Społecznej w Szczytnie w 2023 r.</strong> otrzymał z Warmińsko-Mazurskiego
        Urzędu Wojewódzkiego środki dotacji celowej pochodzącej z rezerwy celowej (cz. 83, poz. 49),
        w rozdziale 85202 § 2130 — Domy Pomocy Społecznej.
      </p>
      <p>
        <strong>Wartość dofinansowania: 688 950,00 zł</strong><br />
        (słownie: sześćset osiemdziesiąt osiem tysięcy dziewięćset pięćdziesiąt złotych 00/100).
      </p>
      <p><strong>Środki z funduszu przeznaczono na wypłatę dodatków dla pracowników.</strong></p>

      <h2>Do pobrania</h2>
    </div>

    <div class="mt-block max-w-column">
      <DocList docs={docs} />
    </div>

    <BackLink href="/dokumenty/dotacje/" label="Wróć do listy lat" />
  </PageShell>
</Base>
