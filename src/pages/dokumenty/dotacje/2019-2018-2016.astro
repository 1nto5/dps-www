---
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PageShell from "../../../components/PageShell.astro";
import SiblingNav from "../../../components/SiblingNav.astro";
import BackLink from "../../../components/BackLink.astro";
import PosterFigure from "../../../components/PosterFigure.astro";
import { dotacjeYears } from "../../../data/dotacje-years";
import poster2019 from "../../../assets/media/1277-00013.jpg";
import poster2018 from "../../../assets/media/1278-333_page-0001.jpg";
import poster2016 from "../../../assets/media/1279-72.jpg";
---

<Base
  title="Dotacje 2019, 2018 i 2016"
  description="Wcześniejsze dotacje Wojewody Warmińsko-Mazurskiego dla Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie — lata 2019, 2018 i 2016."
>
  <PageHeader
    breadcrumbs
    title="Dotacje 2019, 2018 i 2016"
    lead="Wcześniejsze dotacje otrzymane przez nasz Dom z budżetu Wojewody Warmińsko-Mazurskiego."
  />

  <PageShell>
    <SiblingNav
      slot="rail"
      title="Dotacje"
      items={dotacjeYears}
      current="/dokumenty/dotacje/2019-2018-2016/"
    />

    <div class="doc">
      <h2>Rok 2019</h2>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał dotację pochodzącą z budżetu Wojewody
        Warmińsko-Mazurskiego z przeznaczeniem na: zakupy inwestycyjne oraz wydatki związane
        z utrzymaniem standardów dla Domu Pomocy Społecznej im. Jana Pawła II.
      </p>
      <p><strong>Wartość całkowita zadania: 231 936,25 zł</strong></p>
      <p>
        Wydatki związane z utrzymaniem standardów dla Domu Pomocy Społecznej im. Jana Pawła II.
      </p>

      <PosterFigure
        src={poster2019}
        alt="Informacja z flagą i godłem Polski o dotacji Wojewody Warmińsko-Mazurskiego w 2019 roku na zakupy inwestycyjne i utrzymanie standardów, całkowita wartość zadania 231 936,25 zł."
        caption="Informacja o dotacji z 2019 roku."
      />

      <h2>Rok 2018</h2>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał dotację pochodzącą z budżetu Wojewody
        Warmińsko-Mazurskiego z przeznaczeniem na: zakup oraz wydatki związane z utrzymaniem
        standardów dla Domu Pomocy Społecznej im. Jana Pawła II.
      </p>
      <p><strong>Wartość całkowita zadania: 230 893,75 zł</strong></p>
      <p>
        Zakup oraz wydatki związane z utrzymaniem standardów dla Domu Pomocy Społecznej
        im. Jana Pawła II.
      </p>

      <PosterFigure
        src={poster2018}
        alt="Informacja z flagą i godłem Polski o dotacji Wojewody Warmińsko-Mazurskiego w 2018 roku na zakup i utrzymanie standardów, całkowita wartość zadania 230 893,75 zł."
        caption="Informacja o dotacji z 2018 roku."
      />

      <h2>Rok 2016</h2>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał dotację pochodzącą z budżetu Wojewody
        Warmińsko-Mazurskiego z przeznaczeniem na: naprawę systemu przywoławczego firmy Elda Delta
        Call Plus w Domu Pomocy Społecznej im. Jana Pawła II w Szczytnie.
      </p>
      <p><strong>Wartość całkowita zadania: 3 450,00 zł</strong></p>
      <p>
        Naprawa systemu przywoławczego firmy Elda Delta Call Plus w Domu Pomocy Społecznej
        im. Jana Pawła II w Szczytnie.
      </p>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał dotację pochodzącą z budżetu Wojewody
        Warmińsko-Mazurskiego z przeznaczeniem na: dofinansowanie realizacji zadań własnych,
        związanych z pokryciem potrzeb dla domów pomocy społecznej w zakresie utrzymania standardów
        i zapewnienia bezpieczeństwa w placówkach.
      </p>
      <p><strong>Wartość całkowita zadania: 158 634,00 zł</strong></p>
      <p>
        Dofinansowanie realizacji zadań własnych, związanych z pokryciem potrzeb dla domów pomocy
        społecznej w zakresie utrzymania standardów i zapewnienia bezpieczeństwa w placówkach.
      </p>

      <PosterFigure
        src={poster2016}
        alt="Informacja z flagą i godłem Polski o dwóch dotacjach Wojewody Warmińsko-Mazurskiego w 2016 roku: naprawa systemu przywoławczego za 3 450,00 zł oraz utrzymanie standardów i bezpieczeństwa za 158 634,00 zł."
        caption="Informacja o dotacjach z 2016 roku."
      />
    </div>

    <BackLink href="/dokumenty/dotacje/" label="Wróć do listy lat" />
  </PageShell>
</Base>
