---
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PageShell from "../../../components/PageShell.astro";
import SiblingNav from "../../../components/SiblingNav.astro";
import { dotacjeYears } from "../../../data/dotacje-years";
import posterSierpien from "../../../assets/media/1245-dot1.jpg";
import posterMarzec from "../../../assets/media/1246-Informacja-na-strone-1.jpg";
---

<Base
  title="Dotacje 2022"
  description="Dotacje otrzymane w 2022 roku przez Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — środki z Funduszu Przeciwdziałania COVID-19 na dyżury pielęgniarskie."
>
  <PageHeader
    breadcrumbs
    eyebrow="Dokumenty · Dotacje"
    title="Dotacje 2022"
    lead="Środki publiczne otrzymane przez nasz Dom w 2022 roku."
  />

  <PageShell narrow>
    <SiblingNav
      slot="rail"
      title="Dotacje"
      items={dotacjeYears}
      current="/dokumenty/dotacje/2022/"
    />

    <div class="doc">
      <h2>Fundusz Przeciwdziałania COVID-19 — dyżury od sierpnia do września 2022</h2>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał środki z Funduszu Przeciwdziałania
        COVID-19 z przeznaczeniem na: pomoc dla domów pomocy społecznej w przeciwdziałaniu skutkom
        rozprzestrzeniania się wirusa SARS-CoV-2, w 2022 roku.
      </p>
      <p><strong>Wartość całkowita zadania: 45 560,00 zł</strong></p>
      <p>
        Środki zostaną przeznaczone na zabezpieczenie dyżurów pielęgniarek z tytułu umowy zlecenie
        na okres od sierpnia do września 2022 roku.
      </p>

      <figure class="my-8">
        <Image
          src={posterSierpien}
          alt="Informacja z flagą i godłem Polski o środkach z Funduszu Przeciwdziałania COVID-19 w 2022 roku na kwotę 45 560,00 zł, przeznaczonych na dyżury pielęgniarek od sierpnia do września 2022 roku."
          widths={[480, 756]}
          sizes="(min-width: 768px) 34rem, 100vw"
          loading="lazy"
          class="w-full max-w-[34rem] rounded-lg border border-line bg-white"
        />
        <figcaption class="mt-2 text-sm text-muted">
          Informacja o dofinansowaniu — dyżury pielęgniarskie od sierpnia do września 2022 roku.
        </figcaption>
      </figure>

      <h2>Fundusz Przeciwdziałania COVID-19 — dyżury od marca do lipca 2022</h2>
      <p>
        Dom Pomocy Społecznej im. Jana Pawła II otrzymał środki z Funduszu Przeciwdziałania
        COVID-19 z przeznaczeniem na: pomoc dla domów pomocy społecznej w przeciwdziałaniu skutkom
        rozprzestrzeniania się wirusa SARS-CoV-2, w 2022 roku.
      </p>
      <p><strong>Wartość całkowita zadania: 119 136,00 zł</strong></p>
      <p>
        Środki zostaną przeznaczone na zabezpieczenie dyżurów pielęgniarek z tytułu umowy zlecenie
        na okres od marca do lipca 2022 roku.
      </p>

      <figure class="my-8">
        <Image
          src={posterMarzec}
          alt="Informacja z flagą i godłem Polski o środkach z Funduszu Przeciwdziałania COVID-19 w 2022 roku na kwotę 119 136,00 zł, przeznaczonych na dyżury pielęgniarek od marca do lipca 2022 roku."
          widths={[480, 680]}
          sizes="(min-width: 768px) 34rem, 100vw"
          loading="lazy"
          class="w-full max-w-[34rem] rounded-lg border border-line bg-white"
        />
        <figcaption class="mt-2 text-sm text-muted">
          Informacja o dofinansowaniu — dyżury pielęgniarskie od marca do lipca 2022 roku.
        </figcaption>
      </figure>

      <p><a href="/dokumenty/dotacje/">Wróć do listy lat</a></p>
    </div>
  </PageShell>
</Base>
