---
/**
 * The trail from the home page down to the page being read. The separators
 * are pseudo-elements with empty alternative text, so they are drawn but never
 * read out; the last crumb is the current page and is not a link.
 */
import { breadcrumbsFor } from "../data/routes";
interface Props {
  current?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || "/"
  : Astro.url.pathname;
const items = breadcrumbsFor(path, Astro.props.current);
const trail = items.slice(0, -1);
const last = items[items.length - 1];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((crumb, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: crumb.label,
    item: new URL(`${base}${crumb.href}`, Astro.site).href,
  })),
};
---

{
  items.length > 1 && (
    <nav aria-label="Ścieżka nawigacji" class="breadcrumbs mb-5 text-meta text-ink-soft">
      <ol role="list" class="flex flex-wrap items-center gap-x-1">
        {trail.map((crumb) => (
          <li>
            <a href={crumb.href} class="inline-block py-1 underline">
              {crumb.label}
            </a>
          </li>
        ))}
        <li>
          <span aria-current="page" class="inline-block py-1">
            {last.label}
          </span>
        </li>
      </ol>
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    </nav>
  )
}
<style>
  .breadcrumbs li:not(:last-child)::after {
    content: "›";
    content: "›" / "";
    margin-inline-start: 0.25rem;
  }
</style>
