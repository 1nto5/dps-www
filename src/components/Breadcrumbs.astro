---
/**
 * The trail from the home page down to the page being read. The separators are
 * pseudo-elements with empty alternative text, so they are drawn but never read
 * out; the last crumb is the current page and is not a link.
 */
import { breadcrumbsFor } from "../data/routes";

interface Props {
  /** Label for the last crumb when the route map cannot know it — a news post. */
  current?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || "/"
  : Astro.url.pathname;
const items = breadcrumbsFor(path, Astro.props.current);
const trail = items.slice(0, -1);
const last = items[items.length - 1]!;
---

{
  items.length > 1 && (
    <nav aria-label="Okruszki" class="breadcrumbs mb-5 text-sm text-ink-soft">
      <ol role="list" class="flex flex-wrap items-center gap-x-1">
        {trail.map((crumb) => (
          <li>
            <a href={crumb.href} class="inline-block py-1 underline">
              {crumb.label}
            </a>
          </li>
        ))}
        <li>
          <span aria-current="page" class="inline-block py-1">
            {last.label}
          </span>
        </li>
      </ol>
    </nav>
  )
}
