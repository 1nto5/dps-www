---
/**
 * In-page submenu: the sections of one page, as a single row of links placed
 * directly under `PageHeader`, above the content. Pages pass the list
 * explicitly rather than having it introspected from the headings, so labels
 * can be shorter than the headings they point at.
 *
 * It is a plain row at every width and wraps onto more lines when the labels
 * do not fit — nothing to open or close, no script. The row is framed by two
 * hairlines so it reads as a strip of the page, not as a second main menu.
 *
 * Every `id` here must exist on the rendered page; `scripts/check-section-nav.mjs`
 * fails the build if one drifts.
 */
interface Props {
  items: { id: string; label: string }[];
  title?: string;
}
const { items, title = "Na tej stronie" } = Astro.props;
---

<nav aria-label="Spis treści strony" data-section-nav class="mx-auto mb-8 max-w-6xl px-4 sm:px-6 md:mb-10">
  <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 border-y border-line py-3 text-meta">
    <p class="font-semibold text-muted">{title}</p>
    <ol role="list" class="flex flex-wrap gap-x-6 gap-y-2">
      {
        items.map((item) => (
          <li>
            <a href={`#${item.id}`} class="text-ink-soft hover:text-spruce-deep hover:underline">
              {item.label}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>
