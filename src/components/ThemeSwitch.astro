---
/**
 * Light / dark switch, three states: follow the system, dark, light.
 *
 * Sits in the header to the right of the main navigation. Like the
 * accessibility toolbar it is hidden until the <head> script marks scripting
 * as live (`html:not([data-js]) .theme-switch { display: none }`), because a
 * choice that cannot be kept is not worth offering; a reader without
 * JavaScript still gets dark mode from the system setting through
 * `prefers-color-scheme` in global.css.
 *
 * The choice is `data-theme` on <html> (absent = system) and `dps-theme` in
 * localStorage, re-applied before the first paint by the <head> script. The
 * two high-contrast modes always win over it — see the palette in global.css.
 *
 * Three real <button type="button"> elements with `aria-pressed`, one of
 * which is always pressed; the pressed state is fill plus border, never a
 * hue alone, and each button carries its name as text for assistive
 * technology, the icon being decoration.
 */
---

<div class="theme-switch" role="group" aria-label="Wygląd strony" data-theme-switch>
  <button type="button" data-theme-choice="" aria-pressed="true">
    <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2.5" y="4" width="15" height="10" rx="1.5"></rect>
      <path d="M7 17h6M10 14v3"></path>
    </svg>
    <span class="sr-only">Wygląd jak w systemie</span>
  </button>
  <button type="button" data-theme-choice="dark" aria-pressed="false">
    <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16.5 12.5A7 7 0 0 1 7.5 3.5a7 7 0 1 0 9 9z"></path>
    </svg>
    <span class="sr-only">Wygląd ciemny</span>
  </button>
  <button type="button" data-theme-choice="light" aria-pressed="false">
    <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="10" cy="10" r="3.5"></circle>
      <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"></path>
    </svg>
    <span class="sr-only">Wygląd jasny</span>
  </button>
  <p class="sr-only" role="status" aria-live="polite" data-theme-status></p>
</div>

<script>
  const root = document.documentElement;
  const group = document.querySelector<HTMLElement>("[data-theme-switch]");
  if (group) {
    const status = group.querySelector<HTMLElement>("[data-theme-status]");
    const buttons = group.querySelectorAll<HTMLButtonElement>("[data-theme-choice]");

    const sync = () => {
      const theme = root.getAttribute("data-theme") ?? "";
      for (const b of buttons) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-theme-choice") === theme));
      }
    };

    group.addEventListener("click", (event) => {
      const button = (event.target as Element).closest("button");
      if (!button) return;
      const theme = button.getAttribute("data-theme-choice") ?? "";
      if (theme) root.setAttribute("data-theme", theme);
      else root.removeAttribute("data-theme");
      try {
        if (theme) localStorage.setItem("dps-theme", theme);
        else localStorage.removeItem("dps-theme");
      } catch {
        /* private-mode Safari: the page still switches, the choice just will not follow the reader */
      }
      sync();
      if (status) {
        status.textContent =
          theme === "dark"
            ? "Włączono wygląd ciemny"
            : theme === "light"
              ? "Włączono wygląd jasny"
              : "Wygląd strony podąża za ustawieniem systemu";
      }
    });

    sync();
  }
</script>
