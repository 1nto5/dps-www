---
/**
 * Site-wide accessibility toolbar.
 *
 * The one place this site deliberately spends JavaScript: a reader's choice of
 * contrast, text size and motion has to survive a page change, and a static
 * site has no server and no session to keep it in. The choice therefore lives
 * in `localStorage` and is re-applied by the parser-blocking script in
 * <head> before anything paints.
 *
 * Failure is safe in both directions. Without JavaScript the bar does not
 * exist at all — `html:not([data-js]) .a11y-bar { display: none }` and the
 * `(scripting: none)` query in global.css keep it out of the page and out of
 * the tab order, so nobody is offered controls that cannot work. And if
 * storage throws (Safari in private mode), the reader simply gets the default
 * page.
 *
 * Every control is a real <button type="button"> carrying `aria-pressed`, not
 * a radio group and not `role="switch"`: these are on/off settings whose
 * pressed state is exactly what `aria-pressed` describes. No `accesskey`
 * anywhere — the accessibility statement declares that the site defines no
 * keyboard shortcuts of its own, and that has to stay true.
 *
 * The pressed state is carried by three things at once — fill, weight and
 * border — so it is never colour alone (WCAG 2.1 SC 1.4.1).
 */
---

<div class="a11y-bar" data-a11y-tools>
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-2 gap-y-2 px-4 py-1.5 sm:gap-x-6 sm:px-6"
  >
    <h2 class="sr-only">Ustawienia dostępności</h2>

    <div role="group" aria-labelledby="a11y-size-label" class="flex items-center gap-1 sm:gap-1.5">
      <span id="a11y-size-label" class="a11y-bar-label sr-only sm:not-sr-only">Rozmiar tekstu</span>
      <button type="button" data-a11y-font="" aria-pressed="true" aria-label="A: rozmiar tekstu standardowy"
        ><span class="label-steady" data-label="A">A</span></button
      >
      <button
        type="button"
        data-a11y-font="large"
        aria-pressed="false"
        aria-label="A+: rozmiar tekstu większy"><span class="label-steady" data-label="A+">A+</span></button
      >
      <button
        type="button"
        data-a11y-font="xlarge"
        aria-pressed="false"
        aria-label="A++: rozmiar tekstu największy"
        ><span class="label-steady" data-label="A++">A++</span></button
      >
    </div>

    <div
      role="group"
      aria-labelledby="a11y-contrast-label"
      data-a11y-group="contrast"
      class="flex items-center gap-1 sm:gap-1.5"
    >
      <span id="a11y-contrast-label" class="a11y-bar-label sr-only sm:not-sr-only">Kontrast</span>
      <button type="button" data-a11y-contrast="" aria-pressed="true" aria-label="Standardowy kontrast"
        ><span class="label-steady" data-label="Standardowy">Standardowy</span></button
      >
      <!--
        Two spellings of the same label: the phone width cannot hold the long
        one and stay inside two rows, and a truncated word is worse than a
        short one. Both are contained in the button's accessible name, so
        speech input still reaches the control by what it reads.
      -->
      <button
        type="button"
        data-a11y-contrast="yellow"
        aria-pressed="false"
        aria-label="Czarno-żółty: wysoki kontrast, żółty tekst na czarnym tle"
        ><span class="label-steady sm:hidden" data-label="Żółty">Żółty</span><span
          class="label-steady hidden sm:inline-block"
          data-label="Czarno-żółty">Czarno-żółty</span
        ></button
      >
      <button
        type="button"
        data-a11y-contrast="bw"
        aria-pressed="false"
        aria-label="Czarno-biały: wysoki kontrast, biały tekst na czarnym tle"
        ><span class="label-steady sm:hidden" data-label="Biały">Biały</span><span
          class="label-steady hidden sm:inline-block"
          data-label="Czarno-biały">Czarno-biały</span
        ></button
      >
    </div>

    <button
      type="button"
      data-a11y-motion="reduce"
      aria-pressed="false"
      aria-label="Ogranicz animacje"
      ><span class="label-steady" data-label="Ogranicz animacje">Ogranicz animacje</span></button
    >
    <!--
      Attached by the script only when the system itself asks for reduced
      motion. Then the button is already pressed and cannot be un-pressed —
      the system setting wins — so it says why instead of silently ignoring
      the press. Left hidden otherwise: a description nobody can act on would
      only be noise.
    -->
    <span id="a11y-motion-system" class="sr-only" hidden>Wynika z ustawień systemu</span>

    <a href="/deklaracja-dostepnosci/" class="a11y-bar-link">Deklaracja dostępności</a>

    <p class="sr-only" role="status" aria-live="polite" data-a11y-status></p>
  </div>
</div>

<script>
  const root = document.documentElement;
  const bar = document.querySelector<HTMLElement>("[data-a11y-tools]");

  if (bar) {
    const status = bar.querySelector<HTMLElement>("[data-a11y-status]");
    const systemReduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // One predicate for the whole site, defined by the <head> script.
    const motionOk = () =>
      (window as unknown as { dpsMotionOk?: () => boolean }).dpsMotionOk?.() ?? true;

    // Private-mode Safari throws on both reads and writes.
    const write = (key: string, value: string) => {
      try {
        if (value) localStorage.setItem(key, value);
        else localStorage.removeItem(key);
      } catch {
        /* the page still works, the choice just will not follow the reader */
      }
    };

    // The document is the source of truth: the <head> script has already
    // applied the stored choice, so the buttons read their state from it
    // rather than from storage a second time.
    const sync = () => {
      const font = root.getAttribute("data-font-size") ?? "";
      const contrast = root.getAttribute("data-contrast") ?? "";
      for (const b of bar.querySelectorAll("[data-a11y-font]")) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-a11y-font") === font));
      }
      for (const b of bar.querySelectorAll("[data-a11y-contrast]")) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-a11y-contrast") === contrast));
      }
      bar
        .querySelector("[data-a11y-motion]")
        ?.setAttribute(
          "aria-pressed",
          String(systemReduce || root.getAttribute("data-motion") === "reduce"),
        );
    };

    const say = (message: string) => {
      if (status) status.textContent = message;
    };

    // Turning contrast or reduced motion on mid-visit has to undo two things
    // the page set up while motion was still allowed: the cross-page
    // view transition (declared in CSS, so only a stylesheet can cancel it)
    // and any section still staged for an entrance it will never play.
    const applyMotion = () => {
      const off = !motionOk();
      const existing = document.getElementById("dps-no-vt");
      if (off && !existing) {
        const style = document.createElement("style");
        style.id = "dps-no-vt";
        style.textContent = "@view-transition{navigation:none}";
        document.head.append(style);
      } else if (!off && existing) {
        existing.remove();
      }
      if (off) {
        // The staged elements are mid-choreography and carry a stagger delay
        // of up to 400ms as an inline style. Simply letting the CSS stop
        // applying would leave them transparent for that delay — the reader
        // would ask for high contrast and watch part of the page arrive
        // afterwards. With an animation there is nothing to prime: naming the
        // animation `none` and zeroing the delay is enough.
        const staged = document.querySelectorAll<HTMLElement>("[data-reveal]");
        for (const el of staged) {
          el.style.animationName = "none";
          el.style.animationDelay = "0s";
          el.classList.add("is-visible");
        }
        // <main> may still be playing the whole-page rise.
        document.querySelector<HTMLElement>("main")?.style.setProperty("animation", "none");
      }
    };

    if (systemReduce) {
      const note = document.getElementById("a11y-motion-system");
      const button = bar.querySelector("[data-a11y-motion]");
      if (note && button) {
        note.removeAttribute("hidden");
        button.setAttribute("aria-describedby", "a11y-motion-system");
        button.setAttribute("data-a11y-system", "");
      }
    }

    bar.addEventListener("click", (event) => {
      const button = (event.target as Element).closest("button");
      if (!button) return;

      const font = button.getAttribute("data-a11y-font");
      if (font !== null) {
        if (font) root.setAttribute("data-font-size", font);
        else root.removeAttribute("data-font-size");
        write("dps-font", font);
        say(
          "Rozmiar tekstu: " +
            (font === "large" ? "większy" : font === "xlarge" ? "największy" : "standardowy"),
        );
      }

      const contrast = button.getAttribute("data-a11y-contrast");
      if (contrast !== null) {
        if (contrast) root.setAttribute("data-contrast", contrast);
        else root.removeAttribute("data-contrast");
        write("dps-contrast", contrast);
        say(
          contrast === "yellow"
            ? "Włączono wysoki kontrast: czarno-żółty"
            : contrast === "bw"
              ? "Włączono wysoki kontrast: czarno-biały"
              : "Przywrócono standardowy kontrast",
        );
        applyMotion();
      }

      if (button.hasAttribute("data-a11y-motion")) {
        // One-directional: a system-level preference cannot be overridden here.
        if (systemReduce) return;
        const on = root.getAttribute("data-motion") !== "reduce";
        if (on) root.setAttribute("data-motion", "reduce");
        else root.removeAttribute("data-motion");
        write("dps-motion", on ? "reduce" : "");
        say(on ? "Ograniczono animacje" : "Przywrócono animacje");
        applyMotion();
      }

      sync();
    });

    sync();
  }
</script>
