---
/**
 * Rail navigation between the pages of one section — the sibling pages of the
 * page being read, plus (optionally) the page itself marked as current.
 *
 * Unlike `SectionNav` this is not a table of contents of the page, so there is
 * nothing to collapse: it is already a short list. It renders the same at every
 * width, and as `PageShell`'s rail it comes first in DOM order, so on small
 * screens it reads as a short "where am I" list above the text and on wide
 * screens it sits in the rail.
 *
 * Supplementary, never the only route: everything it links to is also reachable
 * from the section's own index page and the main navigation.
 */
interface Props {
  /** Small heading above the list, and the nav's accessible name. */
  title: string;
  items: readonly { href: string; label: string }[];
  /** `href` of the page being read, if it is one of the items. */
  current?: string;
}
const { title, items, current } = Astro.props;
---

<nav aria-label={title}>
  <p class="px-2 text-meta font-semibold text-muted">{title}</p>
  <ul role="list" class="mt-2">
    {
      items.map((item) => {
        const isCurrent = item.href === current;
        return (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent ? "page" : undefined}
              class:list={[
                // The 3px left rule is on the SHARED class, transparent on
                // every item and coloured on the current one, so marking the
                // current page adds a shape without moving any label sideways.
                // Colour alone would not be enough on its own anyway (SC 1.4.1).
                "block rounded border-l-[3px] border-transparent px-2 py-1.5 text-meta",
                isCurrent
                  ? "border-spruce bg-moss-deep font-semibold text-spruce-deep"
                  : "text-ink-soft hover:text-spruce-deep hover:underline",
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
