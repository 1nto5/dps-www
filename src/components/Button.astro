---
/**
 * `primary` is the one action of a page; `secondary` the alternative beside it.
 * Buttons are links — nothing on this site submits a form.
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const { href, variant = "primary" } = Astro.props;
---

<a href={href} class:list={["btn", `btn-${variant}`]}>
  <slot />
</a>
