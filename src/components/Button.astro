---
/**
 * `primary` is the one action of a page (usually the phone), `secondary` the
 * alternative beside it. `phone` sets the large tabular figure treatment.
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  phone?: boolean;
  class?: string;
}
const { href, variant = "primary", phone = false, class: className = "" } = Astro.props;
---

<a
  href={href}
  class:list={["btn", variant === "primary" && "btn-primary", phone && "btn-phone", className]}
>
  <slot />
</a>
