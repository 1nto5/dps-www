---
/**
 * The two-column page: a rail on the left (a `Toc` or a `PageList` of
 * siblings) and the content on the right. Below 64rem the rail sits above
 * the content. Without a rail the content simply takes the column.
 */
---

<div
  class="mx-auto grid w-full max-w-wide gap-10 px-5 pb-16 pt-8 sm:px-8 lg:grid-cols-[14rem_1fr] lg:gap-14 lg:pt-10"
>
  {
    Astro.slots.has("rail") && (
      <aside class="lg:sticky lg:top-6 lg:self-start">
        <slot name="rail" />
      </aside>
    )
  }
  <div class:list={["min-w-0", !Astro.slots.has("rail") && "lg:col-start-2"]} data-shell-content>
    <slot />
  </div>
</div>
