---
/**
 * The body of a page: the content column, and an optional rail — `SubNav`,
 * `Toc`, or both — in the `aside` slot. From `lg` the rail sits on the right and
 * stays in place while the content scrolls; below `lg` it sits above the
 * content, which is also where it comes in the reading order.
 *
 * The slot fills a plain <div>: `SubNav` brings its own <aside>, so wrapping one
 * here would make two complementary landmarks out of one rail.
 */
const hasAside = Astro.slots.has("aside");
---

<div
  class:list={[
    "mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8 md:pb-24",
    hasAside && "grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-14",
  ]}
>
  {
    hasAside && (
      <div class="space-y-8 lg:sticky lg:top-8 lg:col-start-2 lg:row-start-1 lg:self-start">
        <slot name="aside" />
      </div>
    )
  }
  <div class:list={["min-w-0", hasAside && "lg:col-start-1 lg:row-start-1"]}>
    <slot />
  </div>
</div>
