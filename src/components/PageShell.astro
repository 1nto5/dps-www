---
/**
 * The body of a page: the content column, and an optional rail — `SubNav`,
 * `Toc`, or both — in the `aside` slot. From `lg` the rail sits on the right and
 * stays in place while the content scrolls; below `lg` it sits above the
 * content, which is also where it comes in the reading order.
 *
 * A page with a rail also puts its `PageHeader` here, in the `header` slot. The
 * heading then shares the content column, and the rail starts on the same line
 * as the trail above the heading instead of below the whole heading block.
 *
 * The slot fills a plain <div>: `SubNav` brings its own <aside>, so wrapping one
 * here would make two complementary landmarks out of one rail.
 */
const hasAside = Astro.slots.has("aside");
const hasHeader = Astro.slots.has("header");
---

<div
  class:list={[
    "mx-auto w-full max-w-6xl px-5 pb-16 sm:px-8 md:pb-24",
    hasHeader && "pt-8 md:pt-10",
    hasAside && "grid gap-x-10 gap-y-8 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-x-14",
  ]}
>
  {
    hasHeader && (
      <div class:list={["min-w-0", hasAside && "lg:col-start-1 lg:row-start-1"]}>
        <slot name="header" />
      </div>
    )
  }
  {
    hasAside && (
      <div
        class:list={[
          "space-y-8 lg:sticky lg:top-8 lg:col-start-2 lg:row-start-1 lg:self-start",
          hasHeader && "lg:row-span-2",
        ]}
        data-reveal
      >
        <slot name="aside" />
      </div>
    )
  }
  <div
    class:list={[
      "min-w-0",
      hasAside && "lg:col-start-1",
      hasAside && (hasHeader ? "lg:row-start-2" : "lg:row-start-1"),
    ]}
    data-reveal
  >
    <slot />
  </div>
</div>
