---
/**
 * A photograph in its natural rectangle, with a caption that says who or what
 * is in it. `alt` describes the picture; `caption` is the sentence under it.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  class?: string;
}
const {
  src,
  alt,
  caption,
  sizes = "(min-width: 64rem) 40rem, 100vw",
  widths = [480, 800, 1200],
  loading = "lazy",
  class: className = "",
} = Astro.props;
---

<figure class:list={["photo", className]}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
