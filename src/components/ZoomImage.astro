---
/**
 * A single click-to-enlarge image (document scans, posters, press
 * clippings). Renders the thumbnail wrapped in a Lightbox trigger;
 * without JS the link opens the full-size image file.
 */
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Lightbox from "./Lightbox.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const {
  src,
  alt,
  caption,
  widths = [480, 800],
  sizes = "(min-width: 768px) 50vw, 100vw",
  class: className = "",
} = Astro.props;
const full = await getImage({ src, width: 1800, format: "webp" });
---

<a href={full.src} data-lightbox data-caption={caption ?? alt} class="rounded-lg">
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    class:list={["w-full rounded-lg border border-line", className]}
    loading="lazy"
  />
</a>
<Lightbox />
