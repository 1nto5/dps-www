---
/**
 * One news post as a card. Two grids show these — the homepage strip and the
 * /aktualnosci/ list — and they had drifted apart on padding and on the gap
 * under the title.
 *
 * `headingLevel` is the caller's, not the card's: on /aktualnosci/ the posts
 * are the page's own sections and take `h2`, while on the homepage they sit
 * under the "Komunikaty i podziękowania" heading and must be `h3` for the
 * outline to stay unbroken.
 *
 * `list` is the single-column presentation, used when there are too few posts
 * for a grid: the same card at a larger type scale.
 *
 * The whole card is clickable through the title's stretched `::before`;
 * `data-card-link` is what the site-wide pressed-state rule looks for.
 */
import type { CollectionEntry } from "astro:content";
import PostDate from "./PostDate.astro";

interface Props {
  post: CollectionEntry<"aktualnosci">;
  headingLevel: "h2" | "h3";
  list: boolean;
}
const { post, headingLevel: Heading, list } = Astro.props;
---

<li class="relative flex">
  <article
    class="flex w-full flex-col rounded-xl border border-line bg-card p-6 transition-colors duration-150 hover:border-spruce/40 hover:shadow-card focus-within:border-spruce/40"
  >
    <PostDate date={post.data.date} />
    <Heading class:list={["mt-2", list ? "text-2xl" : "text-xl"]}>
      <a
        href={`/aktualnosci/${post.id}/`}
        data-card-link
        class="text-spruce-deep underline before:absolute before:inset-0 before:content-[''] hover:text-spruce"
      >
        {post.data.title}
      </a>
    </Heading>
    {
      post.data.description && (
        <p class:list={["mt-3 text-muted", list && "text-lg"]}>{post.data.description}</p>
      )
    }
  </article>
</li>
