---
/**
 * Signature photo frame: window-arch top. Use for hero and feature photos.
 * `src` must be an imported image (src/assets), rendered via astro:assets.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: "eager" | "lazy";
}
const {
  src,
  alt,
  widths = [480, 800, 1200],
  sizes = "(min-width: 768px) 50vw, 100vw",
  class: className = "",
  loading = "lazy",
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={loading}
  class:list={["w-full rounded-b-xl rounded-t-[999px] object-cover", className]}
/>
