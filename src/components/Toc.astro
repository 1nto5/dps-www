---
/**
 * „Na tej stronie" — the `h2` ids of one page, for pages long enough to have
 * four or more of them. Every id here has to exist on the page.
 */
interface Props {
  items: readonly { id: string; label: string }[];
  title?: string;
}

const { items, title = "Na tej stronie" } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="rail" aria-label={title}>
      <p class="rail-title">{title}</p>
      <ul role="list">
        {items.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
