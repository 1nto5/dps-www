---
/**
 * „W tej sekcji" — the other pages around this one. It works out its own list
 * from the address of the page, so a page only has to place it:
 *
 *   <SubNav slot="aside" />
 *
 * The list is the nearest group in `nav.ts` that holds the page — the group's
 * own page first, then its children. A page in a section without children
 * renders nothing at all.
 */
import { sectionPages } from "../data/nav";
import { sitePath } from "../data/routes";

const title = "W tej sekcji";
const path = sitePath(Astro.url.pathname);
const items = sectionPages(path);
---

{
  items.length > 0 && (
    <aside class="rail" aria-label={title}>
      <p class="rail-title">{title}</p>
      <ul role="list">
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
