---
/**
 * The one `h1` of a page, with an optional lead. `breadcrumbs` draws the trail
 * above the title on every page below the top level.
 */
import Breadcrumbs from "./Breadcrumbs.astro";
interface Props {
  title: string;
  lead?: string;
  breadcrumbs?: boolean;
  /** Label for the last crumb when the route map cannot know it — a news post. */
  current?: string;
}
const { title, lead, breadcrumbs = false, current } = Astro.props;
---

<header class="mx-auto w-full max-w-wide px-5 pt-10 sm:px-8 md:pt-14">
  {breadcrumbs && <Breadcrumbs current={current} />}
  <h1 class="max-w-[22ch] text-4xl md:text-5xl">{title}</h1>
  {lead && <p class="mt-5 max-w-[48ch] text-lg text-ink-soft">{lead}</p>}
  <slot />
</header>
