---
/**
 * Three columns of facts, all of them from `data/contact.ts`, and one bottom
 * line with the two statements every public institution has to keep in reach.
 */
import { contact, addressLines } from "../data/contact";
import { mainNav } from "../data/nav";

const year = new Date().getFullYear();
const home = addressLines(contact.address);
const branch = addressLines(contact.spychowo.address);
---

<footer transition:animate="none" class="mt-auto border-t border-line bg-sand">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:px-8 md:grid-cols-3 md:py-16">
    <div>
      <p id="footer-dps-name" class="font-display text-lg font-semibold">{contact.name}</p>
      <address class="mt-3 text-ink-soft" aria-labelledby="footer-dps-name">
        {home[0]}<br />
        {home[1]}
      </address>

      <p id="footer-spychowo-name" class="mt-8 font-display text-lg font-semibold">
        {contact.spychowo.name}
      </p>
      <address class="mt-3 text-ink-soft" aria-labelledby="footer-spychowo-name">
        {branch[0]}<br />
        {branch[1]}<br />
        tel. <a href={contact.spychowo.phone.href}>{contact.spychowo.phone.label}</a>
      </address>
    </div>

    <div>
      <p id="footer-kontakt" class="font-display text-lg font-semibold">Kontakt</p>
      <dl class="mt-3 text-ink-soft" aria-labelledby="footer-kontakt">
        <dt class="sr-only">Telefon</dt>
        <dd>tel. <a href={contact.phone.href}>{contact.phone.label}</a></dd>
        <dt class="sr-only">Faks</dt>
        <dd>faks {contact.fax}</dd>
        <dt class="sr-only">E-mail</dt>
        <dd class="mt-2"><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        <dt class="sr-only">Skrytka ePUAP</dt>
        <dd class="mt-2">ePUAP {contact.epuap}</dd>
      </dl>

      <p id="footer-informacja-publiczna" class="mt-8 font-display text-lg font-semibold">
        Informacja publiczna
      </p>
      <p class="mt-3 text-ink-soft" aria-labelledby="footer-informacja-publiczna">
        W sprawie dostępu do informacji publicznej prosimy o kontakt z
        <a href="/kontakt/">sekretariatem</a>.
      </p>
    </div>

    <div>
      <p id="footer-strony-serwisu" class="font-display text-lg font-semibold">Strony serwisu</p>
      <nav aria-labelledby="footer-strony-serwisu">
        <ul role="list" class="mt-3 space-y-1">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} class="inline-block py-1">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto max-w-6xl px-5 py-4 text-sm text-ink-soft sm:px-8">
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
        <p>
          © {year}
          {contact.name}. Jednostka organizacyjna Powiatu Szczycieńskiego.
        </p>
        <p class="flex flex-wrap gap-x-6">
          <a href="/deklaracja-dostepnosci/">Deklaracja dostępności</a>
          <a href="/rodo/">RODO</a>
        </p>
      </div>
      <p class="mt-3 text-xs sm:text-right">
        Projekt i wykonanie strony: <a
          href="https://adrianantosiak.pl"
          rel="author noopener noreferrer"
          target="_blank">Adrian Antosiak<span class="sr-only"> (otwiera się w nowej karcie)</span></a
        >
      </p>
    </div>
  </div>
</footer>
