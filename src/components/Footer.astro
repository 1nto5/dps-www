---
import { contact, addressLine } from "../data/contact";
const year = new Date().getFullYear();
---

<footer class="mt-section border-t border-line bg-mist">
  <div class="mx-auto grid max-w-wide gap-10 px-5 py-12 sm:px-8 md:grid-cols-3">
    <div>
      <h2 class="text-lg">Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie</h2>
      <address class="mt-3 not-italic text-ink-soft">
        {addressLine(contact.address)}<br />
        tel. <a href={contact.phone.href} class="inline-block py-1 underline">{contact.phone.label}</a><br />
        <a href={`mailto:${contact.email}`} class="inline-block py-1 underline">{contact.email}</a>
      </address>
      <h2 class="mt-6 text-lg">Filia w Spychowie</h2>
      <address class="mt-3 not-italic text-ink-soft">
        {addressLine(contact.spychowo.address)}<br />
        tel. <a href={contact.spychowo.phone.href} class="inline-block py-1 underline"
          >{contact.spychowo.phone.label}</a
        >
      </address>
    </div>
    <div>
      <h2 class="font-body text-base font-semibold">Na skróty</h2>
      <ul role="list" class="mt-3 space-y-1">
        <li><a href="/zamieszkac-u-nas/" class="inline-block py-1 underline">Przyjęcie do Domu</a></li>
        <li><a href="/kontakt/" class="inline-block py-1 underline">Kontakt i adres</a></li>
        <li><a href="/dostepnosc/" class="inline-block py-1 underline">Tekst łatwy do czytania</a></li>
        <li><a href="/deklaracja-dostepnosci/" class="inline-block py-1 underline">Deklaracja dostępności</a></li>
        <li><a href="/dokumenty/rodo/" class="inline-block py-1 underline">Ochrona danych osobowych (RODO)</a></li>
        <li><a href="/dokumenty/sygnalista/" class="inline-block py-1 underline">Zgłoszenia sygnalistów</a></li>
        <li><a href="/dokumenty/zamowienia-publiczne/" class="inline-block py-1 underline">Zamówienia publiczne</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-body text-base font-semibold">Biuletyn Informacji Publicznej</h2>
      <p class="mt-3 text-ink-soft">
        <a href={contact.bip} class="inline-block py-1 underline">BIP Domu (serwis zewnętrzny)</a><br />
        <a href="https://www.bip.gov.pl/" class="inline-block py-1 underline">Strona centralna BIP</a>
      </p>
      <p class="mt-3 text-ink-soft">
        W sprawie dostępu do informacji publicznej prosimy o kontakt z
        <a href="/kontakt/" class="inline-block py-1 underline">sekretariatem</a>.
      </p>
    </div>
  </div>
  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-wide flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-5 py-4 text-meta text-ink-soft sm:px-8"
    >
      <p>© {year} Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie. Jednostka organizacyjna Powiatu Szczycieńskiego.</p>
      <p>Projekt i wykonanie: <a href="https://adrianantosiak.pl" class="inline-block py-1 underline">Adrian Antosiak</a></p>
    </div>
  </div>
</footer>
