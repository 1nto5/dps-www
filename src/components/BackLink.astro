---
/**
 * The "wróć do…" link that closes a subpage. Fifteen pages carried their own
 * copy of it, with three different top margins between them.
 *
 * It must be placed OUTSIDE the page's `.doc` wrapper: the `.doc p` and
 * `.doc a` rules are unlayered, so inside one they would beat the utilities
 * written here and the link would take the prose spacing and colour instead
 * of its own.
 */
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<p class="mt-section">
  <a href={href} class="inline-block py-1 text-spruce underline hover:text-spruce-deep">{label}</a>
</p>
