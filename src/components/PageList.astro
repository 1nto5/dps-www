---
/**
 * A plain list of pages, one link per row, with an optional sentence under each
 * link. This is the site's only "card": a section's subpages, the ways out of
 * the 404 page, the news list.
 */
interface Props {
  items: readonly { href: string; label: string; text?: string }[];
}

const { items } = Astro.props;
---

<ul class="pages" role="list">
  {
    items.map((item) => (
      <li>
        <a href={item.href}>
          <span>{item.label}</span>
          {item.text && <p>{item.text}</p>}
        </a>
      </li>
    ))
  }
</ul>
