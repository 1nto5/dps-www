---
/**
 * Two rows. A thin bar with the telephone and the reader's tools — text size
 * and contrast — and the main row with the name of the Dom and the six
 * sections. From `md` up the sections are a flat row of links; below that they
 * live behind one „Menu" button, in a native <dialog>. No dropdowns anywhere.
 */
import { mainNav, activeSection } from "../data/nav";
import { contact } from "../data/contact";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || "/"
  : Astro.url.pathname;
const section = activeSection(path);
const current = (href: string) => (href === section?.href ? "page" : undefined);
---

<header>
  <div class="border-b border-line bg-sand">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-2 sm:px-8"
    >
      <p>
        <span class="text-sm text-ink-soft">Telefon:</span>
        <a href={contact.phone.href} class="font-semibold">{contact.phone.label}</a>
      </p>

      <div class="flex flex-wrap items-center gap-2" data-tools hidden>
        <div class="flex items-center gap-1" role="group" aria-label="Wielkość tekstu">
          <button type="button" class="tool" data-font="normal" aria-pressed="true">
            <span>A</span><span class="sr-only"> — tekst standardowy</span>
          </button>
          <button type="button" class="tool" data-font="large" aria-pressed="false">
            <span>A+</span><span class="sr-only"> — tekst większy</span>
          </button>
          <button type="button" class="tool" data-font="xlarge" aria-pressed="false">
            <span>A++</span><span class="sr-only"> — tekst największy</span>
          </button>
        </div>
        <button type="button" class="tool" data-contrast aria-pressed="false">Kontrast</button>
      </div>
    </div>
  </div>

  <div class="border-b border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-5 py-4 sm:px-8 max-md:flex-nowrap"
    >
      <a href="/" class="no-underline">
        <span class="block font-display text-xl leading-tight font-semibold text-ink"
          >Dom Pomocy Społecznej</span
        >
        <span class="block text-sm text-ink-soft">im. Jana Pawła II w Szczytnie</span>
      </a>

      <div class="md:hidden">
        <button type="button" class="tool" data-menu-open aria-haspopup="dialog" aria-expanded="false">
          Menu
        </button>
      </div>

      <nav aria-label="Menu główne" class="hidden md:block">
        <ul role="list" class="flex flex-wrap gap-x-6">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} class="nav-link" aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <dialog class="menu" data-menu aria-label="Menu główne">
    <div class="mx-auto max-w-6xl">
      <div class="flex justify-end">
        <button type="button" class="tool" data-menu-close>Zamknij</button>
      </div>
      <nav aria-label="Menu główne">
        <ul role="list" class="mt-3">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </dialog>
</header>

<script>
  // The reader's tools. They do nothing without JavaScript, so they stay hidden
  // until this runs; the values themselves are applied by the inline script in
  // Base, before first paint.
  const doc = document.documentElement;
  const tools = document.querySelector<HTMLElement>("[data-tools]");
  const fontButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-font]")];
  const contrastButton = document.querySelector<HTMLButtonElement>("[data-contrast]");

  function remember(key: string, value: string | null) {
    try {
      if (value === null) localStorage.removeItem(key);
      else localStorage.setItem(key, value);
    } catch {
      // A browser with storage switched off still gets the setting for this page.
    }
  }

  function syncFont() {
    const size = doc.getAttribute("data-font-size") ?? "normal";
    for (const button of fontButtons) {
      button.setAttribute("aria-pressed", String(button.dataset.font === size));
    }
  }

  for (const button of fontButtons) {
    button.addEventListener("click", () => {
      const size = button.dataset.font!;
      if (size === "normal") doc.removeAttribute("data-font-size");
      else doc.setAttribute("data-font-size", size);
      remember("dps-font", size === "normal" ? null : size);
      syncFont();
    });
  }

  contrastButton?.addEventListener("click", () => {
    const on = doc.getAttribute("data-contrast") === "high";
    if (on) doc.removeAttribute("data-contrast");
    else doc.setAttribute("data-contrast", "high");
    remember("dps-contrast", on ? null : "high");
    contrastButton.setAttribute("aria-pressed", String(!on));
  });

  syncFont();
  contrastButton?.setAttribute("aria-pressed", String(doc.getAttribute("data-contrast") === "high"));
  tools?.removeAttribute("hidden");

  // The menu below `md`.
  const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
  const open = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  if (menu && open) {
    open.addEventListener("click", () => {
      menu.showModal();
      open.setAttribute("aria-expanded", "true");
    });
    menu.querySelector("[data-menu-close]")?.addEventListener("click", () => menu.close());
    menu.addEventListener("click", (e) => e.target === menu && menu.close());
    menu.addEventListener("close", () => open.setAttribute("aria-expanded", "false"));
  }
</script>
