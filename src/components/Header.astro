---
/**
 * The site header: the menu button, the name, the reader tools (text size,
 * contrast and theme) and the telephone. The sections live in a <dialog> drawer that
 * slides in from the left at every width, so the header is the same on a
 * phone and a desktop.
 */
import { mainNav, activeSection } from "../data/nav";
import { contact } from "../data/contact";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || "/"
  : Astro.url.pathname;
const active = activeSection(path);
---

<header class="border-b border-line">
  <div
    class="mx-auto flex max-w-wide flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4 sm:px-8"
  >
    <div class="flex items-center gap-4">
      <button type="button" class="menu-open" data-menu-open aria-haspopup="dialog" aria-expanded="false">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <span>Menu</span>
      </button>
      <a href="/" class="text-ink no-underline">
        <span class="block font-display text-lg font-bold leading-tight sm:text-xl">Dom Pomocy Społecznej</span>
        <span class="block text-meta text-ink-soft">im. Jana Pawła II w Szczytnie</span>
      </a>
    </div>

    <div class="flex items-center gap-4">
      <div class="tools flex items-center gap-1" data-tools>
        <span class="sr-only" id="tools-label">Rozmiar tekstu, kontrast, ruch i motyw</span>
        <div role="group" aria-labelledby="tools-label" class="flex gap-1">
          <button type="button" class="tool" data-font="" aria-pressed="true">
            <span aria-hidden="true">A</span><span class="sr-only">Tekst standardowy</span>
          </button>
          <button type="button" class="tool" data-font="large" aria-pressed="false">
            <span aria-hidden="true">A+</span><span class="sr-only">Tekst większy</span>
          </button>
          <button type="button" class="tool" data-font="xlarge" aria-pressed="false">
            <span aria-hidden="true">A++</span><span class="sr-only">Tekst największy</span>
          </button>
          <button type="button" class="tool" data-contrast="yellow" aria-pressed="false">
            Kontrast
          </button>
          <button type="button" class="tool" data-motion aria-pressed="false">
            <span aria-hidden="true">Ruch</span><span class="sr-only">Ogranicz ruch</span>
          </button>
          <!--
            Shown only when the system itself asks for reduced motion: the
            button is then pressed and cannot be released, so it says why.
          -->
          <span id="motion-system-note" class="sr-only" hidden>Wynika z ustawień systemu</span>
          <button type="button" class="tool tool-theme" data-theme-cycle>
            <svg data-icon="system" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="13" rx="2" />
              <path d="M8 21h8M12 17v4" />
            </svg>
            <svg data-icon="light" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg data-icon="dark" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            <span class="sr-only" data-theme-label>Motyw: systemowy. Zmień motyw</span>
          </button>
        </div>
        <p class="sr-only" aria-live="polite" data-tools-status></p>
      </div>
      <a
        href={contact.phone.href}
        class="hidden font-semibold text-lake-deep no-underline sm:inline-block"
        >{contact.phone.label}</a
      >
    </div>
  </div>
</header>

<dialog class="menu" aria-label="Menu strony" data-menu>
  <div class="flex min-h-full flex-col px-5 py-4">
    <div class="flex items-center justify-between">
      <p class="font-display text-xl font-bold">Menu</p>
      <button type="button" class="tool" data-menu-close>Zamknij</button>
    </div>
    <ul role="list" class="mt-6">
      <li><a href="/" aria-current={path === "/" ? "page" : undefined}>Strona główna</a></li>
      {
        mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === active ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href="/zamieszkac-u-nas/" aria-current={path === "/zamieszkac-u-nas/" ? "page" : undefined}>Przyjęcie do Domu</a></li>
    </ul>
    <p class="mt-8 text-ink-soft">
      Zadzwoń: <a href={contact.phone.href} class="font-semibold text-lake-deep">{contact.phone.label}</a>
    </p>
  </div>
</dialog>

<script>
  const root = document.documentElement;
  const tools = document.querySelector<HTMLElement>("[data-tools]");
  const status = tools?.querySelector<HTMLElement>("[data-tools-status]");

  const write = (key: string, value: string) => {
    try {
      if (value) localStorage.setItem(key, value);
      else localStorage.removeItem(key);
    } catch {
      /* private mode: the choice just does not follow the reader */
    }
  };

  const THEMES = ["", "light", "dark"] as const;
  const themeName = (t: string) => (t === "light" ? "jasny" : t === "dark" ? "ciemny" : "systemowy");

  const sync = () => {
    if (!tools) return;
    const theme = root.getAttribute("data-theme") ?? "";
    const label = tools.querySelector<HTMLElement>("[data-theme-label]");
    if (label) label.textContent = `Motyw: ${themeName(theme)}. Zmień motyw`;
    const font = root.getAttribute("data-font-size") ?? "";
    const contrast = root.getAttribute("data-contrast") ?? "";
    for (const b of tools.querySelectorAll("[data-font]")) {
      b.setAttribute("aria-pressed", String(b.getAttribute("data-font") === font));
    }
    for (const b of tools.querySelectorAll("[data-contrast]")) {
      b.setAttribute("aria-pressed", String(contrast !== ""));
    }
    for (const b of tools.querySelectorAll("[data-motion]")) {
      b.setAttribute("aria-pressed", String(systemReduce || root.getAttribute("data-motion") === "reduce"));
    }
    applyMotion();
  };

  // The reader's own choice, or the system's. Cross-document view transitions
  // are declared in CSS and only a later `@view-transition` rule can cancel
  // them, so the cancel is appended at the end of <body>, after the stylesheet.
  const systemReduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const motionOff = () => systemReduce || root.getAttribute("data-motion") === "reduce";
  const applyMotion = () => {
    const existing = document.getElementById("dps-no-vt");
    if (motionOff() && !existing) {
      const style = document.createElement("style");
      style.id = "dps-no-vt";
      style.textContent = "@view-transition{navigation:none}";
      document.body.append(style);
    } else if (!motionOff() && existing) existing.remove();
  };
  if (systemReduce) {
    const note = document.getElementById("motion-system-note");
    const button = tools?.querySelector("[data-motion]");
    if (note && button) {
      note.removeAttribute("hidden");
      button.setAttribute("aria-describedby", "motion-system-note");
    }
  }

  tools?.addEventListener("click", (event) => {
    const button = (event.target as Element).closest("button");
    if (!button) return;
    const font = button.getAttribute("data-font");
    if (font !== null) {
      if (font) root.setAttribute("data-font-size", font);
      else root.removeAttribute("data-font-size");
      write("dps-font", font);
      if (status)
        status.textContent =
          "Rozmiar tekstu: " +
          (font === "large" ? "większy" : font === "xlarge" ? "największy" : "standardowy");
    }
    if (button.hasAttribute("data-contrast")) {
      const on = !root.hasAttribute("data-contrast");
      if (on) root.setAttribute("data-contrast", "yellow");
      else root.removeAttribute("data-contrast");
      write("dps-contrast", on ? "yellow" : "");
      if (status) status.textContent = on ? "Włączono wysoki kontrast" : "Wyłączono wysoki kontrast";
    }
    if (button.hasAttribute("data-motion")) {
      if (systemReduce) {
        if (status) status.textContent = "Ograniczenie ruchu wynika z ustawień systemu";
        return;
      }
      const on = root.getAttribute("data-motion") !== "reduce";
      if (on) root.setAttribute("data-motion", "reduce");
      else root.removeAttribute("data-motion");
      write("dps-motion", on ? "reduce" : "");
      if (status) status.textContent = on ? "Ograniczono ruch na stronie" : "Przywrócono animacje";
    }
    if (button.hasAttribute("data-theme-cycle")) {
      const current = root.getAttribute("data-theme") ?? "";
      const next = THEMES[(THEMES.indexOf(current as (typeof THEMES)[number]) + 1) % THEMES.length];
      const apply = () => {
        if (next) root.setAttribute("data-theme", next);
        else root.removeAttribute("data-theme");
        // The new icon rises in once, as the theme lands.
        button.removeAttribute("data-theme-changed");
        void button.offsetWidth;
        button.setAttribute("data-theme-changed", "");
        sync();
      };
      // The new theme is wiped in as a circle growing from the press, through
      // a same-document view transition; a keyboard press starts from the
      // button's centre. Speed and easing come from the motion tokens.
      const reduced = motionOff();
      if (!reduced && !root.hasAttribute("data-contrast") && "startViewTransition" in document) {
        const r = button.getBoundingClientRect();
        const x = event.clientX || r.left + r.width / 2;
        const y = event.clientY || r.top + r.height / 2;
        const reach = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        const style = getComputedStyle(root);
        const duration = parseFloat(style.getPropertyValue("--dur-panel")) || 500;
        const easing = style.getPropertyValue("--ease-out").trim() || "ease-out";
        root.setAttribute("data-theme-switch", "");
        const transition = document.startViewTransition(apply);
        // A second press mid-wipe aborts the first transition; that is fine,
        // the theme is already applied, so the rejections are just swallowed.
        transition.ready
          .then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${reach}px at ${x}px ${y}px)`] },
              { duration, easing, pseudoElement: "::view-transition-new(root)" },
            );
          })
          .catch(() => {});
        transition.finished
          .finally(() => root.removeAttribute("data-theme-switch"))
          .catch(() => {});
      } else apply();
      write("dps-theme", next);
      if (status) status.textContent = `Motyw: ${themeName(next)}`;
      return;
    }
    sync();
  });
  sync();

  const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
  const open = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  if (menu && open) {
    open.addEventListener("click", () => {
      menu.showModal();
      open.setAttribute("aria-expanded", "true");
    });
    menu.querySelector("[data-menu-close]")?.addEventListener("click", () => menu.close());
    // A press on the backdrop (the dialog box itself, outside the panel) closes.
    menu.addEventListener("click", (e) => {
      if (e.target === menu) menu.close();
    });
    menu.addEventListener("close", () => {
      open.setAttribute("aria-expanded", "false");
      open.focus({ preventScroll: true });
    });
    addEventListener("pagehide", () => {
      if (menu.open) menu.close();
    });
  }
</script>
