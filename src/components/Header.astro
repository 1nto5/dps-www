---
/**
 * Pinned to the top of the page. From `md` up: a thin bar with the telephone
 * and the reader's tools — text size, contrast and dark mode — and the main
 * row with the name of the Dom and the six sections in a flat row. Once the
 * page scrolls, both fold in one motion: the bar closes and the row shrinks.
 * Below `md` only the row shows; the telephone, the tools and the sections live
 * behind a hamburger button, in a native <dialog> that slides in from the left
 * as a drawer under the header. A tap outside, a swipe to the left or Escape
 * closes it.
 */
import { mainNav, activeSection } from "../data/nav";
import { contact } from "../data/contact";
import ReaderTools from "./ReaderTools.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || "/"
  : Astro.url.pathname;
const section = activeSection(path);
const current = (href: string) => (href === section?.href ? "page" : undefined);
---

<header class="site-header" transition:animate="none">
  <div class="header-surface" data-surface>
  <div class="bar" data-bar>
    <div class="bar-inner border-b border-line bg-sand">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-2 sm:px-8"
    >
      <p>
        <span class="text-sm text-ink-soft">Telefon:</span>
        <a href={contact.phone.href} class="font-semibold">{contact.phone.label}</a>
      </p>

      <ReaderTools />
    </div>
    </div>
  </div>

  <div class="pinned-row-wrap border-b border-line" data-pinned>
    <div
      class="pinned-row mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-5 sm:px-8 max-md:flex-nowrap"
    >
      <a href="/" class="brand no-underline">
        <span class="brand-name block font-display leading-tight font-semibold text-ink"
          >Dom Pomocy Społecznej</span
        >
        <span class="brand-sub text-sm text-ink-soft"><span>im. Jana Pawła II w Szczytnie</span></span>
      </a>

      <div class="md:hidden">
        <button type="button" class="tool" data-menu-open aria-haspopup="dialog" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span class="sr-only">Menu</span>
        </button>
      </div>

      <nav aria-label="Menu główne" class="hidden md:block">
        <ul role="list" class="flex flex-wrap gap-x-6">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} class="nav-link" aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
  </div>

  <div class="menu-backdrop" data-menu-backdrop hidden></div>
  <dialog class="menu" data-menu aria-label="Menu" tabindex="-1">
    <div>
      <p class="py-3">
        <span class="text-sm text-ink-soft">Telefon:</span>
        <a href={contact.phone.href} class="font-semibold">{contact.phone.label}</a>
      </p>
      <ReaderTools />
      <nav aria-label="Menu główne" class="mt-4">
        <ul role="list">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </dialog>
</header>

<script>
  // The reader's tools. They do nothing without JavaScript, so the CSS hides
  // them unless `data-js` is on <html> — set by the inline script in Base
  // before first paint, so the bar never changes shape after it appears.
  const doc = document.documentElement;

  function remember(key: string, value: string | null) {
    try {
      if (value === null) localStorage.removeItem(key);
      else localStorage.setItem(key, value);
    } catch {
      // A browser with storage switched off still gets the setting for this page.
    }
  }

  // The header is rendered afresh with every page, so the buttons are bound
  // again after each swap. This module runs only once, though, so listeners
  // on window and document from the previous page are dropped first.
  let bound: AbortController | null = null;

  function bind() {
    bound?.abort();
    bound = new AbortController();
    const { signal } = bound;

    const fontButtons = [...document.querySelectorAll<HTMLButtonElement>("button[data-font]")];
    const contrastButtons = [...document.querySelectorAll<HTMLButtonElement>("button[data-contrast]")];

    function syncFont() {
      const size = doc.getAttribute("data-font-size") ?? "normal";
      for (const button of fontButtons) {
        button.setAttribute("aria-pressed", String(button.dataset.font === size));
      }
    }

    for (const button of fontButtons) {
      button.addEventListener("click", () => {
        const size = button.dataset.font!;
        if (size === "normal") doc.removeAttribute("data-font-size");
        else doc.setAttribute("data-font-size", size);
        remember("dps-font", size === "normal" ? null : size);
        syncFont();
      });
    }

    function syncContrast() {
      const on = doc.getAttribute("data-contrast") === "high";
      for (const button of contrastButtons) button.setAttribute("aria-pressed", String(on));
    }

    for (const button of contrastButtons) {
      button.addEventListener("click", () => {
        const on = doc.getAttribute("data-contrast") === "high";
        if (on) doc.removeAttribute("data-contrast");
        else doc.setAttribute("data-contrast", "high");
        remember("dps-contrast", on ? null : "high");
        syncContrast();
      });
    }

    // The theme button walks a circle: system → dark → light → system.
    const themeButtons = [...document.querySelectorAll<HTMLButtonElement>("button[data-theme-switch]")];
    const themes = ["system", "dark", "light"] as const;
    const themeNames = { system: "systemowy", dark: "ciemny", light: "jasny" };

    function syncTheme() {
      const theme = doc.getAttribute("data-theme") ?? "system";
      const next = themes[(themes.indexOf(theme as (typeof themes)[number]) + 1) % themes.length];
      for (const button of themeButtons) {
        button.dataset.themeSwitch = theme;
        button.querySelector("[data-theme-label]")!.textContent =
          `Motyw: ${themeNames[theme as keyof typeof themeNames]}. Przełącz na ${themeNames[next]}`;
      }
    }

    for (const button of themeButtons) {
      button.addEventListener("click", () => {
        const theme = doc.getAttribute("data-theme") ?? "system";
        const next = themes[(themes.indexOf(theme as (typeof themes)[number]) + 1) % themes.length];
        if (next === "system") doc.removeAttribute("data-theme");
        else doc.setAttribute("data-theme", next);
        remember("dps-theme", next === "system" ? null : next);
        syncTheme();
      });
    }

    syncFont();
    syncContrast();
    syncTheme();

    // The drawer below `md`. Opened with show(), not showModal(), so the
    // pinned row above it stays usable; the backdrop is our own element for
    // the same reason. It starts where the pinned row ends.
    const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
    const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]");
    const open = document.querySelector<HTMLButtonElement>("[data-menu-open]");
    const surface = document.querySelector<HTMLElement>("[data-surface]");
    if (!surface) return;
    const header = surface.closest("header")!;
    // The header keeps its full height in the flow (`--header-flow`) while the
    // surface inside it folds, so the page below never moves during the fold.
    // `--header-height` is the surface's current height: same-page links, the
    // side column and the drawer sit below it.
    const measure = () => {
      doc.style.setProperty("--header-height", `${surface.offsetHeight}px`);
      if (!header.hasAttribute("data-compact")) {
        doc.style.setProperty("--header-flow", `${surface.offsetHeight}px`);
      }
    };
    const observer = new ResizeObserver(measure);
    observer.observe(surface);
    signal.addEventListener("abort", () => observer.disconnect());
    // Read once now, before the fold below: a page opened at a hash or by the
    // back button is already scrolled, and the observer reports too late.
    measure();
    // The unfolded height changes with the window (the bar comes and goes at
    // `md`, lines wrap). Folded, the header is unfolded for one silent frame
    // to read it.
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      if (signal.aborted) return;
      resizeTimer = window.setTimeout(() => {
        if (!header.hasAttribute("data-compact")) return;
        header.setAttribute("data-still", "");
        header.removeAttribute("data-compact");
        doc.style.setProperty("--header-flow", `${surface.offsetHeight}px`);
        header.setAttribute("data-compact", "");
        void surface.offsetHeight;
        header.removeAttribute("data-still");
      }, 100);
    }, { signal });

    // A little way down the page the header folds, bar and row in one motion:
    // the bar closes, the row loses padding, the name shrinks, its second line
    // goes. Two thresholds, so a scroll that rests near one does not flicker.
    let ticking = false;
    const compact = () => {
      ticking = false;
      const on = header.hasAttribute("data-compact");
      const y = window.scrollY;
      if (!on && y > 48) header.setAttribute("data-compact", "");
      else if (on && y < 8) header.removeAttribute("data-compact");
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(compact);
        }
      },
      { passive: true, signal },
    );
    compact();

    if (menu && backdrop && open) {
      const close = () => menu.open && menu.close();
      // The page behind the drawer is inert while it is open, so the Tab key
      // stays inside; the pinned row above stays live.
      const behind = [...document.querySelectorAll<HTMLElement>("main, footer")];

      open.addEventListener("click", () => {
        const top = Math.max(0, surface.getBoundingClientRect().bottom);
        menu.style.setProperty("--drawer-top", `${top}px`);
        backdrop.style.setProperty("--drawer-top", `${top}px`);
        backdrop.hidden = false;
        menu.show();
        for (const el of behind) el.inert = true;
        doc.style.overflow = "hidden";
        open.setAttribute("aria-expanded", "true");
        menu.focus();
      });
      menu.addEventListener("close", () => {
        backdrop.hidden = true;
        for (const el of behind) el.inert = false;
        doc.style.overflow = "";
        open.setAttribute("aria-expanded", "false");
        // Not when the drawer closed because the window grew past `md` and
        // the button went with it.
        if (open.offsetParent !== null) open.focus();
      });

      backdrop.addEventListener("click", close);
      // Widened past `md` with the drawer open: the row of links takes over.
      window
        .matchMedia("(min-width: 48rem)")
        .addEventListener("change", (e) => e.matches && close(), { signal });
      document.addEventListener("keydown", (e) => e.key === "Escape" && close(), { signal });

      // A finger swipe to the left, on the drawer or on the shade beside it,
      // closes it. A mostly vertical move is a scroll, and a mouse drag is a
      // text selection; neither counts.
      let start: { x: number; y: number } | null = null;
      const onDown = (e: PointerEvent) => {
        start = e.pointerType === "touch" ? { x: e.clientX, y: e.clientY } : null;
      };
      const onUp = (e: PointerEvent) => {
        if (start) {
          const dx = start.x - e.clientX;
          const dy = Math.abs(start.y - e.clientY);
          if (dx > 40 && dx > dy) close();
        }
        start = null;
      };
      for (const el of [menu, backdrop]) {
        el.addEventListener("pointerdown", onDown);
        el.addEventListener("pointerup", onUp);
        el.addEventListener("pointercancel", () => (start = null));
      }
    }
  }

  document.addEventListener("astro:page-load", bind);
</script>
