---
/**
 * Pinned to the top of the page: one row with the name of the Dom, the six
 * sections in a flat row from `md` up, and to their right two buttons — the
 * theme switch and „Dostępność", which opens a modal <dialog> with the text
 * size and contrast (ReaderTools). In high contrast, which sets its own
 * colours, the theme switch is hidden. The row is compact from the start and keeps
 * one shape while the page scrolls. Below `md` the sections live
 * behind a hamburger button, in a modal <dialog> that slides in from the left
 * over the whole screen, header included; the two buttons sit beside the
 * hamburger, to the right of the name. Where the name has no room beside
 * them — the narrowest phones, or the larger text sizes — the three buttons
 * wrap to a line of their own under it rather than run off the screen. The
 * close button in the drawer's top corner, a tap
 * outside, a swipe to the left, Escape or the back gesture closes the drawer.
 */
import { mainNav, activeSection } from "../data/nav";
import { sitePath } from "../data/routes";
import { contact } from "../data/contact";
import ReaderTools from "./ReaderTools.astro";

const path = sitePath(Astro.url.pathname);
const section = activeSection(path);
const current = (href: string) => (href === section?.href ? "page" : undefined);
---

<header class="site-header" transition:animate="none">
  <div class="header-surface border-b border-line" data-surface>
    <div
      class="pinned-row page-wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-4"
    >
      <a href="/" class="brand no-underline">
        <span class="brand-name block font-display leading-tight font-semibold text-ink"
          >Dom Pomocy Społecznej</span
        >
        {/* Non-breaking spaces: the patron's name and „w Szczytnie" each stay
            whole, so a line never ends on „im." or on the one-letter „w". */}
        <span class="brand-sub text-sm text-ink-soft">im.&nbsp;Jana&nbsp;Pawła&nbsp;II w&nbsp;Szczytnie</span>
      </a>

      <div class="flex items-center gap-x-6 gap-y-2 md:flex-wrap">
        <nav aria-label="Menu główne" class="hidden md:block">
          <ul class="flex flex-wrap gap-x-6">
            {
              mainNav.map((item) => (
                <li>
                  <a href={item.href} class="nav-link" aria-current={current(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          <div class="flex items-center gap-2" data-tools>
            <button type="button" class="tool" data-theme-switch="light">
              <svg data-icon="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
              </svg>
              <svg data-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
              {/* A name from the start; the script below puts the current theme in it. */}
              <span class="sr-only" data-theme-label>Przełącz motyw jasny lub ciemny</span>
            </button>
            <button type="button" class="tool" data-settings-open aria-haspopup="dialog">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <circle cx="12" cy="7" r="1.25" fill="currentColor" stroke="none" />
                <path d="M6.5 9.5c3.5 1 7.5 1 11 0M12 11v3M12 14l-2.5 5M12 14l2.5 5" />
              </svg>
              <span class="sr-only">Dostępność</span>
            </button>
          </div>

          <button type="button" class="tool" data-menu-open aria-haspopup="dialog" aria-expanded="false" aria-controls="menu-drawer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span class="sr-only">Menu</span>
          </button>
          {/* Without JavaScript the button above cannot open the drawer, so the
              CSS swaps it for this link to the same pages in the footer. */}
          <a href="#footer-strony-serwisu" class="tool" data-menu-link>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span class="sr-only">Menu</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <dialog
    id="menu-drawer"
    class="menu"
    data-menu
    aria-labelledby="menu-title"
    closedby="any"
    tabindex="-1"
  >
    <div>
      {/* The close button comes first, so it takes focus; the title sits to
          its left on screen. */}
      <div class="flex flex-row-reverse items-center justify-between gap-4">
        <button type="button" class="tool" data-menu-close autofocus>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
          <span class="sr-only">Zamknij menu</span>
        </button>
        <h2 id="menu-title" class="text-xl">Menu</h2>
      </div>
      <p class="py-3">
        <span class="text-sm text-ink-soft">Telefon:</span>
        <a href={contact.phone.href} class="font-semibold">{contact.phone.label}</a>
      </p>
      <nav aria-label="Menu główne" class="mt-2">
        <ul>
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </dialog>

  <ReaderTools />
</header>

<script>
  import "../lib/light-dismiss";

  // The reader's tools. They do nothing without JavaScript, so the CSS hides
  // them unless `data-js` is on <html> — set by the inline script in Base
  // before first paint, so the row never changes shape after it appears.
  const doc = document.documentElement;

  function remember(key: string, value: string | null) {
    try {
      if (value === null) localStorage.removeItem(key);
      else localStorage.setItem(key, value);
    } catch {
      // A browser with storage switched off still gets the setting for this page.
    }
  }

  // The header is rendered afresh with every page, so the buttons are bound
  // again after each swap. This module runs only once, though, so listeners
  // on window and document from the previous page are dropped first.
  let bound: AbortController | null = null;

  function bind() {
    bound?.abort();
    bound = new AbortController();
    const { signal } = bound;

    // Text size and contrast are each one attribute on <html>, remembered
    // under one key. Setting the default value clears the attribute instead.
    const setting = (attr: string, key: string, off: string) => ({
      current: () => doc.getAttribute(attr) ?? off,
      set(value: string) {
        if (value === off) doc.removeAttribute(attr);
        else doc.setAttribute(attr, value);
        remember(key, value === off ? null : value);
      },
    });

    const font = setting("data-font-size", "dps-font", "normal");
    const fontButtons = [...document.querySelectorAll<HTMLButtonElement>("button[data-font]")];
    const syncFont = () => {
      for (const button of fontButtons) {
        button.setAttribute("aria-pressed", String(button.dataset.font === font.current()));
      }
    };
    for (const button of fontButtons) {
      button.addEventListener("click", () => (font.set(button.dataset.font!), syncFont()));
    }

    // One button, in the settings dialog: it turns high contrast on and off.
    const contrast = setting("data-contrast", "dps-contrast", "normal");
    const contrastButton = document.querySelector<HTMLButtonElement>("button[data-contrast]");
    const syncContrast = () => {
      contrastButton?.setAttribute("aria-pressed", String(contrast.current() === "high"));
    };
    contrastButton?.addEventListener("click", () => {
      contrast.set(contrast.current() === "high" ? "normal" : "high");
      syncContrast();
    });

    // The theme button flips between light and dark. Without a saved choice the
    // page follows the system, and the button shows the theme the reader sees.
    // Picking the theme the system already shows drops the saved choice, so
    // the page follows the system again from then on.
    const themeButtons = [...document.querySelectorAll<HTMLButtonElement>("button[data-theme-switch]")];
    const themeNames = { dark: "ciemny", light: "jasny" };
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
    const systemTheme = () => (systemDark.matches ? "dark" : "light");
    const currentTheme = () => (doc.getAttribute("data-theme") as "dark" | "light" | null) ?? systemTheme();

    function syncTheme() {
      const theme = currentTheme();
      const pinned = doc.hasAttribute("data-theme");
      const next = theme === "dark" ? "light" : "dark";
      for (const button of themeButtons) {
        button.dataset.themeSwitch = theme;
        button.querySelector("[data-theme-label]")!.textContent =
          `Motyw: ${themeNames[theme]}${pinned ? "" : " (systemowy)"}. Przełącz na ${themeNames[next]}`;
      }
    }

    for (const button of themeButtons) {
      button.addEventListener("click", () => {
        const next = currentTheme() === "dark" ? "light" : "dark";
        if (next === systemTheme()) doc.removeAttribute("data-theme");
        else doc.setAttribute("data-theme", next);
        remember("dps-theme", next === systemTheme() ? null : next);
        syncTheme();
      });
    }
    systemDark.addEventListener("change", syncTheme, { signal });

    // A setting changed in another tab of the site: this one follows. The
    // values are checked against the same closed sets as in the inline script
    // in Base; nothing is written back.
    const stored: Record<string, [attr: string, allowed: string[]]> = {
      "dps-font": ["data-font-size", ["large", "xlarge"]],
      "dps-contrast": ["data-contrast", ["high"]],
      "dps-theme": ["data-theme", ["dark", "light"]],
    };
    window.addEventListener(
      "storage",
      (event) => {
        if (event.storageArea !== localStorage) return;
        for (const [key, [attr, allowed]] of Object.entries(stored)) {
          // `key` is null when the whole storage was cleared.
          if (event.key !== null && event.key !== key) continue;
          const value = event.key === null ? null : event.newValue;
          if (value !== null && allowed.includes(value)) doc.setAttribute(attr, value);
          else doc.removeAttribute(attr);
        }
        syncFont();
        syncContrast();
        syncTheme();
      },
      { signal },
    );

    syncFont();
    syncContrast();
    syncTheme();

    // The settings dialog. Modal, so the page behind is inert on its own and
    // Escape closes it; `closedby="any"` adds a click on the shade.
    const settings = document.querySelector<HTMLDialogElement>("[data-settings]");
    const settingsOpen = document.querySelector<HTMLButtonElement>("[data-settings-open]");
    if (settings && settingsOpen) {
      settingsOpen.addEventListener("click", () => settings.showModal());
      settings
        .querySelector("[data-settings-close]")
        ?.addEventListener("click", () => settings.close());
    }

    // The drawer below `md`: a modal dialog over the whole screen, header
    // included. Modal, so the browser makes the page behind inert, keeps the
    // Tab key inside, closes it on Escape or the back gesture and puts focus
    // back on the Menu button; `closedby="any"` adds a tap on the shade.
    const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
    const open = document.querySelector<HTMLButtonElement>("[data-menu-open]");
    const surface = document.querySelector<HTMLElement>("[data-surface]");
    if (!surface) return;
    // `--header-height` is the surface's height: same-page links and the side
    // column sit below it. It changes with the window (the links move into
    // the drawer at `md`, lines wrap).
    const measure = () => doc.style.setProperty("--header-height", `${surface.offsetHeight}px`);
    const observer = new ResizeObserver(measure);
    observer.observe(surface);
    signal.addEventListener("abort", () => observer.disconnect());
    measure();

    if (!menu || !open) return;
    const close = () => menu.open && menu.close();

    open.addEventListener("click", () => {
      // The close button carries `autofocus`, so it takes focus.
      menu.showModal();
      open.setAttribute("aria-expanded", "true");
    });
    menu.addEventListener("close", () => open.setAttribute("aria-expanded", "false"));
    menu.querySelector("[data-menu-close]")?.addEventListener("click", close);
    // Widened past `md` with the drawer open: the row of links takes over.
    window
      .matchMedia("(min-width: 48rem)")
      .addEventListener("change", (e) => e.matches && close(), { signal });

    // A browser without `closedby` gets the tap on the shade from
    // light-dismiss.ts. A finger swipe to the left, on the drawer or on the
    // shade (whose pointer events land on the dialog itself), closes it. A
    // mostly vertical move is a scroll, and a mouse drag is a text selection;
    // neither counts.
    let start: { x: number; y: number } | null = null;
    menu.addEventListener("pointerdown", (e) => {
      start = e.pointerType === "touch" ? { x: e.clientX, y: e.clientY } : null;
    });
    menu.addEventListener("pointerup", (e) => {
      if (start) {
        const dx = start.x - e.clientX;
        const dy = Math.abs(start.y - e.clientY);
        if (dx > 40 && dx > dy) close();
      }
      start = null;
    });
    menu.addEventListener("pointercancel", () => (start = null));
  }

  document.addEventListener("astro:page-load", bind);
</script>
