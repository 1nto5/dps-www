---
const nav = [
  { href: "/o-nas/", label: "O nas" },
  { href: "/oferta/", label: "Oferta" },
  { href: "/filia-w-spychowie/", label: "Filia w Spychowie" },
  { href: "/aktualnosci/", label: "Aktualności" },
  { href: "/galeria/", label: "Galeria" },
  { href: "/dokumenty/", label: "Dokumenty" },
  { href: "/kontakt/", label: "Kontakt" },
];
// Strip the deploy base (github.io test phase) so active-page detection
// works the same as on the production domain.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || "/"
  : Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
// `aria-current="page"` is only true on the page itself. A section item that is
// merely an ancestor of the page being read — /dokumenty/ while the reader is
// on /dokumenty/rodo/ — is "current" in the weaker sense the spec spells
// `true`; claiming "page" there tells a screen-reader user they have arrived
// somewhere they have not.
const currentState = (href: string) => (path === href ? "page" : isActive(href) ? "true" : undefined);
---

<!--
  Sticky at every width: the document runs to several thousand pixels on the
  document pages, and without this the only way back to navigation is a full
  scroll to the top. `z-40` is required — revealed sections carry an opacity
  transition, which makes them stacking contexts that would otherwise paint
  over a header appearing earlier in the document.
-->
<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <!--
    `bg-paper` is repeated here, not only on <header>: the open menu's scrim is
    a fixed pseudo-element inside the header's stacking context, and a negative
    z-index puts it above the header's own background but below this in-flow
    wrapper's. Without an opaque background on the wrapper the scrim would tint
    the header bar itself. Below `lg` — the only widths where the menu exists —
    the wrapper spans the full header width, so nothing is left uncovered.
  -->
  <div
    class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 bg-paper px-4 py-3 sm:gap-6 sm:px-6 sm:py-4"
  >
    <a href="/" class="flex min-w-0 items-center gap-2.5 no-underline sm:gap-3">
      <svg viewBox="0 0 32 40" aria-hidden="true" class="h-7 w-auto shrink-0 sm:h-9">
        <path d="M2 40V16a14 14 0 0 1 28 0v24z" fill="var(--color-spruce)"></path>
        <path d="M11 40V23a5 5 0 0 1 10 0v17z" fill="var(--color-paper)"></path>
      </svg>
      <span class="min-w-0 leading-tight">
        <!--
          Plain rem sizes, one step at `sm`. A viewport-derived size ignores
          the reader's own text-size setting and stops growing on zoom, which
          is exactly what WCAG 2.1 SC 1.4.4 asks for. And no `truncate`: with
          increased letter-spacing (SC 1.4.12) the name grows past the bar, and
          it has to wrap onto a second line rather than have its end cut off.
          `--header-h` in global.css already reserves room for two lines below
          `sm`.
        -->
        <span class="block font-display text-[0.9rem] font-semibold text-balance sm:text-lg"
          >Dom Pomocy Społecznej</span
        >
        <!--
          Below `sm` the patron line is dropped from the layout but kept for
          assistive technology, so the link keeps the Dom's full name while the
          sticky header stays short enough to give up screen space for.
        -->
        <span class="sr-only text-base text-muted sm:not-sr-only sm:block"
          >im. Jana Pawła II w Szczytnie</span
        >
      </span>
    </a>

    <nav aria-label="Nawigacja główna" class="hidden lg:block">
      <ul role="list" class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentState(item.href)}
                class:list={[
                  // Tighter between lg and xl: at full size these seven items
                  // plus the wordmark overflow 1024px and wrap the header onto
                  // a second line.
                  "rounded px-2 py-2 text-meta font-medium hover:bg-moss-deep hover:text-spruce-deep xl:px-3 xl:text-base",
                  isActive(item.href)
                    ? "bg-moss-deep font-semibold text-spruce-deep shadow-[inset_0_-3px_0_var(--color-spruce)]"
                    : "text-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!--
      The scrim is the `::before`: a fixed, translucent layer painted while the
      menu is open, so the panel reads as a layer over the page. It sits at a
      negative stack level, which keeps it under the panel and under the
      header bar's own controls, and it swallows the press that dismisses the
      menu (the script below closes on any pointer-down outside the panel).
      The gutter that `scrollbar-gutter: stable` reserves stays outside it: no
      element can paint into that strip, and on a real window the scrollbar
      itself fills it.
    -->
    <details
      data-menu
      class="lg:hidden open:before:fixed open:before:inset-0 open:before:-z-10 open:before:bg-ink/40 open:before:content-['']"
    >
      <summary
        class="flex cursor-pointer list-none items-center gap-1.5 rounded border border-edge px-2.5 py-1.5 text-meta font-medium hover:border-spruce sm:gap-2 sm:px-3 sm:py-2 sm:text-base [&::-webkit-details-marker]:hidden [[open]>&]:bg-moss-deep [[open]>&]:text-spruce-deep"
      >
        Menu
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none">
          <path d="M2 4h10M2 7h10M2 10h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </summary>
      <!--
        Anchored to the header bar rather than to the button, so the panel drops
        below the header's bottom border instead of straddling it.
      -->
      <nav
        aria-label="Nawigacja główna"
        class="menu-panel absolute right-4 top-full z-40 w-56 rounded-b-lg border border-t-0 border-edge bg-paper p-2 shadow-lg sm:right-6"
      >
        <ul role="list">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentState(item.href)}
                  class:list={[
                    "block rounded px-3 py-2 font-medium hover:bg-moss-deep hover:text-spruce-deep",
                    isActive(item.href)
                      ? "bg-moss-deep font-semibold text-spruce-deep shadow-[inset_0_-3px_0_var(--color-spruce)]"
                      : "text-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<!--
  Progressive enhancement only: <details> already opens and closes without
  JavaScript, this adds the dismissals a native menu is expected to have.
-->
<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
  const summary = menu?.querySelector("summary");
  if (menu && summary) {
    const close = (restoreFocus: boolean) => {
      if (!menu.open) return;
      menu.open = false;
      if (restoreFocus) summary.focus();
    };
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close(true);
    });
    // A press on the scrim reports the <details> as its target (pseudo-elements
    // have no target of their own), so "outside" is measured against the panel
    // and the button rather than against the element.
    document.addEventListener("pointerdown", (e) => {
      const t = e.target as Element | null;
      if (!t?.closest?.(".menu-panel") && !t?.closest?.("summary")) close(false);
    });
    // Leaving the page: close first, so the menu is not part of the outgoing
    // view-transition snapshot and never returns open from the back/forward cache.
    menu.addEventListener("click", (e) => {
      if ((e.target as Element | null)?.closest?.("a")) close(false);
    });
    window.addEventListener("pagehide", () => close(false));
  }
</script>
