---
/**
 * Click-to-enlarge for photographs. Included by Gallery; Astro dedupes the
 * script, and the dialog is created lazily, so several galleries on one page
 * share one dialog. The dialog is appended to <body>.
 *
 * Markup contract: <a href="<full-size url>" data-lightbox data-caption="…">
 * around an <img>. Links in the same [data-lightbox-group] get prev/next.
 */
---

<script>
  const SEL = "a[data-lightbox]";
  let dialog: HTMLDialogElement | null = null;
  let group: HTMLAnchorElement[] = [];
  let index = 0;
  let opener: HTMLAnchorElement | null = null;

  function build() {
    dialog = document.createElement("dialog");
    dialog.className = "lightbox";
    dialog.setAttribute("aria-label", "Powiększone zdjęcie");
    dialog.innerHTML = `
      <div class="lightbox-frame">
        <div class="lightbox-bar">
          <p class="lightbox-counter"></p>
          <button type="button" class="btn btn-quiet lightbox-close">Zamknij</button>
        </div>
        <figure>
          <img alt="" />
        </figure>
        <div class="lightbox-bar">
          <p class="lightbox-figcaption" aria-live="polite" aria-atomic="true">
            <span class="lightbox-caption"></span>
            <span class="sr-only lightbox-alt"></span>
          </p>
          <div class="lightbox-nav">
            <button type="button" class="btn btn-quiet lightbox-prev">Poprzednie</button>
            <button type="button" class="btn btn-quiet lightbox-next">Następne</button>
          </div>
        </div>
      </div>`;
    document.body.append(dialog);
    dialog.querySelector(".lightbox-close")!.addEventListener("click", () => dialog!.close());
    dialog.querySelector(".lightbox-prev")!.addEventListener("click", () => show(index - 1));
    dialog.querySelector(".lightbox-next")!.addEventListener("click", () => show(index + 1));
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
    dialog.addEventListener("close", () => {
      document.documentElement.style.removeProperty("overflow");
      opener?.focus();
      opener = null;
    });
  }

  function show(i: number) {
    if (!dialog || !group.length) return;
    index = (i + group.length) % group.length;
    const link = group[index]!;
    const img = dialog.querySelector("img")!;
    img.src = link.href;
    const thumbAlt = link.querySelector("img")?.alt ?? "";
    const cap = link.dataset.caption ?? "";
    img.alt = thumbAlt || cap;
    dialog.querySelector(".lightbox-counter")!.textContent =
      group.length > 1 ? `Zdjęcie ${index + 1} z ${group.length}` : "";
    const caption = dialog.querySelector(".lightbox-caption")!;
    caption.textContent = cap;
    dialog.querySelector(".lightbox-alt")!.textContent = img.alt;
    if (cap && cap === img.alt) caption.setAttribute("aria-hidden", "true");
    else caption.removeAttribute("aria-hidden");
    const nav = group.length > 1;
    (dialog.querySelector(".lightbox-prev") as HTMLElement).hidden = !nav;
    (dialog.querySelector(".lightbox-next") as HTMLElement).hidden = !nav;
    if (nav) {
      for (const n of [index + 1, index - 1]) {
        new Image().src = group[(n + group.length) % group.length]!.href;
      }
    }
  }

  document.addEventListener("click", (e) => {
    const link = (e.target as Element).closest?.(SEL) as HTMLAnchorElement | null;
    if (!link) return;
    e.preventDefault();
    if (!dialog) build();
    opener = link;
    const scope = link.closest("[data-lightbox-group]");
    group = scope ? ([...scope.querySelectorAll(SEL)] as HTMLAnchorElement[]) : [link];
    document.documentElement.style.overflow = "hidden";
    show(group.indexOf(link));
    dialog!.showModal();
  });
</script>
