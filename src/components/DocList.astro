---
/**
 * Documents to download. The format and the size are part of the link text, so
 * a reader — and a screen reader announcing links out of context — knows what
 * opens before it opens.
 */
interface Props {
  docs: readonly { href: string; label: string; format: string; size?: string }[];
}

const { docs } = Astro.props;
---

<ul class="docs" role="list">
  {
    docs.map((doc) => (
      <li>
        <a href={doc.href}>
          <span>{doc.label}</span> <small>({doc.size ? `${doc.format}, ${doc.size}` : doc.format})</small>
        </a>
      </li>
    ))
  }
</ul>
