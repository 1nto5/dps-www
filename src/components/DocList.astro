---
/**
 * Documents to download. Each row states the format and the size, so a reader
 * knows what opens before it opens.
 */
interface Props {
  docs: readonly { href: string; label: string; format: string; size?: string }[];
}
const { docs } = Astro.props;
---

<ul class="docs" role="list">
  {
    docs.map((d) => (
      <li>
        <a href={d.href}>{d.label}</a>
        <span>{d.size ? `${d.format}, ${d.size}` : d.format}</span>
      </li>
    ))
  }
</ul>
