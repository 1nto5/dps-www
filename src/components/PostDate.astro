---
/** The date of a news post, written out the long Polish way. */
import { formatPostDate } from "../lib/posts";

interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<p class="text-sm text-ink-soft">
  <time datetime={date.toISOString().slice(0, 10)}>{formatPostDate(date)}</time>
</p>
