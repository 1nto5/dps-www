---
interface Props {
  date: Date;
}
const { date } = Astro.props;
const dateFormat = new Intl.DateTimeFormat("pl-PL", { day: "numeric", month: "long", year: "numeric" });
---

<p class="text-meta text-ink-soft">
  <time datetime={date.toISOString().slice(0, 10)}>{dateFormat.format(date)}</time>
</p>
