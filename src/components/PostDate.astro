---
/** The date of a news post, written out the long Polish way. */
interface Props {
  date: Date;
}

const { date } = Astro.props;
const format = new Intl.DateTimeFormat("pl-PL", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<p class="text-sm text-ink-soft">
  <time datetime={date.toISOString().slice(0, 10)}>{format.format(date)}</time>
</p>
