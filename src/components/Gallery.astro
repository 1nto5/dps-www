---
/**
 * A photo grid. Every photo opens enlarged in the shared Lightbox; without JS
 * the link opens the full-size image file.
 */
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Lightbox from "./Lightbox.astro";
interface Props {
  photos: { src: ImageMetadata; alt: string }[];
  sizes?: string;
}
const { photos, sizes = "(min-width: 64rem) 14rem, 50vw" } = Astro.props;
const items = await Promise.all(
  photos.map(async (p) => ({
    ...p,
    full: await getImage({ src: p.src, width: 1600, format: "webp" }),
  })),
);
---

<ul class="gallery" role="list" data-lightbox-group>
  {
    items.map((p) => (
      <li>
        <a href={p.full.src} data-lightbox data-caption={p.alt} class="block rounded-lg">
          <Image src={p.src} alt={p.alt} widths={[400, 700]} sizes={sizes} loading="lazy" />
        </a>
      </li>
    ))
  }
</ul>
<Lightbox />
