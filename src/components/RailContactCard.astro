---
/**
 * The small "how to reach us" card that sits in a page's rail, under the table
 * of contents. Three pages drew their own and had drifted apart on fill,
 * heading face and link colour.
 *
 * `font-body` and the neutral leading/tracking on the heading are needed
 * because the global `h2` rule switches to Fraunces and tightens the line box:
 * this is structurally a heading, but it is a small label, not a title.
 *
 * The slot takes a closing note — "sprawy formalne prowadzi…", "kontakt
 * i adres" — so the card carries the same links in the same shape everywhere.
 */
import type { Phone } from "../data/contact";

interface Props {
  title: string;
  /** Id for the heading, so the <aside> can name itself with it. */
  headingId: string;
  /** One line per row of the <address>. */
  address?: string[];
  phone: Phone;
  email?: string;
}
const { title, headingId, address, phone, email } = Astro.props;

// `inline-block py-1`: at this text size a bare inline box is 22px tall, under
// the 24px minimum target of WCAG 2.2 SC 2.5.8, and these are the card's
// primary actions.
const linkClass = "inline-block py-1 text-spruce underline hover:text-spruce-deep";
---

<aside class="rounded-xl border border-line bg-moss/60 p-5" aria-labelledby={headingId}>
  <h2 id={headingId} class="font-body text-lg font-semibold leading-normal tracking-normal">
    {title}
  </h2>
  {
    address && address.length > 0 && (
      <address class="mt-3 not-italic">
        {address.map((line, i) => (
          <Fragment>
            {i > 0 && <br />}
            {line}
          </Fragment>
        ))}
      </address>
    )
  }
  <p class="mt-3">
    <a href={phone.href} class={linkClass}>Telefon: {phone.label}</a>
  </p>
  {
    email && (
      <p>
        <a href={`mailto:${email}`} class:list={[linkClass, "break-words"]}>
          {email}
        </a>
      </p>
    )
  }
  <slot />
</aside>
