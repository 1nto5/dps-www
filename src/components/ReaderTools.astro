---
/**
 * The reader's settings — text size and contrast — in a modal <dialog> the
 * „Dostępność" button in the header opens. Escape, the „Zamknij" button and a
 * click on the backdrop close it; the script in Header binds all three.
 */
---
<dialog class="settings" data-settings aria-labelledby="settings-title">
  <div class="settings-body">
    <h2 id="settings-title" class="settings-title">Dostępność</h2>
    <div class="settings-group">
      <p id="settings-font" class="settings-label">Wielkość tekstu</p>
      <div class="flex flex-wrap items-center gap-1" role="group" aria-labelledby="settings-font">
        <button type="button" class="tool" data-font="normal" aria-pressed="true">
          <span>A</span><span class="sr-only"> — tekst standardowy</span>
        </button>
        <button type="button" class="tool" data-font="large" aria-pressed="false">
          <span>A+</span><span class="sr-only"> — tekst większy</span>
        </button>
        <button type="button" class="tool" data-font="xlarge" aria-pressed="false">
          <span>A++</span><span class="sr-only"> — tekst największy</span>
        </button>
      </div>
    </div>
    <div class="settings-group">
      <p id="settings-contrast" class="settings-label">Kontrast</p>
      <button type="button" class="tool" data-contrast aria-pressed="false" aria-describedby="settings-contrast">
        Wysoki kontrast
      </button>
    </div>
    <div class="settings-bar">
      <button type="button" class="tool" data-settings-close>Zamknij</button>
    </div>
  </div>
</dialog>
