---
/**
 * The only layout. Every page renders through it: the skip link, the header,
 * one <main id="tresc"> and the footer.
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { contact } from "../data/contact";
import { ClientRouter } from "astro:transitions";


/**
 * Between pages the header and the footer stay put; the content of the old
 * page fades out and the new one comes up under them. The keyframes live in
 * global.css, next to the other motion.
 */
const content = {
  old: { name: "fade-out", duration: "140ms", easing: "ease-in", fillMode: "both" },
  new: { name: "fade-up", duration: "280ms", delay: "60ms", easing: "ease-out", fillMode: "both" },
};
const swapContent = { forwards: content, backwards: content };


interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  Astro.url.pathname === `${base}/`
    ? "Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie"
    : `${title} — DPS Szczytno`;
const desc =
  description ??
  "Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — dom dla osób przewlekle psychicznie chorych, z filią w Spychowie.";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {import.meta.env.BASE_URL !== "/" && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <ClientRouter />
    <!--
      Before first paint: the reader's own text size, contrast and dark mode, chosen in the
      header and kept in localStorage. Both are checked against a closed set, so
      a tampered entry cannot reach the document.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.setAttribute("data-js", "");
        try {
          var c = localStorage.getItem("dps-contrast");
          var f = localStorage.getItem("dps-font");
          var t = localStorage.getItem("dps-theme");
          if (c === "high") d.setAttribute("data-contrast", c);
          if (t === "dark" || t === "light") d.setAttribute("data-theme", t);
          if (f === "large" || f === "xlarge") d.setAttribute("data-font-size", f);
        } catch (e) {}
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "GovernmentOrganization",
        name: contact.name,
        url: "https://dpsszczytno.pl/",
        telephone: `+48 ${contact.phone.label}`,
        email: contact.email,
        address: {
          "@type": "PostalAddress",
          streetAddress: contact.address.street,
          postalCode: contact.address.postalCode,
          addressLocality: contact.address.city,
          addressCountry: "PL",
        },
      })}
    />
  </head>
  <body class="flex min-h-svh flex-col">
    <a href="#tresc" class="skip-link">Przejdź do treści</a>
    <Header />
    <main id="tresc" tabindex="-1" class="flex-1" transition:animate={swapContent}>
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll reveal: a block marked `data-reveal` (or `data-reveal-group`,
      // whose children come in one after another) gets `is-visible` the first
      // time it enters the view. The CSS only hides those blocks when this can
      // run, and not at all for a reader who asked for reduced motion.
      // Runs again after every page swap, for the blocks of the new page.
      const seen =
        "IntersectionObserver" in window
          ? new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  entry.target.classList.add("is-visible");
                  seen?.unobserve(entry.target);
                }
              },
              { rootMargin: "0px 0px -8% 0px" },
            )
          : null;

      // The reader's settings live as attributes on <html>, put there by the
      // inline script above before first paint. The router replaces <html>'s
      // attributes with the new page's — which has none, its scripts never
      // having run — so they are carried over here.
      document.addEventListener("astro:before-swap", (event) => {
        const from = document.documentElement;
        const to = event.newDocument.documentElement;
        for (const name of ["data-js", "data-font-size", "data-contrast", "data-theme"]) {
          const value = from.getAttribute(name);
          if (value !== null) to.setAttribute(name, value);
        }
      });

      // „Na tej stronie": the entry for the part of the page the reader is
      // looking at is marked the way the current page is in „W tej sekcji" —
      // the last heading that has passed the upper third of the window.
      let spots: { link: HTMLAnchorElement; target: HTMLElement }[] = [];
      let ticking = false;

      function markSpot() {
        ticking = false;
        const line = window.innerHeight / 3;
        let current: HTMLAnchorElement | null = null;
        for (const spot of spots) {
          if (spot.target.getBoundingClientRect().top <= line) current = spot.link;
        }
        // Scrolled to the very end: the last entry, whatever the headings say.
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          current = spots.at(-1)?.link ?? current;
        }
        for (const spot of spots) {
          if (spot.link === current) spot.link.setAttribute("aria-current", "location");
          else spot.link.removeAttribute("aria-current");
        }
      }

      function onScroll() {
        if (ticking || spots.length === 0) return;
        ticking = true;
        requestAnimationFrame(markSpot);
      }
      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll);

      document.addEventListener("astro:page-load", () => {
        for (const block of document.querySelectorAll("[data-reveal], [data-reveal-group]")) {
          if (seen) seen.observe(block);
          else block.classList.add("is-visible");
        }

        spots = [];
        for (const link of document.querySelectorAll<HTMLAnchorElement>('.rail a[href^="#"]')) {
          const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
          if (target) spots.push({ link, target });
        }
        markSpot();
      });
    </script>
  </body>
</html>
