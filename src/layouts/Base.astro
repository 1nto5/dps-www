---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle =
  Astro.url.pathname === "/"
    ? "Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie"
    : `${title} — DPS Szczytno`;
const desc =
  description ??
  "Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie — dom dla osób przewlekle psychicznie chorych. Filia w Spychowie.";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {
      /* Test-phase deploys (non-root base) must never be indexed under
         the temporary github.io address. */
      import.meta.env.BASE_URL !== "/" && <meta name="robots" content="noindex" />
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "GovernmentOrganization",
        name: "Dom Pomocy Społecznej im. Jana Pawła II w Szczytnie",
        url: "https://dpsszczytno.pl/",
        telephone: "+48 89 624 22 88",
        email: "sekretariat@dpsszczytno.pl",
        address: {
          "@type": "PostalAddress",
          streetAddress: "ul. Wielbarska 2",
          postalCode: "12-100",
          addressLocality: "Szczytno",
          addressCountry: "PL",
        },
      })}
    />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#tresc"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-spruce focus:px-4 focus:py-2 focus:text-white"
      >Przejdź do treści</a
    >
    <Header />
    <!-- tabindex="-1" lets the skip link move keyboard focus, not just the fragment. -->
    <main id="tresc" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Scroll reveal: only below-fold, top-level sections get the hidden
      // state (added here, never in markup, so first paint and no-JS are
      // unaffected), then fade up once when they enter the viewport.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const belowFold = (el: Element) => el.getBoundingClientRect().top > innerHeight * 0.9;
        const hide = (el: HTMLElement) => {
          el.setAttribute("data-reveal", "");
          el.style.transitionProperty = "none";
          void el.offsetWidth;
          el.style.transitionProperty = "";
        };

        const sections = [...document.querySelectorAll("main section")].filter(
          (s) =>
            !s.parentElement?.closest("section") &&
            !s.hasAttribute("data-no-reveal") &&
            belowFold(s),
        );
        // Card/photo grids cascade item by item instead of as one block.
        const lists = [...document.querySelectorAll('main ul[role="list"]')].filter(belowFold);

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              io.unobserve(e.target);
              if (e.target.matches("ul")) {
                for (const li of e.target.children) {
                  li.classList.add("is-visible");
                  // The stagger delay must not slow down later hover
                  // transitions on the same element.
                  setTimeout(() => ((li as HTMLElement).style.transitionDelay = ""), 1100);
                }
              } else {
                e.target.classList.add("is-visible");
              }
            }
          },
          { rootMargin: "0px 0px -60px 0px" },
        );

        for (const s of sections) {
          hide(s as HTMLElement);
          io.observe(s);
        }
        for (const ul of lists) {
          [...ul.children].forEach((li, i) => {
            hide(li as HTMLElement);
            (li as HTMLElement).style.transitionDelay = `${Math.min(i * 70, 420)}ms`;
          });
          io.observe(ul);
        }
      }
    </script>
  </body>
</html>
